{
  "font_size": 0.4,
  "font_color": "#FFFFFF",
  "background_alpha": 0.5,
  "background_color": "#9C27B0",
  "Stroke": "none",
  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.04,
      "to": 2.52,
      "sid": 1,
      "location": 2,
      "content": "全美国3244个县级行政区里",
      "music": 0.0
    },
    {
      "from": 2.52,
      "to": 4.04,
      "sid": 2,
      "location": 2,
      "content": "黑人占比最高的是哪个",
      "music": 0.0
    },
    {
      "from": 4.04,
      "to": 6.36,
      "sid": 3,
      "location": 2,
      "content": "他不在芝加哥南区或者巴尔地摩",
      "music": 0.0
    },
    {
      "from": 6.36,
      "to": 9.04,
      "sid": 4,
      "location": 2,
      "content": "而是位于美国最穷的州密西西比的克莱本县",
      "music": 0.0
    },
    {
      "from": 9.04,
      "to": 11.34,
      "sid": 5,
      "location": 2,
      "content": "这个衰败的农村县一共只有876百人",
      "music": 0.0
    },
    {
      "from": 11.34,
      "to": 13.48,
      "sid": 6,
      "location": 2,
      "content": "其中87%的人口都是黑人",
      "music": 0.0
    },
    {
      "from": 13.48,
      "to": 14.58,
      "sid": 7,
      "location": 2,
      "content": "位列全美第一",
      "music": 0.0
    },
    {
      "from": 14.58,
      "to": 17.14,
      "sid": 8,
      "location": 2,
      "content": "同时这里也是美国家庭年收入倒数第一的县",
      "music": 0.0
    },
    {
      "from": 17.14,
      "to": 18.66,
      "sid": 9,
      "location": 2,
      "content": "一年只有2万8000美元",
      "music": 0.0
    },
    {
      "from": 18.66,
      "to": 20.9,
      "sid": 10,
      "location": 2,
      "content": "只有美国全国平均水平的1/3",
      "music": 0.0
    },
    {
      "from": 20.9,
      "to": 23.939,
      "sid": 11,
      "location": 2,
      "content": "但克拉本县这里有很多不为人知的历史古迹",
      "music": 0.0
    },
    {
      "from": 23.939,
      "to": 25.519,
      "sid": 12,
      "location": 2,
      "content": "以及一所男女比一比二",
      "music": 0.0
    },
    {
      "from": 25.519,
      "to": 27.49,
      "sid": 13,
      "location": 2,
      "content": "94%是黑人的大学",
      "music": 0.0
    },
    {
      "from": 27.49,
      "to": 28.29,
      "sid": 14,
      "location": 2,
      "content": "还有淳朴",
      "music": 0.0
    },
    {
      "from": 28.29,
      "to": 29.71,
      "sid": 15,
      "location": 2,
      "content": "黑人大爷开的农家乐",
      "music": 0.0
    },
    {
      "from": 29.71,
      "to": 31.49,
      "sid": 16,
      "location": 2,
      "content": "王先生来到了克拉本县的县城",
      "music": 0.0
    },
    {
      "from": 31.49,
      "to": 32.93,
      "sid": 17,
      "location": 2,
      "content": "1269人的小城",
      "music": 0.0
    },
    {
      "from": 32.93,
      "to": 33.64,
      "sid": 18,
      "location": 2,
      "content": "吉布森港",
      "music": 0.0
    },
    {
      "from": 33.64,
      "to": 34.64,
      "sid": 19,
      "location": 2,
      "content": "在小城里转悠",
      "music": 0.0
    },
    {
      "from": 34.64,
      "to": 35.84,
      "sid": 20,
      "location": 2,
      "content": "到处都是历史建筑",
      "music": 0.0
    },
    {
      "from": 35.84,
      "to": 37.3,
      "sid": 21,
      "location": 2,
      "content": "虽然大多年久失修",
      "music": 0.0
    },
    {
      "from": 37.3,
      "to": 38.0,
      "sid": 22,
      "location": 2,
      "content": "吉布森港",
      "music": 0.0
    },
    {
      "from": 38.0,
      "to": 40.74,
      "sid": 23,
      "location": 2,
      "content": "1729年最早是由法国人建立的小城",
      "music": 0.0
    },
    {
      "from": 40.74,
      "to": 42.58,
      "sid": 24,
      "location": 2,
      "content": "最繁荣的年代是南北战争之前的",
      "music": 0.0
    },
    {
      "from": 42.58,
      "to": 43.68,
      "sid": 25,
      "location": 2,
      "content": "19世纪中叶",
      "music": 0.0
    },
    {
      "from": 43.68,
      "to": 44.26,
      "sid": 26,
      "location": 2,
      "content": "那个时候",
      "music": 0.0
    },
    {
      "from": 44.26,
      "to": 47.08,
      "sid": 27,
      "location": 2,
      "content": "克拉本县曾经是美国最重要的棉花产地之一",
      "music": 0.0
    },
    {
      "from": 47.08,
      "to": 48.88,
      "sid": 28,
      "location": 2,
      "content": "如今这个县大部分的黑人人口",
      "music": 0.0
    },
    {
      "from": 48.88,
      "to": 51.2,
      "sid": 29,
      "location": 2,
      "content": "都是当年被奴隶主强行带来种棉花的",
      "music": 0.0
    },
    {
      "from": 51.2,
      "to": 51.98,
      "sid": 30,
      "location": 2,
      "content": "黑奴的后代",
      "music": 0.0
    },
    {
      "from": 51.98,
      "to": 53.52,
      "sid": 31,
      "location": 2,
      "content": "南北战争解放了黑奴之后",
      "music": 0.0
    },
    {
      "from": 53.52,
      "to": 55.72,
      "sid": 32,
      "location": 2,
      "content": "本地的种植园经济受到了不少打击",
      "music": 0.0
    },
    {
      "from": 55.72,
      "to": 57.28,
      "sid": 33,
      "location": 2,
      "content": "但是真的让这里走向衰落了",
      "music": 0.0
    },
    {
      "from": 57.28,
      "to": 59.34,
      "sid": 34,
      "location": 2,
      "content": "还是不再需要人力的机械化农业",
      "music": 0.0
    },
    {
      "from": 59.34,
      "to": 60.04,
      "sid": 35,
      "location": 2,
      "content": "最近50年",
      "music": 0.0
    },
    {
      "from": 60.04,
      "to": 61.34,
      "sid": 36,
      "location": 2,
      "content": "这里的人口直接减半",
      "music": 0.0
    },
    {
      "from": 61.34,
      "to": 63.46,
      "sid": 37,
      "location": 2,
      "content": "不少本地人都跑出去找工作了",
      "music": 0.0
    },
    {
      "from": 63.46,
      "to": 65.3,
      "sid": 38,
      "location": 2,
      "content": "这小镇内部也是空空荡荡",
      "music": 0.0
    },
    {
      "from": 65.3,
      "to": 66.54,
      "sid": 39,
      "location": 2,
      "content": "但穿行在林荫道上",
      "music": 0.0
    },
    {
      "from": 66.54,
      "to": 68.68,
      "sid": 40,
      "location": 2,
      "content": "却依旧可以找到当年繁华的痕迹",
      "music": 0.0
    },
    {
      "from": 68.68,
      "to": 70.36,
      "sid": 41,
      "location": 2,
      "content": "这一路都有不少历史纪念碑",
      "music": 0.0
    },
    {
      "from": 70.36,
      "to": 72.08,
      "sid": 42,
      "location": 2,
      "content": "这个是1859年的老教堂",
      "music": 0.0
    },
    {
      "from": 72.08,
      "to": 73.62,
      "sid": 43,
      "location": 2,
      "content": "如今仍在使用中",
      "music": 0.0
    },
    {
      "from": 73.62,
      "to": 75.6,
      "sid": 44,
      "location": 2,
      "content": "这也应该是小镇上最高的建筑",
      "music": 0.0
    },
    {
      "from": 75.6,
      "to": 77.5,
      "sid": 45,
      "location": 2,
      "content": "无论在哪个角落都能看到它",
      "music": 0.0
    },
    {
      "from": 77.5,
      "to": 80.32,
      "sid": 46,
      "location": 2,
      "content": "这路边还有一个吉布森港小镇的历史纪念牌",
      "music": 0.0
    },
    {
      "from": 80.32,
      "to": 81.32,
      "sid": 47,
      "location": 2,
      "content": "太久没有维护",
      "music": 0.0
    },
    {
      "from": 81.32,
      "to": 82.93,
      "sid": 48,
      "location": 2,
      "content": "破了个脚都没有人在意",
      "music": 0.0
    },
    {
      "from": 82.93,
      "to": 83.85,
      "sid": 49,
      "location": 2,
      "content": "在老教堂对面",
      "music": 0.0
    },
    {
      "from": 83.85,
      "to": 86.37,
      "sid": 50,
      "location": 2,
      "content": "还有一个全密西西比州最老的犹太人会馆",
      "music": 0.0
    },
    {
      "from": 86.37,
      "to": 87.49,
      "sid": 51,
      "location": 2,
      "content": "这边最繁荣的时候",
      "music": 0.0
    },
    {
      "from": 87.49,
      "to": 90.169,
      "sid": 52,
      "location": 2,
      "content": "大概有五六十个犹太家庭在这边做生意",
      "music": 0.0
    },
    {
      "from": 90.169,
      "to": 91.489,
      "sid": 53,
      "location": 2,
      "content": "这边经济不行了之后",
      "music": 0.0
    },
    {
      "from": 91.489,
      "to": 93.189,
      "sid": 54,
      "location": 2,
      "content": "大部分人都在20世纪搬走了",
      "music": 0.0
    },
    {
      "from": 93.189,
      "to": 95.36,
      "sid": 55,
      "location": 2,
      "content": "犹太会馆也在1986年关门",
      "music": 0.0
    },
    {
      "from": 95.36,
      "to": 95.8,
      "sid": 56,
      "location": 2,
      "content": "巧的是",
      "music": 0.0
    },
    {
      "from": 95.8,
      "to": 96.96,
      "sid": 57,
      "location": 2,
      "content": "这个废弃的犹太会馆",
      "music": 0.0
    },
    {
      "from": 96.96,
      "to": 98.74,
      "sid": 58,
      "location": 2,
      "content": "旁边是个叙利亚人开的加油站",
      "music": 0.0
    },
    {
      "from": 98.74,
      "to": 100.3,
      "sid": 59,
      "location": 2,
      "content": "这边还卖一点小商品",
      "music": 0.0
    },
    {
      "from": 100.3,
      "to": 101.64,
      "sid": 60,
      "location": 2,
      "content": "帽子上面既有科比",
      "music": 0.0
    },
    {
      "from": 101.64,
      "to": 102.52,
      "sid": 61,
      "location": 2,
      "content": "又有墨西哥",
      "music": 0.0
    },
    {
      "from": 102.52,
      "to": 105.2,
      "sid": 62,
      "location": 2,
      "content": "在原先的犹太会馆后面就是小镇的犹太人区",
      "music": 0.0
    },
    {
      "from": 105.2,
      "to": 107.62,
      "sid": 63,
      "location": 2,
      "content": "像是原先银行杂货店什么的都在这里",
      "music": 0.0
    },
    {
      "from": 107.62,
      "to": 110.16,
      "sid": 64,
      "location": 2,
      "content": "这里还有当年犹太富商建的大庄园",
      "music": 0.0
    },
    {
      "from": 110.16,
      "to": 111.88,
      "sid": 65,
      "location": 2,
      "content": "不过如今这些都废弃了",
      "music": 0.0
    },
    {
      "from": 111.88,
      "to": 114.4,
      "sid": 66,
      "location": 2,
      "content": "这个大宅前两年还做过一段时间的民宿",
      "music": 0.0
    },
    {
      "from": 114.4,
      "to": 116.68,
      "sid": 67,
      "location": 2,
      "content": "后来因为实在没有游客也歇业了",
      "music": 0.0
    },
    {
      "from": 116.68,
      "to": 118.6,
      "sid": 68,
      "location": 2,
      "content": "看着门前的树林都长了几尺高",
      "music": 0.0
    },
    {
      "from": 118.6,
      "to": 119.52,
      "sid": 69,
      "location": 2,
      "content": "没人修剪",
      "music": 0.0
    },
    {
      "from": 119.52,
      "to": 121.18,
      "sid": 70,
      "location": 2,
      "content": "如今想在吉布森港住宿",
      "music": 0.0
    },
    {
      "from": 121.18,
      "to": 121.8,
      "sid": 71,
      "location": 2,
      "content": "唯一的选择",
      "music": 0.0
    },
    {
      "from": 121.8,
      "to": 124.42,
      "sid": 72,
      "location": 2,
      "content": "就是一个黑人奶奶在公路边开的汽车旅馆",
      "music": 0.0
    },
    {
      "from": 124.42,
      "to": 125.88,
      "sid": 73,
      "location": 2,
      "content": "虽然老板人事挺好的",
      "music": 0.0
    },
    {
      "from": 125.88,
      "to": 128.86,
      "sid": 74,
      "location": 2,
      "content": "但这个酒店可能真是我住过住宿条件最差的",
      "music": 0.0
    },
    {
      "from": 128.86,
      "to": 131.2,
      "sid": 75,
      "location": 2,
      "content": "就连我这种挂壁之王都有一点受不了",
      "music": 0.0
    },
    {
      "from": 131.2,
      "to": 132.6,
      "sid": 76,
      "location": 2,
      "content": "但是就如网友所说",
      "music": 0.0
    },
    {
      "from": 132.6,
      "to": 135.14,
      "sid": 77,
      "location": 2,
      "content": "方圆一小时车程内也没有别的店可以选了",
      "music": 0.0
    },
    {
      "from": 135.14,
      "to": 136.28,
      "sid": 78,
      "location": 2,
      "content": "到处都是虫子",
      "music": 0.0
    },
    {
      "from": 136.28,
      "to": 139.26,
      "sid": 79,
      "location": 2,
      "content": "房间里到处都是德国蟑螂和两只大蜘蛛",
      "music": 0.0
    },
    {
      "from": 139.26,
      "to": 140.4,
      "sid": 80,
      "location": 2,
      "content": "一只在水槽上",
      "music": 0.0
    },
    {
      "from": 140.4,
      "to": 141.58,
      "sid": 81,
      "location": 2,
      "content": "一只在淋浴间",
      "music": 0.0
    },
    {
      "from": 141.58,
      "to": 143.1,
      "sid": 82,
      "location": 2,
      "content": "这个酒店遍地是槽点",
      "music": 0.0
    },
    {
      "from": 143.1,
      "to": 143.9,
      "sid": 83,
      "location": 2,
      "content": "首先是毛巾",
      "music": 0.0
    },
    {
      "from": 143.9,
      "to": 144.92,
      "sid": 84,
      "location": 2,
      "content": "你得去前台要",
      "music": 0.0
    },
    {
      "from": 144.92,
      "to": 145.62,
      "sid": 85,
      "location": 2,
      "content": "我刚到的时候",
      "music": 0.0
    },
    {
      "from": 145.62,
      "to": 147.86,
      "sid": 86,
      "location": 2,
      "content": "就看到另外两个住店的人也去要毛巾",
      "music": 0.0
    },
    {
      "from": 147.86,
      "to": 149.66,
      "sid": 87,
      "location": 2,
      "content": "后来我也在这个夜黑风高之夜",
      "music": 0.0
    },
    {
      "from": 149.66,
      "to": 152.65,
      "sid": 88,
      "location": 2,
      "content": "跟着红衣服的老奶奶去野外的仓库里拿毛巾",
      "music": 0.0
    },
    {
      "from": 152.65,
      "to": 154.65,
      "sid": 89,
      "location": 2,
      "content": "这个仓库是连着一个信号塔的",
      "music": 0.0
    },
    {
      "from": 154.65,
      "to": 155.61,
      "sid": 90,
      "location": 2,
      "content": "配上这个月亮里面",
      "music": 0.0
    },
    {
      "from": 155.61,
      "to": 157.91,
      "sid": 91,
      "location": 2,
      "content": "有没有觉得有一点像连环杀手酒店",
      "music": 0.0
    },
    {
      "from": 157.91,
      "to": 160.25,
      "sid": 92,
      "location": 2,
      "content": "结果拿了毛巾之后发现洗澡水是冷的",
      "music": 0.0
    },
    {
      "from": 160.25,
      "to": 162.11,
      "sid": 93,
      "location": 2,
      "content": "我也不想再去打扰奶奶睡觉",
      "music": 0.0
    },
    {
      "from": 162.11,
      "to": 162.75,
      "sid": 94,
      "location": 2,
      "content": "就这样吧",
      "music": 0.0
    },
    {
      "from": 162.75,
      "to": 163.83,
      "sid": 95,
      "location": 2,
      "content": "也是冷的",
      "music": 0.0
    },
    {
      "from": 163.83,
      "to": 165.42,
      "sid": 96,
      "location": 2,
      "content": "吹的风是热的",
      "music": 0.0
    },
    {
      "from": 165.42,
      "to": 167.32,
      "sid": 97,
      "location": 2,
      "content": "我只拿这个搓澡",
      "music": 0.0
    },
    {
      "from": 167.32,
      "to": 169.42,
      "sid": 98,
      "location": 2,
      "content": "然后冰箱里面还有一盒碎牛肉",
      "music": 0.0
    },
    {
      "from": 169.42,
      "to": 171.04,
      "sid": 99,
      "location": 2,
      "content": "以及半杯没有喝完的饮料",
      "music": 0.0
    },
    {
      "from": 171.04,
      "to": 172.76,
      "sid": 100,
      "location": 2,
      "content": "在这里住一晚时50美元",
      "music": 0.0
    },
    {
      "from": 172.76,
      "to": 174.2,
      "sid": 101,
      "location": 2,
      "content": "觉得值得扣一不值得扣",
      "music": 0.0
    },
    {
      "from": 174.2,
      "to": 174.5,
      "sid": 102,
      "location": 2,
      "content": "二",
      "music": 0.0
    },
    {
      "from": 174.5,
      "to": 175.44,
      "sid": 103,
      "location": 2,
      "content": "虽然住的不好",
      "music": 0.0
    },
    {
      "from": 175.44,
      "to": 176.76,
      "sid": 104,
      "location": 2,
      "content": "但是店主人还挺好",
      "music": 0.0
    },
    {
      "from": 176.76,
      "to": 178.69,
      "sid": 105,
      "location": 2,
      "content": "第二天起来我跟他随便聊聊天",
      "music": 0.0
    },
    {
      "from": 178.69,
      "to": 179.49,
      "sid": 106,
      "location": 2,
      "content": "Well nine nine",
      "music": 0.0
    },
    {
      "from": 179.49,
      "to": 179.97,
