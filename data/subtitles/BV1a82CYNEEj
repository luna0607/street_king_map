  "body": [
    {
      "from": 0.0,
      "to": 2.36,
      "sid": 1,
      "location": 2,
      "content": "今天我来到了位于美国第三大印第安部落",
      "music": 0.0
    },
    {
      "from": 2.36,
      "to": 5.2,
      "sid": 2,
      "location": 2,
      "content": "乔克托人的保罗蒂上的5000人小镇雨果",
      "music": 0.0
    },
    {
      "from": 5.2,
      "to": 7.08,
      "sid": 3,
      "location": 2,
      "content": "这个小镇离德克萨斯的州界",
      "music": 0.0
    },
    {
      "from": 7.08,
      "to": 8.7,
      "sid": 4,
      "location": 2,
      "content": "只有15分钟的车程",
      "music": 0.0
    },
    {
      "from": 8.7,
      "to": 10.7,
      "sid": 5,
      "location": 2,
      "content": "也就是18km左右的距离",
      "music": 0.0
    },
    {
      "from": 10.7,
      "to": 13.98,
      "sid": 6,
      "location": 2,
      "content": "而小镇的雨果名字就是抄的法国作家雨果",
      "music": 0.0
    },
    {
      "from": 13.98,
      "to": 16.48,
      "sid": 7,
      "location": 2,
      "content": "雨果虽然在乔克托族的保留地上",
      "music": 0.0
    },
    {
      "from": 16.48,
      "to": 17.82,
      "sid": 8,
      "location": 2,
      "content": "这边只有14%",
      "music": 0.0
    },
    {
      "from": 17.82,
      "to": 18.77,
      "sid": 9,
      "location": 2,
      "content": "还是原住民",
      "music": 0.0
    },
    {
      "from": 18.77,
      "to": 20.49,
      "sid": 10,
      "location": 2,
      "content": "45%的人是白人",
      "music": 0.0
    },
    {
      "from": 20.49,
      "to": 21.89,
      "sid": 11,
      "location": 2,
      "content": "20%的是黑人",
      "music": 0.0
    },
    {
      "from": 21.89,
      "to": 23.43,
      "sid": 12,
      "location": 2,
      "content": "回到半个小时以前",
      "music": 0.0
    },
    {
      "from": 23.43,
      "to": 25.78,
      "sid": 13,
      "location": 2,
      "content": "我从德州的巴黎一路向北",
      "music": 0.0
    },
    {
      "from": 25.78,
      "to": 28.46,
      "sid": 14,
      "location": 2,
      "content": "在跨过德州和俄克拉荷马的乔克托",
      "music": 0.0
    },
    {
      "from": 28.46,
      "to": 30.84,
      "sid": 15,
      "location": 2,
      "content": "保留地的界河红河的那一刻",
      "music": 0.0
    },
    {
      "from": 30.84,
      "to": 32.72,
      "sid": 16,
      "location": 2,
      "content": "我就感觉光看这个路况",
      "music": 0.0
    },
    {
      "from": 32.72,
      "to": 35.1,
      "sid": 17,
      "location": 2,
      "content": "这个地方似乎要比德州穷上不少",
      "music": 0.0
    },
    {
      "from": 35.1,
      "to": 36.64,
      "sid": 18,
      "location": 2,
      "content": "这边的路超级颠簸",
      "music": 0.0
    },
    {
      "from": 36.64,
      "to": 38.08,
      "sid": 19,
      "location": 2,
      "content": "不少路段还在修路",
      "music": 0.0
    },
    {
      "from": 38.08,
      "to": 39.28,
      "sid": 20,
      "location": 2,
      "content": "在去雨果的路上",
      "music": 0.0
    },
    {
      "from": 39.28,
      "to": 41.76,
      "sid": 21,
      "location": 2,
      "content": "我还经过了一个印第安人保留地的特色",
      "music": 0.0
    },
    {
      "from": 41.76,
      "to": 43.38,
      "sid": 22,
      "location": 2,
      "content": "也就是部落开的赌场",
      "music": 0.0
    },
    {
      "from": 43.38,
      "to": 45.69,
      "sid": 23,
      "location": 2,
      "content": "德州对于赌博的限制非常严格",
      "music": 0.0
    },
    {
      "from": 45.69,
      "to": 48.09,
      "sid": 24,
      "location": 2,
      "content": "因此乔克托在和德州交界的地区",
      "music": 0.0
    },
    {
      "from": 48.09,
      "to": 49.35,
      "sid": 25,
      "location": 2,
      "content": "开了一大堆赌场",
      "music": 0.0
    },
    {
      "from": 49.35,
      "to": 51.57,
      "sid": 26,
      "location": 2,
      "content": "专门吸引德州人北上来赌博",
      "music": 0.0
    },
    {
      "from": 51.57,
      "to": 52.47,
      "sid": 27,
      "location": 2,
      "content": "除了赌场",
      "music": 0.0
    },
    {
      "from": 52.47,
      "to": 55.5,
      "sid": 28,
      "location": 2,
      "content": "乔科特部落还在保罗蒂上面有很多设施",
      "music": 0.0
    },
    {
      "from": 55.5,
      "to": 59.24,
      "sid": 29,
      "location": 2,
      "content": "在雨果城外面有一个乔科托部落综合服务中心",
      "music": 0.0
    },
    {
      "from": 59.24,
      "to": 60.28,
      "sid": 30,
      "location": 2,
      "content": "里面有医院",
      "music": 0.0
    },
    {
      "from": 60.28,
      "to": 61.08,
      "sid": 31,
      "location": 2,
      "content": "托儿所",
      "music": 0.0
    },
    {
      "from": 61.08,
      "to": 62.12,
      "sid": 32,
      "location": 2,
      "content": "社区中心",
      "music": 0.0
    },
    {
      "from": 62.12,
      "to": 64.22,
      "sid": 33,
      "location": 2,
      "content": "职业介绍所之类的设施",
      "music": 0.0
    },
    {
      "from": 64.22,
      "to": 66.33,
      "sid": 34,
      "location": 2,
      "content": "这类设施是全部免费的",
      "music": 0.0
    },
    {
      "from": 66.33,
      "to": 68.4,
      "sid": 35,
      "location": 2,
      "content": "但是你必须得是部落的成员",
      "music": 0.0
    },
    {
      "from": 68.4,
      "to": 69.96,
      "sid": 36,
      "location": 2,
      "content": "这些项目的资金来源",
      "music": 0.0
    },
    {
      "from": 69.96,
      "to": 71.92,
      "sid": 37,
      "location": 2,
      "content": "很大一部分就是赌场的收入",
      "music": 0.0
    },
    {
      "from": 71.92,
      "to": 72.68,
      "sid": 38,
      "location": 2,
      "content": "除此之外",
      "music": 0.0
    },
    {
      "from": 72.68,
      "to": 74.84,
      "sid": 39,
      "location": 2,
      "content": "联邦政府也会给很多拨款",
      "music": 0.0
    },
    {
      "from": 74.84,
      "to": 76.48,
      "sid": 40,
      "location": 2,
      "content": "在部落医院的门口",
      "music": 0.0
    },
    {
      "from": 76.48,
      "to": 79.16,
      "sid": 41,
      "location": 2,
      "content": "我遇到了一个在这边上班的乔克托人",
      "music": 0.0
    },
    {
      "from": 79.16,
      "to": 80.97,
      "sid": 42,
      "location": 2,
      "content": "于是我跟他随便聊一聊",
      "music": 0.0
    },
    {
      "from": 80.97,
      "to": 82.23,
      "sid": 43,
      "location": 2,
      "content": "Not only five percent",
      "music": 0.0
    },
    {
      "from": 82.23,
      "to": 82.89,
      "sid": 44,
      "location": 2,
      "content": "Five percent",
      "music": 0.0
    },
    {
      "from": 82.89,
      "to": 83.29,
      "sid": 45,
      "location": 2,
      "content": "Yeah",
      "music": 0.0
    },
    {
      "from": 83.29,
      "to": 84.45,
      "sid": 46,
      "location": 2,
      "content": "But yeah",
      "music": 0.0
    },
    {
      "from": 84.45,
      "to": 85.57,
      "sid": 47,
      "location": 2,
      "content": "I don't care it as long",
      "music": 0.0
    },
    {
      "from": 85.57,
      "to": 87.21,
      "sid": 48,
      "location": 2,
      "content": "As you've got a tiny",
      "music": 0.0
    },
    {
      "from": 87.21,
      "to": 88.99,
      "sid": 49,
      "location": 2,
      "content": "Little drop of native venue",
      "music": 0.0
    },
    {
      "from": 88.99,
      "to": 90.07,
      "sid": 50,
      "location": 2,
      "content": "They may recognize",
      "music": 0.0
    },
    {
      "from": 90.07,
      "to": 90.99,
      "sid": 51,
      "location": 2,
      "content": "You as a tribal member",
      "music": 0.0
    },
    {
      "from": 90.99,
      "to": 91.23,
      "sid": 52,
      "location": 2,
      "content": "Yeah",
      "music": 0.0
    },
    {
      "from": 91.23,
      "to": 93.91,
      "sid": 53,
      "location": 2,
      "content": "And you can get access to all the tribal surveys",
      "music": 0.0
    },
    {
      "from": 93.91,
      "to": 94.56,
      "sid": 54,
      "location": 2,
      "content": "Yeah",
      "music": 0.0
    },
    {
      "from": 94.56,
      "to": 97.08,
      "sid": 55,
      "location": 2,
      "content": "我问他附近有没有什么值得去的地方",
      "music": 0.0
    },
    {
      "from": 97.08,
      "to": 98.36,
      "sid": 56,
      "location": 2,
      "content": "他说这边除了赌场",
      "music": 0.0
    },
    {
      "from": 98.36,
      "to": 99.76,
      "sid": 57,
      "location": 2,
      "content": "什么好玩的地方都没有",
      "music": 0.0
    },
    {
      "from": 99.76,
      "to": 101.04,
      "sid": 58,
      "location": 2,
      "content": "All the casinos around here",
      "music": 0.29999997500000086
    },
    {
      "from": 101.04,
      "to": 103.92,
      "sid": 59,
      "location": 2,
      "content": "Are mostly owned by the chuckles chock bos",
      "music": 0.0
    },
    {
      "from": 103.92,
      "to": 104.3,
      "sid": 60,
      "location": 2,
      "content": "Yeah",
      "music": 0.0
    },
    {
      "from": 104.3,
      "to": 104.78,
      "sid": 61,
      "location": 2,
      "content": "Yeah",
      "music": 0.0
    },
    {
      "from": 104.78,
      "to": 106.24,
      "sid": 62,
      "location": 2,
      "content": "We're on sovereign governland",
      "music": 0.0
    },
    {
      "from": 106.24,
      "to": 106.62,
      "sid": 63,
      "location": 2,
      "content": "Okay",
      "music": 0.0
    },
    {
      "from": 106.62,
      "to": 107.42,
      "sid": 64,
      "location": 2,
      "content": "Sovereign nation",
      "music": 0.0
    },
    {
      "from": 107.42,
      "to": 108.4,
      "sid": 65,
      "location": 2,
      "content": "Whategan",
      "music": 0.0
    },
    {
      "from": 108.4,
      "to": 109.86,
      "sid": 66,
      "location": 2,
      "content": "But basically like the government",
      "music": 0.0
    },
    {
      "from": 109.86,
      "to": 111.98,
      "sid": 67,
      "location": 2,
      "content": "Makes a lot of money through casinos",
      "music": 0.0
    },
    {
      "from": 111.98,
      "to": 112.8,
      "sid": 68,
      "location": 2,
      "content": "Oh yeah",
      "music": 0.0
    },
    {
      "from": 112.8,
      "to": 115.59,
      "sid": 69,
      "location": 2,
      "content": "And then they go to your service",
      "music": 0.0
    },
    {
      "from": 115.59,
      "to": 116.21,
      "sid": 70,
      "location": 2,
      "content": "Yeah",
      "music": 0.0
    },
    {
      "from": 116.21,
      "to": 117.79,
      "sid": 71,
      "location": 2,
      "content": "We need that",
      "music": 0.2189780862059763
    },
    {
      "from": 117.79,
      "to": 118.59,
      "sid": 72,
      "location": 2,
      "content": "我个人感觉",
      "music": 0.0
    },
    {
      "from": 118.59,
      "to": 120.71,
      "sid": 73,
      "location": 2,
      "content": "美国原住民部落既是保留地上面",
      "music": 0.0
    },
    {
      "from": 120.71,
      "to": 121.93,
      "sid": 74,
      "location": 2,
      "content": "有执法权的政府",
      "music": 0.0
    },
    {
      "from": 121.93,
      "to": 124.4,
      "sid": 75,
      "location": 2,
      "content": "也像是一个开家族企业的公司",
      "music": 0.0
    },
    {
      "from": 124.4,
      "to": 125.4,
      "sid": 76,
      "location": 2,
      "content": "在赌场之外",
      "music": 0.0
    },
    {
      "from": 125.4,
      "to": 127.28,
      "sid": 77,
      "location": 2,
      "content": "他们还有加油站商店之类的",
      "music": 0.0
    },
    {
      "from": 127.28,
      "to": 129.979,
      "sid": 78,
      "location": 2,
      "content": "甚至一些保罗地上面的美国连锁快餐店",
      "music": 0.0
    },
    {
      "from": 129.979,
      "to": 132.739,
      "sid": 79,
      "location": 2,
      "content": "比如说附近的几家chilies也是部落经营的",
      "music": 0.0
    },
    {
      "from": 132.739,
      "to": 135.329,
      "sid": 80,
      "location": 2,
      "content": "之前大哥提到的社会福利确实有很多种",
      "music": 0.0
    },
    {
      "from": 135.329,
      "to": 137.809,
      "sid": 81,
      "location": 2,
      "content": "但是很多你离开了保罗蒂就用不了了",
      "music": 0.0
    },
    {
      "from": 137.809,
      "to": 140.729,
      "sid": 82,
      "location": 2,
      "content": "比如说乔克托的公立医院只在保留地里面有",
      "music": 0.0
    },
    {
      "from": 140.729,
      "to": 142.009,
      "sid": 83,
      "location": 2,
      "content": "但是留在保罗蒂上面",
      "music": 0.0
    },
    {
      "from": 142.009,
      "to": 143.79,
      "sid": 84,
      "location": 2,
      "content": "各方面的机会就要少很多",
      "music": 0.0
    },
    {
      "from": 143.79,
      "to": 145.29,
      "sid": 85,
      "location": 2,
      "content": "所以说有利有弊吧",
      "music": 0.0
    },
    {
      "from": 145.29,
      "to": 148.44,
      "sid": 86,
      "location": 2,
      "content": "现在我去吃一个雨果本地白人开的烤肉店",
      "music": 0.0
    },
    {
      "from": 148.44,
      "to": 150.12,
      "sid": 87,
      "location": 2,
      "content": "这边虽然在保罗蒂上面",
      "music": 0.0
    },
    {
      "from": 150.12,
      "to": 152.44,
      "sid": 88,
      "location": 2,
      "content": "但是一家原住民菜的餐馆都没有",
      "music": 0.0
    },
    {
      "from": 152.44,
      "to": 154.78,
      "sid": 89,
      "location": 2,
      "content": "要不是刚刚去了部落的服务中心",
      "music": 0.0
    },
    {
      "from": 154.78,
      "to": 157.26,
      "sid": 90,
      "location": 2,
      "content": "我感觉这边跟美国普通的农村小镇",
      "music": 0.0
    },
    {
      "from": 157.26,
      "to": 158.89,
      "sid": 91,
      "location": 2,
      "content": "似乎差别不是很大",
      "music": 0.0
    },
    {
      "from": 161.63,
      "to": 164.72,
      "sid": 92,
      "location": 2,
      "content": "这里跟你们想象中的印第安人保留地有区别吗",
      "music": 0.0
    },
    {
      "from": 164.72,
      "to": 167.16,
      "sid": 93,
      "location": 2,
      "content": "我猜想这边烤肉可能和德州风味比较像",
      "music": 0.0
    },
    {
      "from": 167.16,
      "to": 168.62,
      "sid": 94,
      "location": 2,
      "content": "于是我点了一个烤肋骨",
      "music": 0.0
    },
    {
      "from": 168.62,
      "to": 170.24,
      "sid": 95,
      "location": 2,
      "content": "毕竟这里跟德州交界",
      "music": 0.0
    },
    {
      "from": 170.24,
      "to": 170.76,
      "sid": 96,
      "location": 2,
      "content": "味道嘛",
      "music": 0.0
    },
    {
      "from": 170.76,
      "to": 171.68,
      "sid": 97,
      "location": 2,
      "content": "我记得还可以",
      "music": 0.0
    },
    {
      "from": 171.68,
      "to": 173.68,
      "sid": 98,
      "location": 2,
      "content": "毕竟这个三个月之前的视频了",
      "music": 0.0
    },
    {
      "from": 173.68,
      "to": 174.8,
      "sid": 99,
      "location": 2,
      "content": "就是我一个人光吃肉",
      "music": 0.0
    },
    {
      "from": 174.8,
      "to": 176.12,
      "sid": 100,
      "location": 2,
      "content": "没有菜的话有一点腻",
      "music": 0.0
    },
    {
      "from": 176.12,
      "to": 178.04,
      "sid": 101,
      "location": 2,
      "content": "不过最后还是给它肢解了",
      "music": 0.0
    },
    {
      "from": 178.04,
      "to": 179.44,
      "sid": 102,
      "location": 2,
      "content": "原价是15美元",
      "music": 0.0
    },
    {
      "from": 179.44,
      "to": 181.26,
      "sid": 103,
      "location": 2,
      "content": "加上税和小费是20美元",
      "music": 0.0
    },
    {
      "from": 181.26,
      "to": 182.32,
      "sid": 104,
      "location": 2,
      "content": "你们觉得贵吗",
      "music": 0.0
    },
    {
      "from": 182.32,
      "to": 183.3,
      "sid": 105,
      "location": 2,
      "content": "离开雨果",
      "music": 0.0
    },
    {
      "from": 183.3,
      "to": 184.2,
      "sid": 106,
      "location": 2,
      "content": "我一路北上",
      "music": 0.0
    },
    {
      "from": 184.2,
      "to": 187.18,
      "sid": 107,
      "location": 2,
      "content": "前往乔克托族曾经的首都塔斯卡HOMA",
      "music": 0.0
    },
    {
      "from": 187.18,
      "to": 188.6,
      "sid": 108,
      "location": 2,
      "content": "它的位置非常偏僻",
      "music": 0.0
    },
    {
      "from": 188.6,
      "to": 191.06,
      "sid": 109,
      "location": 2,
      "content": "在一座山里面一个多小时的车程",
      "music": 0.0
    },
    {
      "from": 191.06,
      "to": 193.7,
      "sid": 110,
