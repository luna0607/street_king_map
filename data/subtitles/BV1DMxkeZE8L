      "location": 2,
      "content": "更不要说周围的小型非赌场度假村了",
      "music": 0.0
    },
    {
      "from": 153.31,
      "to": 155.01,
      "sid": 76,
      "location": 2,
      "content": "不过瘦死的骆驼比马大",
      "music": 0.0
    },
    {
      "from": 155.01,
      "to": 156.97,
      "sid": 77,
      "location": 2,
      "content": "现在地尼卡度假区的赌博收益",
      "music": 0.0
    },
    {
      "from": 156.97,
      "to": 158.79,
      "sid": 78,
      "location": 2,
      "content": "依旧在全美排名第六",
      "music": 0.0
    },
    {
      "from": 158.79,
      "to": 162.21,
      "sid": 79,
      "location": 2,
      "content": "想要在赌场里面一夜暴富的概率实在是太低了",
      "music": 0.0
    },
    {
      "from": 162.21,
      "to": 164.01,
      "sid": 80,
      "location": 2,
      "content": "咱普通人还是不要学",
      "music": 0.0
    },
    {
      "from": 164.01,
      "to": 165.17,
      "sid": 81,
      "location": 2,
      "content": "想要充实钱包",
      "music": 0.0
    },
    {
      "from": 165.17,
      "to": 168.05,
      "sid": 82,
      "location": 2,
      "content": "最安全靠谱的方式还是老老实实规划花销",
      "music": 0.0
    },
    {
      "from": 168.05,
      "to": 169.7,
      "sid": 83,
      "location": 2,
      "content": "省钱就说网吧",
      "music": 0.0
    },
    {
      "from": 169.7,
      "to": 172.1,
      "sid": 84,
      "location": 2,
      "content": "由于博士生的收入实在是太低了",
      "music": 0.0
    },
    {
      "from": 172.1,
      "to": 173.76,
      "sid": 85,
      "location": 2,
      "content": "以前还没有规划意识",
      "music": 0.0
    },
    {
      "from": 173.76,
      "to": 175.26,
      "sid": 86,
      "location": 2,
      "content": "经常导致月光",
      "music": 0.0
    },
    {
      "from": 175.26,
      "to": 177.72,
      "sid": 87,
      "location": 2,
      "content": "但是我现在月初都会用喵喵记账",
      "music": 0.0
    },
    {
      "from": 177.72,
      "to": 179.2,
      "sid": 88,
      "location": 2,
