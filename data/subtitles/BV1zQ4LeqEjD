  "body": [
    {
      "from": 0.0,
      "to": 2.48,
      "sid": 1,
      "location": 2,
      "content": "我今天来到了美加边境线上的22人小镇",
      "music": 0.0
    },
    {
      "from": 2.48,
      "to": 3.12,
      "sid": 2,
      "location": 2,
      "content": "安特勒",
      "music": 0.0
    },
    {
      "from": 3.12,
      "to": 5.58,
      "sid": 3,
      "location": 2,
      "content": "这栋废弃的小楼是原先的海关大楼",
      "music": 0.0
    },
    {
      "from": 5.58,
      "to": 8.08,
      "sid": 4,
      "location": 2,
      "content": "从这里到正式的检查站只要4.9km",
      "music": 0.0
    },
    {
      "from": 8.08,
      "to": 10.06,
      "sid": 5,
      "location": 2,
      "content": "也就是15分钟自行车的功夫",
      "music": 0.0
    },
    {
      "from": 10.06,
      "to": 12.93,
      "sid": 6,
      "location": 2,
      "content": "这栋原先的海关大楼是安特勒小镇的核心",
      "music": 0.0
    },
    {
      "from": 12.93,
      "to": 14.65,
      "sid": 7,
      "location": 2,
      "content": "曾经还做过小镇的银行",
      "music": 0.0
    },
    {
      "from": 14.65,
      "to": 16.11,
      "sid": 8,
      "location": 2,
      "content": "警察局市政厅",
      "music": 0.0
    },
    {
      "from": 16.11,
      "to": 17.69,
      "sid": 9,
      "location": 2,
      "content": "但是随着安特勒的人口",
      "music": 0.0
    },
    {
      "from": 17.69,
      "to": 19.78,
      "sid": 10,
      "location": 2,
      "content": "从巅峰期的342人",
      "music": 0.0
    },
    {
      "from": 19.78,
      "to": 21.3,
      "sid": 11,
      "location": 2,
      "content": "减少到现在的21人",
      "music": 0.0
    },
    {
      "from": 21.3,
      "to": 23.6,
      "sid": 12,
      "location": 2,
      "content": "这个镇基本上处于半荒废状态",
      "music": 0.0
    },
    {
      "from": 23.6,
      "to": 26.36,
      "sid": 13,
      "location": 2,
      "content": "这一圈镇中心的商业应该也都是倒闭了",
      "music": 0.0
    },
    {
      "from": 26.36,
      "to": 28.08,
      "sid": 14,
      "location": 2,
      "content": "现在我在这个小镇里面转一转",
      "music": 0.0
    },
    {
      "from": 28.08,
      "to": 30.42,
      "sid": 15,
      "location": 2,
      "content": "照理说安特勒还算是一个口岸城市",
      "music": 0.0
    },
    {
      "from": 30.42,
      "to": 31.92,
      "sid": 16,
      "location": 2,
      "content": "为什么这边这么荒凉呢",
      "music": 0.0
    },
    {
      "from": 31.92,
      "to": 34.36,
      "sid": 17,
      "location": 2,
      "content": "因为无论是安特勒所在的北达科他州",
      "music": 0.0
    },
    {
      "from": 34.36,
      "to": 36.76,
      "sid": 18,
      "location": 2,
      "content": "和他对面加拿大所在的马尼托巴省",
      "music": 0.0
    },
    {
      "from": 36.76,
      "to": 38.3,
      "sid": 19,
      "location": 2,
      "content": "都是地广人稀的草原",
      "music": 0.0
    },
    {
      "from": 38.3,
      "to": 39.72,
      "sid": 20,
      "location": 2,
      "content": "也没有什么大城市",
      "music": 0.0
    },
    {
      "from": 39.72,
      "to": 42.129,
      "sid": 21,
      "location": 2,
      "content": "北达科他州比河南省稍微大一点点",
      "music": 0.0
    },
    {
      "from": 42.129,
      "to": 44.229,
      "sid": 22,
      "location": 2,
      "content": "但是这边的人口只有70多万",
      "music": 0.0
    },
    {
      "from": 44.229,
      "to": 47.04,
      "sid": 23,
      "location": 2,
      "content": "而且北达科他州北部又是整个州最荒的地方",
      "music": 0.0
    },
    {
      "from": 47.04,
      "to": 48.94,
      "sid": 24,
      "location": 2,
      "content": "所以说这边连经过的车都没有",
      "music": 0.0
    },
    {
      "from": 48.94,
      "to": 50.36,
      "sid": 25,
      "location": 2,
      "content": "这边究竟有多偏呢",
      "music": 0.0
    },
    {
      "from": 50.36,
      "to": 53.06,
      "sid": 26,
      "location": 2,
      "content": "从安特勒到最近的麦当劳要83km",
      "music": 0.0
    },
    {
      "from": 53.06,
      "to": 54.17,
      "sid": 27,
      "location": 2,
      "content": "52分钟",
      "music": 0.0
    },
    {
      "from": 54.17,
      "to": 57.21,
      "sid": 28,
      "location": 2,
      "content": "到最近的沃尔玛要92km一个小时",
      "music": 0.0
    },
    {
      "from": 57.21,
      "to": 58.65,
      "sid": 29,
      "location": 2,
      "content": "整个小镇还在营业的",
      "music": 0.0
    },
    {
      "from": 58.65,
      "to": 61.44,
      "sid": 30,
      "location": 2,
      "content": "似乎只有这家曾经提供汽油的汽修店",
      "music": 0.0
    },
    {
      "from": 61.44,
      "to": 63.46,
      "sid": 31,
      "location": 2,
      "content": "再往前就是一望无际的田野",
      "music": 0.0
    },
    {
      "from": 63.46,
      "to": 64.56,
      "sid": 32,
      "location": 2,
      "content": "现在我离开小镇",
      "music": 0.0
    },
    {
      "from": 64.56,
      "to": 66.44,
      "sid": 33,
      "location": 2,
      "content": "往美加边境口岸的方向开",
      "music": 0.0
    },
    {
      "from": 66.44,
      "to": 68.32,
      "sid": 34,
      "location": 2,
      "content": "我当时还看了好几次地图",
      "music": 0.0
    },
    {
      "from": 68.32,
      "to": 70.12,
      "sid": 35,
      "location": 2,
      "content": "来确定自己是不是开错了",
      "music": 0.0
    },
    {
      "from": 70.12,
      "to": 72.16,
      "sid": 36,
      "location": 2,
      "content": "因为这条路两边就是普通的农田",
      "music": 0.0
    },
    {
      "from": 72.16,
      "to": 74.7,
      "sid": 37,
      "location": 2,
      "content": "看不出任何会出现一个检查站的迹象",
      "music": 0.0
    },
    {
      "from": 74.7,
      "to": 76.4,
      "sid": 38,
      "location": 2,
      "content": "在路过这个农场的房子之后",
      "music": 0.0
    },
    {
      "from": 76.4,
      "to": 77.4,
      "sid": 39,
      "location": 2,
      "content": "转了一个小弯",
      "music": 0.0
    },
    {
      "from": 77.4,
      "to": 80.24,
      "sid": 40,
      "location": 2,
      "content": "一个白色的房子还真的出现在了草原上面",
      "music": 0.0
    },
    {
      "from": 80.24,
      "to": 82.86,
      "sid": 41,
      "location": 2,
      "content": "这个真是我去过最安静的边境口岸了",
      "music": 0.0
    },
    {
      "from": 82.86,
      "to": 84.68,
      "sid": 42,
      "location": 2,
      "content": "除了草原上的蜂和鸟叫",
      "music": 0.0
    },
    {
      "from": 84.68,
      "to": 85.78,
      "sid": 43,
      "location": 2,
      "content": "听不到别的声音",
      "music": 0.0
    },
    {
      "from": 85.78,
      "to": 87.76,
      "sid": 44,
      "location": 2,
      "content": "这个口岸还不是24个小时的",
      "music": 0.0
    },
    {
      "from": 87.76,
      "to": 90.44,
      "sid": 45,
      "location": 2,
      "content": "只有早上九点到下午五点有人上班",
      "music": 0.0
    },
    {
      "from": 90.44,
      "to": 92.68,
      "sid": 46,
      "location": 2,
      "content": "理论上半夜从这片草地跑两步",
      "music": 0.0
    },
    {
      "from": 92.68,
      "to": 94.18,
      "sid": 47,
      "location": 2,
      "content": "就可以到对面的加拿大了",
      "music": 0.0
    },
    {
      "from": 94.18,
      "to": 95.08,
      "sid": 48,
      "location": 2,
      "content": "我在这边拍拍",
      "music": 0.0
    },
    {
      "from": 95.08,
      "to": 95.6,
      "sid": 49,
      "location": 2,
      "content": "拍的时候",
      "music": 0.0
    },
    {
      "from": 95.6,
      "to": 98.18,
      "sid": 50,
      "location": 2,
      "content": "发现有一个大哥从这个牌房子里面走出来",
      "music": 0.0
    },
    {
      "from": 98.18,
      "to": 99.74,
      "sid": 51,
      "location": 2,
      "content": "嘴上叼着一个大雪茄",
      "music": 0.0
    },
    {
      "from": 99.74,
      "to": 101.82,
      "sid": 52,
      "location": 2,
      "content": "我一开始以为他是来找我麻烦的",
      "music": 0.0
    },
    {
      "from": 101.82,
      "to": 103.74,
      "sid": 53,
      "location": 2,
      "content": "于是我主动上去跟他打招呼",
      "music": 0.0
    },
    {
      "from": 103.74,
      "to": 104.58,
      "sid": 54,
      "location": 2,
      "content": "结果她跟我说",
      "music": 0.0
    },
    {
      "from": 104.58,
      "to": 105.33,
      "sid": 55,
      "location": 2,
      "content": "随便拍",
      "music": 0.0
    },
    {
      "from": 105.33,
      "to": 107.15,
      "sid": 56,
      "location": 2,
      "content": "只要不拍到他人就可以了",
      "music": 0.0
    },
    {
      "from": 107.15,
      "to": 109.57,
      "sid": 57,
      "location": 2,
      "content": "然后我们还进行了一些友好愉快的交流",
      "music": 0.0
    },
    {
      "from": 109.57,
      "to": 111.22,
      "sid": 58,
      "location": 2,
      "content": "他让我去加拿大看看",
      "music": 0.0
    },
    {
      "from": 111.22,
      "to": 112.3,
      "sid": 59,
      "location": 2,
      "content": "我说我没有签证",
      "music": 0.0
    },
    {
      "from": 112.3,
      "to": 112.92,
      "sid": 60,
      "location": 2,
      "content": "去不了",
      "music": 0.0
    },
    {
      "from": 112.92,
      "to": 114.42,
      "sid": 61,
      "location": 2,
      "content": "他说那可真是遗憾",
      "music": 0.0
    },
    {
      "from": 114.42,
      "to": 115.9,
      "sid": 62,
      "location": 2,
      "content": "一般人打交道比较多的",
      "music": 0.0
    },
    {
      "from": 115.9,
      "to": 117.41,
      "sid": 63,
      "location": 2,
      "content": "一般都是机场的边检",
      "music": 0.0
    },
    {
      "from": 117.41,
      "to": 119.15,
      "sid": 64,
      "location": 2,
      "content": "也都是住在城市里面的人",
      "music": 0.0
    },
    {
      "from": 119.15,
      "to": 121.27,
      "sid": 65,
      "location": 2,
      "content": "这个大哥一看就是本地的红脖子",
      "music": 0.0
    },
    {
      "from": 121.27,
      "to": 122.69,
      "sid": 66,
      "location": 2,
      "content": "那个气质完全不同",
      "music": 0.0
    },
    {
      "from": 122.69,
      "to": 123.41,
      "sid": 67,
      "location": 2,
      "content": "没法拍到",
      "music": 0.0
    },
    {
      "from": 123.41,
      "to": 124.73,
      "sid": 68,
      "location": 2,
      "content": "他真的有点可惜",
      "music": 0.0
    },
    {
      "from": 124.73,
      "to": 126.16,
      "sid": 69,
      "location": 2,
      "content": "现在我离开口岸",
      "music": 0.0
    },
    {
      "from": 126.16,
      "to": 129.78,
      "sid": 70,
      "location": 2,
      "content": "去这一块最大的小镇韦斯特霍普看一看",
      "music": 0.0
    },
    {
      "from": 129.78,
      "to": 131.78,
      "sid": 71,
      "location": 2,
      "content": "这边2020年人口普查显示",
      "music": 0.0
    },
    {
      "from": 131.78,
      "to": 133.22,
      "sid": 72,
      "location": 2,
      "content": "有374个人",
      "music": 0.0
    },
    {
      "from": 133.22,
      "to": 134.62,
      "sid": 73,
      "location": 2,
      "content": "虽然以国内标准",
      "music": 0.0
    },
    {
      "from": 134.62,
      "to": 136.8,
      "sid": 74,
      "location": 2,
      "content": "这还没有一栋楼里面的人多",
      "music": 0.0
    },
    {
      "from": 136.8,
      "to": 138.28,
      "sid": 75,
      "location": 2,
      "content": "但是比起安特勒",
      "music": 0.0
    },
    {
      "from": 138.28,
      "to": 140.19,
      "sid": 76,
      "location": 2,
      "content": "这里真的是一个大城市了",
      "music": 0.0
    },
    {
      "from": 140.19,
      "to": 142.93,
      "sid": 77,
      "location": 2,
      "content": "甚至在远处还能看到小镇的谷仓塔",
      "music": 0.0
    },
    {
      "from": 142.93,
      "to": 144.79,
      "sid": 78,
      "location": 2,
      "content": "以及公路旁边的加油站",
      "music": 0.0
    },
    {
      "from": 144.79,
      "to": 146.899,
      "sid": 79,
      "location": 2,
      "content": "而且明显车流也大了起来",
      "music": 0.0
    },
    {
      "from": 146.899,
      "to": 148.519,
      "sid": 80,
      "location": 2,
      "content": "这好也快没有油了",
      "music": 0.0
    },
    {
      "from": 148.519,
      "to": 151.539,
      "sid": 81,
      "location": 2,
      "content": "于是我来到了这个叫做农民联盟加油站的地方",
      "music": 0.0
    },
    {
      "from": 151.539,
      "to": 152.199,
      "sid": 82,
      "location": 2,
      "content": "加个油",
      "music": 0.0
    },
    {
      "from": 152.199,
      "to": 154.32,
      "sid": 83,
      "location": 2,
      "content": "位置就在谷仓塔的下面",
      "music": 0.0
    },
    {
      "from": 154.32,
      "to": 156.6,
      "sid": 84,
      "location": 2,
      "content": "这个加油站的便利店倒是挺大的",
      "music": 0.0
    },
    {
      "from": 156.6,
      "to": 158.66,
      "sid": 85,
      "location": 2,
      "content": "里面算是一个五金小商店",
      "music": 0.0
    },
    {
      "from": 158.66,
      "to": 161.4,
      "sid": 86,
      "location": 2,
      "content": "我买了一瓶大可乐和一小瓶机油",
      "music": 0.0
    },
    {
      "from": 161.4,
      "to": 163.5,
      "sid": 87,
      "location": 2,
      "content": "一共花了我7.14美元",
      "music": 0.0
    },
    {
      "from": 163.5,
      "to": 164.89,
      "sid": 88,
      "location": 2,
      "content": "你们觉得贵吗",
      "music": 0.0
    },
    {
      "from": 164.89,
      "to": 167.23,
      "sid": 89,
      "location": 2,
      "content": "结账的时候我和店员随便聊了一下",
      "music": 0.0
    },
    {
      "from": 167.23,
      "to": 168.93,
      "sid": 90,
      "location": 2,
      "content": "Do you get many kilers here",
      "music": 0.0
    },
    {
      "from": 168.93,
      "to": 169.82,
      "sid": 91,
      "location": 2,
      "content": "呃",
      "music": 0.0
    },
    {
      "from": 169.82,
      "to": 170.94,
      "sid": 92,
      "location": 2,
      "content": "During the summary",
      "music": 0.0
    },
    {
      "from": 170.94,
      "to": 171.14,
      "sid": 93,
      "location": 2,
      "content": "Yet",
      "music": 0.0
    },
    {
      "from": 171.14,
      "to": 173.18,
      "sid": 94,
      "location": 2,
      "content": "Sometimes the most people are from canada",
      "music": 0.0
    },
    {
      "from": 173.18,
      "to": 175.44,
      "sid": 95,
      "location": 2,
      "content": "Or going to uh merely from canada",
      "music": 0.0
    },
    {
      "from": 175.44,
      "to": 177.76,
      "sid": 96,
      "location": 2,
      "content": "We only get many people go to canada",
      "music": 0.0
    },
    {
      "from": 177.76,
      "to": 178.92,
      "sid": 97,
      "location": 2,
      "content": "They like come here",
      "music": 0.0
    },
    {
      "from": 178.92,
      "to": 180.12,
      "sid": 98,
      "location": 2,
      "content": "Go shopping with that",
      "music": 0.0
    },
    {
      "from": 180.12,
      "to": 180.92,
      "sid": 99,
      "location": 2,
      "content": "And then they go back",
      "music": 0.0
    },
    {
      "from": 180.92,
      "to": 181.08,
      "sid": 100,
      "location": 2,
      "content": "You",
      "music": 0.0
    },
    {
      "from": 181.08,
      "to": 182.74,
      "sid": 101,
      "location": 2,
      "content": "Don't really see that often uh",
      "music": 0.0
    },
    {
      "from": 182.74,
      "to": 185.24,
      "sid": 102,
      "location": 2,
      "content": "Kind of a dead place to be",
      "music": 0.0
    },
    {
      "from": 185.24,
      "to": 186.98,
      "sid": 103,
      "location": 2,
      "content": "Not sure big big town",
      "music": 0.0
    },
    {
      "from": 186.98,
      "to": 188.72,
      "sid": 104,
      "location": 2,
      "content": "我猜店员提到了购物",
      "music": 0.0
    },
    {
      "from": 188.72,
      "to": 190.68,
      "sid": 105,
      "location": 2,
      "content": "可能就是这个小镇的杂货店",
      "music": 0.0
    },
    {
      "from": 190.68,
      "to": 193.68,
      "sid": 106,
      "location": 2,
      "content": "这也是这一片区域内唯一一家杂货店了",
      "music": 0.0
    },
    {
      "from": 193.68,
      "to": 196.28,
      "sid": 107,
      "location": 2,
      "content": "在它西南方向高速交叉口的杂货店",
      "music": 0.0
    },
    {
      "from": 196.28,
      "to": 197.78,
      "sid": 108,
      "location": 2,
      "content": "我来的时候还路过了",
      "music": 0.0
