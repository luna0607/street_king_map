  "body": [
    {
      "from": 0.12,
      "to": 0.88,
      "sid": 1,
      "location": 2,
      "content": "大家好啊",
      "music": 0.0
    },
    {
      "from": 0.88,
      "to": 2.44,
      "sid": 2,
      "location": 2,
      "content": "今天我来到了密西西比河畔",
      "music": 0.0
    },
    {
      "from": 2.44,
      "to": 4.439,
      "sid": 3,
      "location": 2,
      "content": "一个叫做马斯卡廷的小城",
      "music": 0.0
    },
    {
      "from": 4.439,
      "to": 6.439,
      "sid": 4,
      "location": 2,
      "content": "这里2020年人口普查显示",
      "music": 0.0
    },
    {
      "from": 6.439,
      "to": 8.54,
      "sid": 5,
      "location": 2,
      "content": "有2万3670一个人",
      "music": 0.0
    },
    {
      "from": 8.54,
      "to": 10.46,
      "sid": 6,
      "location": 2,
      "content": "其中72%是白人",
      "music": 0.0
    },
    {
      "from": 10.46,
      "to": 11.9,
      "sid": 7,
      "location": 2,
      "content": "20%是拉美人",
      "music": 0.0
    },
    {
      "from": 11.9,
      "to": 13.28,
      "sid": 8,
      "location": 2,
      "content": "4%是黑人",
      "music": 0.0
    },
    {
      "from": 13.28,
      "to": 15.719,
      "sid": 9,
      "location": 2,
      "content": "这个小镇是靠密西西比河发家的",
      "music": 0.0
    },
    {
      "from": 15.719,
      "to": 16.999,
      "sid": 10,
      "location": 2,
      "content": "但是他发家的方式",
      "music": 0.0
    },
    {
      "from": 16.999,
      "to": 19.43,
      "sid": 11,
      "location": 2,
      "content": "和大部分人想到的航运之类的不同",
      "music": 0.0
    },
    {
      "from": 19.43,
      "to": 22.95,
      "sid": 12,
      "location": 2,
      "content": "这边1900年前后是世界上的珍珠纽扣之都",
      "music": 0.0
    },
    {
      "from": 22.95,
      "to": 26.13,
      "sid": 13,
      "location": 2,
      "content": "而小镇中心就有一座博物馆来纪念这一段历史",
      "music": 0.0
    },
    {
      "from": 26.13,
      "to": 26.97,
      "sid": 14,
      "location": 2,
      "content": "1888年",
      "music": 0.0
    },
    {
      "from": 26.97,
      "to": 28.73,
      "sid": 15,
      "location": 2,
      "content": "一名德国的新移民发现",
      "music": 0.0
    },
    {
      "from": 28.73,
      "to": 30.89,
      "sid": 16,
      "location": 2,
      "content": "密西西比河床上面有很多青口贝",
      "music": 0.0
    },
    {
      "from": 30.89,
      "to": 32.64,
      "sid": 17,
      "location": 2,
      "content": "河蚌之类的贝类生物",
      "music": 0.0
    },
    {
      "from": 32.64,
      "to": 35.73,
      "sid": 18,
      "location": 2,
      "content": "他发现这些贝壳可以造出衣服上面的纽扣",
      "music": 0.0
    },
    {
      "from": 35.73,
      "to": 38.55,
      "sid": 19,
      "location": 2,
      "content": "于是他在马斯卡廷开了第一家纽扣工厂",
      "music": 0.0
    },
    {
      "from": 38.55,
      "to": 41.21,
      "sid": 20,
      "location": 2,
      "content": "They were taken to the factors in the soaking and",
      "music": 0.0
    },
    {
      "from": 41.21,
      "to": 42.519,
      "sid": 21,
      "location": 2,
      "content": "Big vats of water",
      "music": 0.0
    },
    {
      "from": 42.519,
      "to": 45.419,
      "sid": 22,
      "location": 2,
      "content": "Kind of soften the money before they grow home",
      "music": 0.0
    },
    {
      "from": 45.419,
      "to": 48.079,
      "sid": 23,
      "location": 2,
      "content": "很快很多人也发现了这个商机",
      "music": 0.0
    },
    {
      "from": 48.079,
      "to": 50.54,
      "sid": 24,
      "location": 2,
      "content": "于是这个小城的人口快速增加",
      "music": 0.0
    },
    {
      "from": 50.54,
      "to": 51.9,
      "sid": 25,
      "location": 2,
      "content": "最繁荣的20年内",
      "music": 0.0
    },
    {
      "from": 51.9,
      "to": 53.58,
      "sid": 26,
      "location": 2,
      "content": "人口增加了50%",
      "music": 0.0
    },
    {
      "from": 53.58,
      "to": 56.55,
      "sid": 27,
      "location": 2,
      "content": "那个时候小镇到处都是珍珠纽扣工厂",
      "music": 0.0
    },
    {
      "from": 56.55,
      "to": 58.93,
      "sid": 28,
      "location": 2,
      "content": "而河里也到处都是挖牡蛎的人",
      "music": 0.0
    },
    {
      "from": 58.93,
      "to": 61.129,
      "sid": 29,
      "location": 2,
      "content": "街头巷尾都是被丢弃的贝壳",
      "music": 0.0
    },
    {
      "from": 61.129,
      "to": 61.969,
      "sid": 30,
      "location": 2,
      "content": "听小姐姐说",
      "music": 0.0
    },
    {
      "from": 61.969,
      "to": 64.049,
      "sid": 31,
      "location": 2,
      "content": "现在新挖管道或者建房子之类的",
      "music": 0.0
    },
    {
      "from": 64.049,
      "to": 66.8,
      "sid": 32,
      "location": 2,
      "content": "都能在土地下面找到原先被丢弃的贝壳",
      "music": 0.0
    },
    {
      "from": 66.8,
      "to": 69.0,
      "sid": 33,
      "location": 2,
      "content": "可这火热的行业也带来了很多问题",
      "music": 0.0
    },
    {
      "from": 69.0,
      "to": 70.68,
      "sid": 34,
      "location": 2,
      "content": "最严重的是马斯克亭附近",
      "music": 0.0
    },
    {
      "from": 70.68,
      "to": 72.76,
      "sid": 35,
      "location": 2,
      "content": "河床下面的贝类生物都绝迹了",
      "music": 0.0
    },
    {
      "from": 72.76,
      "to": 75.82,
      "sid": 36,
      "location": 2,
      "content": "原材料只能一车一车的从别的地方拉过来",
      "music": 0.0
    },
    {
      "from": 75.82,
      "to": 79.1,
      "sid": 37,
      "location": 2,
      "content": "但是真正摧毁珍珠纽扣业的还是时尚的改变",
      "music": 0.0
    },
    {
      "from": 79.1,
      "to": 80.34,
      "sid": 38,
      "location": 2,
      "content": "以及塑料的发明",
      "music": 0.0
    },
    {
      "from": 80.34,
      "to": 83.71,
      "sid": 39,
      "location": 2,
      "content": "珍珠纽扣是一份需要很多人工投入的辛苦活",
      "music": 0.0
    },
    {
      "from": 83.71,
      "to": 86.67,
      "sid": 40,
      "location": 2,
      "content": "而那个年代美国人大多也没有现在这么富裕",
      "music": 0.0
    },
    {
      "from": 86.67,
      "to": 88.59,
      "sid": 41,
      "location": 2,
      "content": "很多都是欧洲过来的苦力",
      "music": 0.0
    },
    {
      "from": 88.59,
      "to": 90.71,
      "sid": 42,
      "location": 2,
      "content": "那个时候他们每周要工作六天",
      "music": 0.0
    },
    {
      "from": 90.71,
      "to": 92.09,
      "sid": 43,
      "location": 2,
      "content": "每天十个小时",
      "music": 0.0
    },
    {
      "from": 92.09,
      "to": 94.33,
      "sid": 44,
      "location": 2,
      "content": "而且滥用童工的情况很严重",
      "music": 0.0
    },
    {
      "from": 94.33,
      "to": 97.25,
      "sid": 45,
      "location": 2,
      "content": "塑料的发明大大减轻了原材料上面的成本",
      "music": 0.0
    },
    {
      "from": 97.25,
      "to": 99.98,
      "sid": 46,
      "location": 2,
      "content": "由于贝类不再被用来做纽扣的原材料了",
      "music": 0.0
    },
    {
      "from": 99.98,
      "to": 101.84,
      "sid": 47,
      "location": 2,
      "content": "这边的产业也渐渐衰败了",
      "music": 0.0
    },
    {
      "from": 101.84,
      "to": 102.82,
      "sid": 48,
      "location": 2,
      "content": "在1940年代",
      "music": 0.0
    },
    {
      "from": 102.82,
      "to": 105.52,
      "sid": 49,
      "location": 2,
      "content": "这里最后一家珍珠纽扣工厂关上了大门",
      "music": 0.0
    },
    {
      "from": 105.52,
      "to": 106.42,
      "sid": 50,
      "location": 2,
      "content": "除此之外",
      "music": 0.0
    },
    {
      "from": 106.42,
      "to": 108.54,
      "sid": 51,
      "location": 2,
      "content": "马斯克林还知名于这里的西瓜",
      "music": 0.0
    },
    {
      "from": 108.54,
      "to": 110.7,
      "sid": 52,
      "location": 2,
      "content": "以及马斯卡廷的城市小报",
      "music": 0.0
    },
    {
      "from": 110.7,
      "to": 113.32,
      "sid": 53,
      "location": 2,
      "content": "马克吐温的哥哥曾经是这家报社的老板",
      "music": 0.0
    },
    {
      "from": 113.32,
      "to": 116.34,
      "sid": 54,
      "location": 2,
      "content": "因此马克吐温在马斯卡提生活过一段时间",
      "music": 0.0
    },
    {
      "from": 116.34,
      "to": 118.46,
      "sid": 55,
      "location": 2,
      "content": "他曾经盛赞过马斯卡廷的日落",
      "music": 0.0
    },
    {
      "from": 118.46,
      "to": 121.22,
      "sid": 56,
      "location": 2,
      "content": "说从未见过任何能和他们相比的东西",
      "music": 0.0
    },
    {
      "from": 121.22,
      "to": 124.38,
      "sid": 57,
      "location": 2,
      "content": "马克吐温最有名的作品当然是汤姆索亚历险记",
      "music": 0.0
    },
    {
      "from": 124.38,
      "to": 125.14,
      "sid": 58,
      "location": 2,
      "content": "正好这段时间",
      "music": 0.0
    },
    {
      "from": 125.14,
      "to": 127.86,
      "sid": 59,
      "location": 2,
      "content": "我一直在薄荷阅读上面看他这本书的原版",
      "music": 0.0
    },
    {
      "from": 127.86,
      "to": 129.26,
      "sid": 60,
      "location": 2,
      "content": "很多我不认识的生词",
      "music": 0.0
    },
    {
      "from": 129.26,
      "to": 131.29,
      "sid": 61,
      "location": 2,
      "content": "他都在上面标注了中文含义",
      "music": 0.0
    },
    {
      "from": 131.29,
      "to": 134.17,
      "sid": 62,
      "location": 2,
      "content": "我特别喜欢他在查询词汇上面的设计",
      "music": 0.0
    },
    {
      "from": 134.17,
      "to": 136.63,
      "sid": 63,
      "location": 2,
      "content": "长按单词可以直接查询单词的意思",
      "music": 0.0
    },
    {
      "from": 136.63,
      "to": 137.91,
      "sid": 64,
      "location": 2,
      "content": "并加入单词本",
      "music": 0.0
    },
    {
      "from": 137.91,
      "to": 138.85,
      "sid": 65,
      "location": 2,
      "content": "比较难的短句",
      "music": 0.0
    },
    {
      "from": 138.85,
      "to": 140.53,
      "sid": 66,
      "location": 2,
      "content": "一般也都有划线标注",
      "music": 0.0
    },
    {
      "from": 140.53,
      "to": 143.34,
      "sid": 67,
      "location": 2,
      "content": "这些小功能使得我的阅读体验非常的流畅",
      "music": 0.0
    },
    {
      "from": 143.34,
      "to": 145.72,
      "sid": 68,
      "location": 2,
      "content": "每一章之后还有小测验和讲解",
      "music": 0.0
    },
    {
      "from": 145.72,
      "to": 147.42,
      "sid": 69,
      "location": 2,
      "content": "这些小工具也是薄荷阅读",
      "music": 0.0
    },
    {
      "from": 147.42,
      "to": 149.73,
      "sid": 70,
      "location": 2,
      "content": "比起传统的纸质书最大的优势",
      "music": 0.0
    },
    {
      "from": 149.73,
      "to": 152.11,
      "sid": 71,
      "location": 2,
      "content": "我也可以更容易坚持读完一本书",
      "music": 0.0
    },
    {
      "from": 152.11,
      "to": 153.77,
      "sid": 72,
      "location": 2,
      "content": "在汤姆索亚历险记之外",
      "music": 0.0
    },
    {
      "from": 153.77,
      "to": 156.23,
      "sid": 73,
      "location": 2,
      "content": "薄荷阅读提供更丰富的书呆选择",
      "music": 0.0
    },
    {
      "from": 156.23,
      "to": 157.75,
      "sid": 74,
      "location": 2,
      "content": "内容涵盖经典文学",
      "music": 0.0
    },
    {
      "from": 157.75,
      "to": 158.57,
      "sid": 75,
      "location": 2,
      "content": "畅销小说",
      "music": 0.0
    },
    {
      "from": 158.57,
      "to": 160.29,
      "sid": 76,
      "location": 2,
      "content": "专业百科等各种品类",
      "music": 0.0
    },
    {
      "from": 160.29,
      "to": 161.65,
      "sid": 77,
      "location": 2,
      "content": "从初阶的童话",
      "music": 0.0
    },
    {
      "from": 161.65,
      "to": 164.77,
      "sid": 78,
      "location": 2,
      "content": "中阶的福尔摩斯到高阶的百年孤独",
      "music": 0.0
    },
    {
      "from": 164.77,
      "to": 166.33,
      "sid": 79,
      "location": 2,
      "content": "每个人都能找到适合自己",
      "music": 0.0
    },
    {
      "from": 166.33,
      "to": 167.75,
      "sid": 80,
      "location": 2,
      "content": "没有太大压力的书籍",
      "music": 0.0
    },
    {
      "from": 167.75,
      "to": 169.24,
      "sid": 81,
      "location": 2,
      "content": "大家快去下载吧",
      "music": 0.0
    },
    {
      "from": 169.24,
      "to": 171.22,
      "sid": 82,
      "location": 2,
      "content": "其实我今天借到的密西西比河",
      "music": 0.0
    },
    {
      "from": 171.22,
      "to": 173.74,
      "sid": 83,
      "location": 2,
      "content": "和我根据文学作品想象的不太一样",
      "music": 0.0
    },
    {
      "from": 173.74,
      "to": 175.91,
      "sid": 84,
      "location": 2,
      "content": "我以为航运会非常的繁忙",
      "music": 0.0
    },
    {
      "from": 175.91,
      "to": 178.51,
      "sid": 85,
      "location": 2,
      "content": "于是我问了一下在展览馆工作的老奶奶",
      "music": 0.0
    },
    {
      "from": 178.51,
      "to": 180.7,
      "sid": 86,
      "location": 2,
      "content": "为什么今天这么的空空荡荡",
      "music": 0.0
    },
    {
      "from": 180.7,
      "to": 182.02,
      "sid": 87,
      "location": 2,
      "content": "You know i don't know",
      "music": 0.0
    },
    {
      "from": 182.02,
