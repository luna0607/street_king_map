      "version": "qwen72_v0.0.0"
    },
    {
      "from": 316.83,
      "to": 318.2,
      "sid": 183,
      "location": 2,
      "content": "aside from treatment",
      "music": 0.0,
      "version": "qwen72_v0.0.0"
    },
    {
      "from": 319.88,
      "to": 322.64,
      "sid": 184,
      "location": 2,
      "content": "this is basically what the patients' lives look like",
