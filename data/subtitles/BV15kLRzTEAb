      "version": "qwen72_v0.0.0"
    },
    {
      "from": 301.32,
      "to": 302.58,
      "sid": 175,
      "location": 2,
      "content": "For future planning and such",
      "music": 0.0,
      "version": "qwen72_v0.0.0"
    },
    {
      "from": 302.58,
      "to": 303.88,
      "sid": 176,
      "location": 2,
      "content": "After you go out, right",
      "music": 0.0,
      "version": "qwen72_v0.0.0"
    },
    {
      "from": 303.88,
      "to": 305.08,
      "sid": 177,
      "location": 2,
      "content": "How are you going to find a job",
      "music": 0.0,
      "version": "qwen72_v0.0.0"
    },
    {
      "from": 305.08,
      "to": 307.35,
      "sid": 178,
      "location": 2,
      "content": "And how are you going to reintegrate into society, right",
      "music": 0.0,
      "version": "qwen72_v0.0.0"
    },
    {
      "from": 307.35,
      "to": 308.79,
      "sid": 179,
      "location": 2,
      "content": "How can you ensure that you won’t come back, right",
      "music": 0.0,
      "version": "qwen72_v0.0.0"
    },
    {
      "from": 308.79,
      "to": 311.19,
      "sid": 180,
      "location": 2,
      "content": "In short, it’s about helping them reintegrate into society",
      "music": 0.0,
      "version": "qwen72_v0.0.0"
    },
    {
      "from": 311.19,
      "to": 315.03,
      "sid": 181,
      "location": 2,
      "content": "Stop frequently getting into trouble or dealing with the legal system",
      "music": 0.0,
      "version": "qwen72_v0.0.0"
    },
    {
      "from": 315.03,
      "to": 316.83,
      "sid": 182,
      "location": 2,
      "content": "which prevents them from returning to the hospital",
