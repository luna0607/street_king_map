      "version": "qwen72_v0.0.0"
    },
    {
      "from": 297.92,
      "to": 298.8,
      "sid": 173,
      "location": 2,
      "content": "I know you don’t want to come back",
      "music": 0.0,
      "version": "qwen72_v0.0.0"
    },
    {
      "from": 298.8,
      "to": 301.32,
      "sid": 174,
      "location": 2,
      "content": "These skills are crucial for you",
