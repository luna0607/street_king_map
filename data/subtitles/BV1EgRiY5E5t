  "body": [
    {
      "from": 0.04,
      "to": 2.68,
      "sid": 1,
      "location": 2,
      "content": "今天我来到了密西西比河畔阿克斯州的小镇",
      "music": 0.0
    },
    {
      "from": 2.68,
      "to": 3.64,
      "sid": 2,
      "location": 2,
      "content": "海伦娜的中心",
      "music": 0.0
    },
    {
      "from": 3.64,
      "to": 4.4,
      "sid": 3,
      "location": 2,
      "content": "Cherry street",
      "music": 0.0
    },
    {
      "from": 4.4,
      "to": 5.24,
      "sid": 4,
      "location": 2,
      "content": "樱桃小街",
      "music": 0.0
    },
    {
      "from": 5.24,
      "to": 7.98,
      "sid": 5,
      "location": 2,
      "content": "海伦娜曾经是一座繁荣的交通枢纽小镇",
      "music": 0.0
    },
    {
      "from": 7.98,
      "to": 9.92,
      "sid": 6,
      "location": 2,
      "content": "但随着航运和铁路的衰落",
      "music": 0.0
    },
    {
      "from": 9.92,
      "to": 11.06,
      "sid": 7,
      "location": 2,
      "content": "从1970年起",
      "music": 0.0
    },
    {
      "from": 11.06,
      "to": 12.98,
      "sid": 8,
      "location": 2,
      "content": "这边的人口就开始急剧流失",
      "music": 0.0
    },
    {
      "from": 12.98,
      "to": 15.74,
      "sid": 9,
      "location": 2,
      "content": "以至于海伦娜在2006年和隔壁的西海伦那",
      "music": 0.0
    },
    {
      "from": 15.74,
      "to": 16.82,
      "sid": 10,
      "location": 2,
      "content": "合并成了一个大镇",
      "music": 0.0
    },
    {
      "from": 16.82,
      "to": 19.02,
      "sid": 11,
      "location": 2,
      "content": "以增加一些人口和政治影响力",
      "music": 0.0
    },
    {
      "from": 19.02,
      "to": 21.86,
      "sid": 12,
      "location": 2,
      "content": "卡德纳所在的菲利普县也是阿肯色州最穷的县",
      "music": 0.0
    },
    {
      "from": 21.86,
      "to": 24.42,
      "sid": 13,
      "location": 2,
      "content": "而阿肯色州也是常年稳定在美国最穷的州",
      "music": 0.0
    },
    {
      "from": 24.42,
      "to": 25.32,
      "sid": 14,
      "location": 2,
      "content": "榜单前五名",
      "music": 0.0
    },
    {
      "from": 25.32,
      "to": 27.46,
      "sid": 15,
      "location": 2,
      "content": "在这个樱桃小街上开车转一圈",
      "music": 0.0
    },
    {
      "from": 27.46,
      "to": 29.34,
      "sid": 16,
      "location": 2,
      "content": "如今这片核心区的大部分老建筑",
      "music": 0.0
    },
    {
      "from": 29.34,
      "to": 30.84,
      "sid": 17,
      "location": 2,
      "content": "都是这样待修的状态",
      "music": 0.0
    },
    {
      "from": 30.84,
      "to": 32.12,
      "sid": 18,
      "location": 2,
      "content": "除了我右手边的红楼",
      "music": 0.0
    },
    {
      "from": 32.12,
      "to": 33.38,
      "sid": 19,
      "location": 2,
      "content": "飞利浦县县法院",
      "music": 0.0
    },
    {
      "from": 33.38,
      "to": 36.47,
      "sid": 20,
      "location": 2,
      "content": "以及零星的几家小店和两个博物馆还在营业",
      "music": 0.0
    },
    {
      "from": 36.47,
      "to": 37.89,
      "sid": 21,
      "location": 2,
      "content": "在这边随便走一走",
      "music": 0.0
    },
    {
      "from": 37.89,
      "to": 40.27,
      "sid": 22,
      "location": 2,
      "content": "很多街角甚至都有一些末日风",
      "music": 0.0
    },
    {
      "from": 40.27,
      "to": 41.97,
      "sid": 23,
      "location": 2,
      "content": "2020年人口普查显示",
      "music": 0.0
    },
    {
      "from": 41.97,
      "to": 43.31,
      "sid": 24,
      "location": 2,
      "content": "这边是76%",
      "music": 0.0
    },
    {
      "from": 43.31,
      "to": 43.79,
      "sid": 25,
      "location": 2,
      "content": "黑人",
      "music": 0.0
    },
    {
      "from": 43.79,
      "to": 45.11,
      "sid": 26,
      "location": 2,
      "content": "20%白人",
      "music": 0.0
    },
    {
      "from": 45.11,
      "to": 47.32,
      "sid": 27,
      "location": 2,
      "content": "而亚洲人占比0.37%",
      "music": 0.0
    },
    {
      "from": 47.32,
      "to": 48.8,
      "sid": 28,
      "location": 2,
      "content": "一共只有35个",
      "music": 0.0
    },
    {
      "from": 48.8,
      "to": 50.24,
      "sid": 29,
      "location": 2,
      "content": "再带大家看这里的历史",
      "music": 0.0
    },
    {
      "from": 50.24,
      "to": 53.67,
      "sid": 30,
      "location": 2,
      "content": "之前先去这座小城里广东老板开的餐馆吃个饭",
      "music": 0.0
    },
    {
      "from": 53.67,
      "to": 56.03,
      "sid": 31,
      "location": 2,
      "content": "他们这里主打的菜品其实不只是中餐",
      "music": 0.0
    },
    {
      "from": 56.03,
      "to": 58.22,
      "sid": 32,
      "location": 2,
      "content": "还有本地人超爱吃的美国南方菜",
      "music": 0.0
    },
    {
      "from": 58.22,
      "to": 60.1,
      "sid": 33,
      "location": 2,
      "content": "就是前面的这个白色小房子",
      "music": 0.0
    },
    {
      "from": 60.1,
      "to": 61.68,
      "sid": 34,
      "location": 2,
      "content": "要不是我提前做了功课",
      "music": 0.0
    },
    {
      "from": 61.68,
      "to": 62.9,
      "sid": 35,
      "location": 2,
      "content": "普通人还真发现不了",
      "music": 0.0
    },
    {
      "from": 62.9,
      "to": 64.8,
      "sid": 36,
      "location": 2,
      "content": "这是一家卖黑人菜的中餐馆",
      "music": 0.0
    },
    {
      "from": 64.8,
      "to": 65.56,
      "sid": 37,
      "location": 2,
      "content": "我刚停好车",
      "music": 0.0
    },
    {
      "from": 65.56,
      "to": 67.9,
      "sid": 38,
      "location": 2,
      "content": "就发现一个警察从这个餐厅里走出来",
      "music": 0.0
    },
    {
      "from": 67.9,
      "to": 69.52,
      "sid": 39,
      "location": 2,
      "content": "我先到车里回避一下",
      "music": 0.0
    },
    {
      "from": 69.52,
      "to": 71.08,
      "sid": 40,
      "location": 2,
      "content": "主要是因为我刚刚进城的时候",
      "music": 0.0
    },
    {
      "from": 71.08,
      "to": 72.02,
      "sid": 41,
      "location": 2,
      "content": "有一点超速",
      "music": 0.0
    },
    {
      "from": 72.02,
      "to": 74.1,
      "sid": 42,
      "location": 2,
      "content": "正好被阿肯色的警察给逮着了",
      "music": 0.0
    },
    {
      "from": 74.1,
      "to": 77.0,
      "sid": 43,
      "location": 2,
      "content": "直接给我逼近到了野外公路边的废弃加油站",
      "music": 0.0
    },
    {
      "from": 77.0,
      "to": 80.14,
      "sid": 44,
      "location": 2,
      "content": "Three eight heritage",
      "music": 0.0
    },
    {
      "from": 85.66,
      "to": 87.5,
      "sid": 45,
      "location": 2,
      "content": "虽然说警察哥们人还不错",
      "music": 0.0
    },
    {
      "from": 87.5,
      "to": 89.5,
      "sid": 46,
      "location": 2,
      "content": "但是我在阿肯斯还是小心为上",
      "music": 0.0
    },
    {
      "from": 89.5,
      "to": 90.34,
      "sid": 47,
      "location": 2,
      "content": "等警察走了",
      "music": 0.0
    },
    {
      "from": 90.34,
      "to": 91.43,
      "sid": 48,
      "location": 2,
      "content": "我才进去吃饭",
      "music": 0.0
    },
    {
      "from": 91.43,
      "to": 93.39,
      "sid": 49,
      "location": 2,
      "content": "看他这个门头的字都掉下来了",
      "music": 0.0
    },
    {
      "from": 93.39,
      "to": 94.88,
      "sid": 50,
      "location": 2,
      "content": "想必也是一家老店",
      "music": 0.0
    },
    {
      "from": 94.88,
      "to": 97.74,
      "sid": 51,
      "location": 2,
      "content": "一进来发现他们的主打菜单是一个午餐套餐",
      "music": 0.0
    },
    {
      "from": 97.74,
      "to": 98.84,
      "sid": 52,
      "location": 2,
      "content": "上面是一个中餐",
      "music": 0.0
    },
    {
      "from": 98.84,
      "to": 101.05,
      "sid": 53,
      "location": 2,
      "content": "没有全部都是美国南方特色菜",
      "music": 0.0
    },
    {
      "from": 101.05,
      "to": 104.25,
      "sid": 54,
      "location": 2,
      "content": "主菜可以选炸鸡炖猪肉或者汉堡肉排",
      "music": 0.0
    },
    {
      "from": 104.25,
      "to": 106.3,
      "sid": 55,
      "location": 2,
      "content": "附带三份小菜和一杯饮料",
      "music": 0.0
    },
    {
      "from": 106.3,
      "to": 107.54,
      "sid": 56,
      "location": 2,
      "content": "收费是12.95",
      "music": 0.0
    },
    {
      "from": 107.54,
      "to": 107.98,
      "sid": 57,
      "location": 2,
      "content": "一个人",
      "music": 0.0
    },
    {
      "from": 107.98,
      "to": 110.14,
      "sid": 58,
      "location": 2,
      "content": "各位觉得值不值值得扣一不值的扣二",
      "music": 0.0
    },
    {
      "from": 110.14,
      "to": 111.92,
      "sid": 59,
      "location": 2,
      "content": "这个地方很少能见到中国人",
      "music": 0.0
    },
    {
      "from": 111.92,
      "to": 112.92,
      "sid": 60,
      "location": 2,
      "content": "老板特别好",
      "music": 0.0
    },
    {
      "from": 112.92,
      "to": 113.64,
      "sid": 61,
      "location": 2,
      "content": "非常热情",
      "music": 0.0
    },
    {
      "from": 113.64,
      "to": 115.02,
      "sid": 62,
      "location": 2,
      "content": "甚至还有一点可爱",
      "music": 0.0
    },
    {
      "from": 115.02,
      "to": 116.06,
      "sid": 63,
      "location": 2,
      "content": "我刚点好了菜",
      "music": 0.0
    },
    {
      "from": 116.06,
      "to": 118.44,
      "sid": 64,
      "location": 2,
      "content": "他就送了我一块炸鸡和一份甜薯",
      "music": 0.0
    },
    {
      "from": 118.44,
      "to": 120.32,
      "sid": 65,
      "location": 2,
      "content": "老板开这家店快40年了",
      "music": 0.0
    },
    {
      "from": 120.32,
      "to": 122.0,
      "sid": 66,
      "location": 2,
      "content": "员工也快在这干了6年",
      "music": 0.0
    },
    {
      "from": 122.0,
      "to": 123.28,
      "sid": 67,
      "location": 2,
      "content": "除了他们两个广东人",
      "music": 0.0
    },
    {
      "from": 123.28,
      "to": 124.75,
      "sid": 68,
      "location": 2,
      "content": "其他请的都是本地人",
      "music": 0.0
    },
    {
      "from": 124.75,
      "to": 126.37,
      "sid": 69,
      "location": 2,
      "content": "他们这里的饭非常好吃啊",
      "music": 0.0
    },
    {
      "from": 126.37,
      "to": 127.31,
      "sid": 70,
      "location": 2,
      "content": "我快吃完的时候",
      "music": 0.0
    },
    {
      "from": 127.31,
      "to": 129.759,
      "sid": 71,
      "location": 2,
      "content": "他们还送了一点美式中餐鸡给我尝一尝",
      "music": 0.0
    },
    {
      "from": 129.759,
      "to": 131.819,
      "sid": 72,
      "location": 2,
      "content": "要是真的有B友路过这里吃饭的话",
      "music": 0.0
    },
    {
      "from": 131.819,
      "to": 133.239,
      "sid": 73,
      "location": 2,
      "content": "不甜的菜味道都很好",
      "music": 0.0
    },
    {
      "from": 133.239,
      "to": 135.39,
      "sid": 74,
      "location": 2,
      "content": "而点甜的菜的时候要慎重一点",
      "music": 0.0
    },
    {
      "from": 135.39,
      "to": 137.47,
      "sid": 75,
      "location": 2,
      "content": "如果粤菜和川菜的甜度是一",
      "music": 0.0
    },
    {
      "from": 137.47,
      "to": 138.91,
      "sid": 76,
      "location": 2,
      "content": "江浙菜的甜度是四",
      "music": 0.0
    },
    {
      "from": 138.91,
      "to": 140.77,
      "sid": 77,
      "location": 2,
      "content": "这个田鼠的甜度可以到六",
      "music": 0.0
    },
    {
      "from": 140.77,
      "to": 142.31,
      "sid": 78,
      "location": 2,
      "content": "甜品派的甜度可以到九",
      "music": 0.0
    },
    {
      "from": 142.31,
      "to": 144.44,
      "sid": 79,
      "location": 2,
      "content": "这两个都是美国南方人超爱吃的菜",
      "music": 0.0
    },
    {
      "from": 144.44,
      "to": 146.88,
      "sid": 80,
      "location": 2,
      "content": "像是上上期视频来自皮西比的TIKI",
      "music": 0.0
    },
    {
      "from": 146.88,
      "to": 148.0,
      "sid": 81,
      "location": 2,
      "content": "点的就是这个田鼠",
      "music": 0.0
    },
    {
      "from": 148.0,
      "to": 149.32,
      "sid": 82,
      "location": 2,
      "content": "而我今天到店里的时候",
      "music": 0.0
    },
    {
      "from": 149.32,
      "to": 151.04,
      "sid": 83,
      "location": 2,
      "content": "甜品派也只剩最后一份了",
      "music": 0.0
    },
    {
      "from": 151.04,
      "to": 152.1,
      "sid": 84,
      "location": 2,
      "content": "卖的特别好",
      "music": 0.0
    },
    {
      "from": 152.1,
      "to": 154.1,
      "sid": 85,
      "location": 2,
      "content": "我个人觉得田鼠非常好吃",
      "music": 0.0
    },
    {
      "from": 154.1,
      "to": 156.649,
      "sid": 86,
      "location": 2,
      "content": "但是我估计绝大部分人受不了这个甜度",
      "music": 0.0
    },
    {
      "from": 156.649,
      "to": 158.569,
      "sid": 87,
      "location": 2,
      "content": "而这个本地人很爱吃的甜品派",
      "music": 0.0
    },
    {
      "from": 158.569,
      "to": 160.56,
      "sid": 88,
      "location": 2,
      "content": "都有一点超出我的接受范围了",
      "music": 0.0
    },
    {
      "from": 160.56,
      "to": 162.4,
      "sid": 89,
      "location": 2,
      "content": "不过这餐厅的氛围真挺好的",
      "music": 0.0
    },
    {
      "from": 162.4,
      "to": 164.16,
      "sid": 90,
      "location": 2,
      "content": "吃饭的时候我也顺便问了一下老板",
      "music": 0.0
    },
    {
      "from": 164.16,
      "to": 165.6,
      "sid": 91,
      "location": 2,
      "content": "他为什么选择在这里开店",
      "music": 0.0
    },
    {
      "from": 165.6,
      "to": 166.94,
      "sid": 92,
      "location": 2,
      "content": "快40年吃饭",
      "music": 0.0
    },
    {
      "from": 166.94,
      "to": 169.15,
      "sid": 93,
      "location": 2,
      "content": "这里临近小山村",
      "music": 0.0
    },
    {
      "from": 169.15,
      "to": 169.95,
      "sid": 94,
      "location": 2,
      "content": "我也不去吃",
      "music": 0.0
    },
    {
      "from": 169.95,
      "to": 170.67,
      "sid": 95,
      "location": 2,
      "content": "我也不去看",
      "music": 0.0
    },
    {
      "from": 170.67,
      "to": 172.09,
      "sid": 96,
      "location": 2,
      "content": "大城市有些乱",
      "music": 0.0
    },
    {
      "from": 172.09,
      "to": 174.43,
      "sid": 97,
      "location": 2,
      "content": "而且我们说很难做生意",
      "music": 0.0
    },
    {
      "from": 174.43,
      "to": 175.03,
      "sid": 98,
      "location": 2,
      "content": "也很难做",
      "music": 0.0
    },
    {
      "from": 175.03,
      "to": 177.32,
      "sid": 99,
      "location": 2,
      "content": "我选择这里是地人",
      "music": 0.0
    },
    {
      "from": 177.32,
      "to": 179.38,
      "sid": 100,
      "location": 2,
      "content": "做事做惯做熟的",
      "music": 0.0
    },
    {
      "from": 179.38,
      "to": 181.18,
      "sid": 101,
      "location": 2,
      "content": "而且口碑好",
      "music": 0.0
    },
    {
      "from": 181.18,
      "to": 183.36,
      "sid": 102,
      "location": 2,
      "content": "因为他们只爱吃我的东西",
      "music": 0.0
    },
    {
      "from": 183.36,
      "to": 185.19,
      "sid": 103,
      "location": 2,
      "content": "所以我不搬嗯",
      "music": 0.0
    },
    {
      "from": 185.19,
      "to": 186.63,
      "sid": 104,
      "location": 2,
      "content": "那我们做了30多年",
      "music": 0.0
    },
    {
      "from": 186.63,
      "to": 188.949,
      "sid": 105,
      "location": 2,
      "content": "还是很多很多老顾客",
      "music": 0.0
    },
    {
      "from": 188.949,
      "to": 190.309,
      "sid": 106,
      "location": 2,
      "content": "32人",
      "music": 0.0
    },
    {
      "from": 190.309,
      "to": 192.209,
      "sid": 107,
      "location": 2,
      "content": "35年真的不是强人",
      "music": 0.0
    },
