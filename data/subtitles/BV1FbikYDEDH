  "body": [
    {
      "from": 0.04,
      "to": 2.4,
      "sid": 1,
      "location": 2,
      "content": "今天我来到了西雅图最顶级的富人区",
      "music": 0.0
    },
    {
      "from": 2.4,
      "to": 5.24,
      "sid": 2,
      "location": 2,
      "content": "也是比尔盖茨和亚马逊老板贝佐斯的老巢",
      "music": 0.0
    },
    {
      "from": 5.24,
      "to": 6.79,
      "sid": 3,
      "location": 2,
      "content": "梅迪纳的市政厅门口",
      "music": 0.0
    },
    {
      "from": 6.79,
      "to": 9.07,
      "sid": 4,
      "location": 2,
      "content": "美国的富人区一般都有两个特征",
      "music": 0.0
    },
    {
      "from": 9.07,
      "to": 10.33,
      "sid": 5,
      "location": 2,
      "content": "一是风景优美",
      "music": 0.0
    },
    {
      "from": 10.33,
      "to": 11.79,
      "sid": 6,
      "location": 2,
      "content": "二是安保极佳",
      "music": 0.0
    },
    {
      "from": 11.79,
      "to": 14.13,
      "sid": 7,
      "location": 2,
      "content": "像是梅迪娜一共还没有3000个人",
      "music": 0.0
    },
    {
      "from": 14.13,
      "to": 16.259,
      "sid": 8,
      "location": 2,
      "content": "这边居然还有这么多的警察",
      "music": 0.0
    },
    {
      "from": 16.259,
      "to": 18.499,
      "sid": 9,
      "location": 2,
      "content": "给大家看一看这边房子的价格",
      "music": 0.0
    },
    {
      "from": 18.499,
      "to": 20.199,
      "sid": 10,
      "location": 2,
      "content": "网上一查都是几百万",
      "music": 0.0
    },
    {
      "from": 20.199,
      "to": 22.5,
      "sid": 11,
      "location": 2,
      "content": "而转化到人口普查的数据来看",
      "music": 0.0
    },
    {
      "from": 22.5,
      "to": 24.18,
      "sid": 12,
      "location": 2,
      "content": "93%的房子的价格",
      "music": 0.0
    },
    {
      "from": 24.18,
      "to": 25.64,
      "sid": 13,
      "location": 2,
      "content": "都超过了100万美元",
      "music": 0.0
    },
    {
      "from": 25.64,
      "to": 26.76,
      "sid": 14,
      "location": 2,
      "content": "其实普通的美国人",
      "music": 0.0
    },
    {
      "from": 26.76,
      "to": 28.72,
      "sid": 15,
      "location": 2,
      "content": "没有大家想象中的那么的有钱啊",
      "music": 0.0
    },
    {
      "from": 28.72,
      "to": 30.08,
      "sid": 16,
      "location": 2,
      "content": "大部分人的家的价值",
      "music": 0.0
    },
    {
      "from": 30.08,
      "to": 32.59,
      "sid": 17,
      "location": 2,
      "content": "也就是在5万美元到100万美元之间",
      "music": 0.0
    },
    {
      "from": 32.59,
      "to": 34.35,
      "sid": 18,
      "location": 2,
      "content": "5万以下和100万以上的房子",
      "music": 0.0
    },
    {
      "from": 34.35,
      "to": 35.99,
      "sid": 19,
      "location": 2,
      "content": "都不再做细分统计了",
      "music": 0.0
    },
    {
      "from": 35.99,
      "to": 36.79,
      "sid": 20,
      "location": 2,
      "content": "我去了小镇",
      "music": 0.0
    },
    {
      "from": 36.79,
      "to": 38.89,
      "sid": 21,
      "location": 2,
      "content": "大部分的时候房价都是5万以下的",
      "music": 0.0
    },
    {
      "from": 38.89,
      "to": 40.83,
      "sid": 22,
      "location": 2,
      "content": "今天突破一下自己的舒适圈",
      "music": 0.0
    },
    {
      "from": 40.83,
      "to": 43.07,
      "sid": 23,
      "location": 2,
      "content": "给大家看一看百万美元的社区",
      "music": 0.0
    },
    {
      "from": 43.07,
      "to": 45.41,
      "sid": 24,
      "location": 2,
      "content": "虽然说围绕着梅迪娜的都是富人区",
      "music": 0.0
    },
    {
      "from": 45.41,
      "to": 48.68,
      "sid": 25,
      "location": 2,
      "content": "但是每一条进入小镇的道路口都是有摄像头的",
      "music": 0.0
    },
    {
      "from": 48.68,
      "to": 50.4,
      "sid": 26,
      "location": 2,
      "content": "像是我面前的这个栏杆",
      "music": 0.0
    },
    {
      "from": 50.4,
      "to": 51.92,
      "sid": 27,
      "location": 2,
      "content": "上面就是有一个警示牌",
      "music": 0.0
    },
    {
      "from": 51.92,
      "to": 53.96,
      "sid": 28,
      "location": 2,
      "content": "然后前面就是梅迪娜的标志",
      "music": 0.0
    },
    {
      "from": 53.96,
      "to": 55.22,
      "sid": 29,
      "location": 2,
      "content": "如果你是开车的话",
      "music": 0.0
    },
    {
      "from": 55.22,
      "to": 56.66,
      "sid": 30,
      "location": 2,
      "content": "他还会扫你的车牌",
      "music": 0.0
    },
    {
      "from": 56.66,
      "to": 58.0,
      "sid": 31,
      "location": 2,
      "content": "如果你有安迪什么的",
      "music": 0.0
    },
    {
      "from": 58.0,
      "to": 59.81,
      "sid": 32,
      "location": 2,
      "content": "它会自动通知警察局",
      "music": 0.0
    },
    {
      "from": 59.81,
      "to": 61.59,
      "sid": 33,
      "location": 2,
      "content": "像是我这种骑车进去的",
      "music": 0.0
    },
    {
      "from": 61.59,
      "to": 63.09,
      "sid": 34,
      "location": 2,
      "content": "警察局也会保留我的影像",
      "music": 0.0
    },
    {
      "from": 63.09,
      "to": 63.71,
      "sid": 35,
      "location": 2,
      "content": "60天",
      "music": 0.0
    },
    {
      "from": 63.71,
      "to": 66.759,
      "sid": 36,
      "location": 2,
      "content": "因为美国人普遍来说都比较讨厌这种摄像头",
      "music": 0.0
    },
    {
      "from": 66.759,
      "to": 69.719,
      "sid": 37,
      "location": 2,
      "content": "像是梅迪娜这种所有出入口都安监控的社区",
      "music": 0.0
    },
    {
      "from": 69.719,
      "to": 71.319,
      "sid": 38,
      "location": 2,
      "content": "我还是第一次见梅迪娜",
      "music": 0.0
    },
    {
      "from": 71.319,
      "to": 73.11,
      "sid": 39,
      "location": 2,
      "content": "总的来说是一个纯居住区",
      "music": 0.0
    },
    {
      "from": 73.11,
      "to": 74.45,
      "sid": 40,
      "location": 2,
      "content": "商业只有一个邮局",
      "music": 0.0
    },
    {
      "from": 74.45,
      "to": 75.41,
      "sid": 41,
      "location": 2,
      "content": "一个小超市",
      "music": 0.0
    },
    {
      "from": 75.41,
      "to": 77.15,
      "sid": 42,
      "location": 2,
      "content": "还有这个交叉路口的加油站",
      "music": 0.0
    },
    {
      "from": 77.15,
      "to": 79.73,
      "sid": 43,
      "location": 2,
      "content": "没想到这个加油站的厕所外面也有摄像头",
      "music": 0.0
    },
    {
      "from": 79.73,
      "to": 82.36,
      "sid": 44,
      "location": 2,
      "content": "这可能是我见过绿化最好的加油站了",
      "music": 0.0
    },
    {
      "from": 82.36,
      "to": 83.48,
      "sid": 45,
      "location": 2,
      "content": "透过后面的树丛",
      "music": 0.0
    },
    {
      "from": 83.48,
      "to": 85.26,
      "sid": 46,
      "location": 2,
      "content": "我还可以看到一栋大宅子",
      "music": 0.0
    },
    {
      "from": 85.26,
      "to": 86.9,
      "sid": 47,
      "location": 2,
      "content": "这边水的价格还可以",
      "music": 0.0
    },
    {
      "from": 86.9,
      "to": 87.86,
      "sid": 48,
      "location": 2,
      "content": "两美元一瓶",
      "music": 0.0
    },
    {
      "from": 87.86,
      "to": 90.31,
      "sid": 49,
      "location": 2,
      "content": "但是油价比同地区的要高很多",
      "music": 0.0
    },
    {
      "from": 90.31,
      "to": 91.57,
      "sid": 50,
      "location": 2,
      "content": "4.58美元",
      "music": 0.0
    },
    {
      "from": 91.57,
      "to": 94.77,
      "sid": 51,
      "location": 2,
      "content": "可能是富人也不在意这么几毛钱一加仑的差异",
      "music": 0.0
    },
    {
      "from": 94.77,
      "to": 97.51,
      "sid": 52,
      "location": 2,
      "content": "这个地方马路对面有一个高尔夫球俱乐部",
      "music": 0.0
    },
    {
      "from": 97.51,
      "to": 99.57,
      "sid": 53,
      "location": 2,
      "content": "我去的时候是工作日的清晨",
      "music": 0.0
    },
    {
      "from": 99.57,
      "to": 101.95,
      "sid": 54,
      "location": 2,
      "content": "所以说根本没有人给大家看一看",
      "music": 0.0
    },
    {
      "from": 101.95,
      "to": 102.71,
      "sid": 55,
      "location": 2,
      "content": "比尔盖茨",
      "music": 0.0
    },
    {
      "from": 102.71,
      "to": 103.41,
      "sid": 56,
      "location": 2,
      "content": "鲍尔默",
      "music": 0.0
    },
    {
      "from": 103.41,
      "to": 105.63,
      "sid": 57,
      "location": 2,
      "content": "以及很多西雅图的科技大佬都会来的",
      "music": 0.0
    },
    {
      "from": 105.63,
      "to": 106.919,
      "sid": 58,
      "location": 2,
      "content": "高尔夫球俱乐部",
      "music": 0.0
    },
    {
      "from": 106.919,
      "to": 108.319,
      "sid": 59,
      "location": 2,
      "content": "一般来说这么大的球场",
      "music": 0.0
    },
    {
      "from": 108.319,
      "to": 109.819,
      "sid": 60,
      "location": 2,
      "content": "想捡一个球的难度不大",
      "music": 0.0
    },
    {
      "from": 109.819,
      "to": 112.439,
      "sid": 61,
      "location": 2,
      "content": "我也稍微在这边娱乐了一下",
      "music": 0.0
    },
    {
      "from": 118.8,
      "to": 120.82,
      "sid": 62,
      "location": 2,
      "content": "我去查了一下",
      "music": 0.0
    },
    {
      "from": 120.82,
      "to": 122.8,
      "sid": 63,
      "location": 2,
      "content": "如果从正门进这个俱乐部的话",
      "music": 0.0
    },
    {
      "from": 122.8,
      "to": 124.74,
      "sid": 64,
      "location": 2,
      "content": "一年的会费是10万美元",
      "music": 0.0
    },
    {
      "from": 124.74,
      "to": 125.9,
      "sid": 65,
      "location": 2,
      "content": "这个高尔夫球场",
      "music": 0.0
    },
    {
      "from": 125.9,
      "to": 128.48,
      "sid": 66,
      "location": 2,
      "content": "后面就是一个教会和私立的教会学校",
      "music": 0.0
    },
    {
      "from": 128.48,
      "to": 129.26,
      "sid": 67,
      "location": 2,
      "content": "我查了一下",
      "music": 0.0
    },
    {
      "from": 129.26,
      "to": 131.23,
      "sid": 68,
      "location": 2,
      "content": "这个学校的师生比是六比一",
      "music": 0.0
    },
    {
      "from": 131.23,
      "to": 133.45,
      "sid": 69,
      "location": 2,
      "content": "学费一年是3万6000美元",
      "music": 0.0
    },
    {
      "from": 133.45,
      "to": 134.83,
      "sid": 70,
      "location": 2,
      "content": "这比一些比较便宜的",
      "music": 0.0
    },
    {
      "from": 134.83,
      "to": 136.95,
      "sid": 71,
      "location": 2,
      "content": "美国州立大学的学费都要高了",
      "music": 0.0
    },
    {
      "from": 136.95,
      "to": 138.83,
      "sid": 72,
      "location": 2,
      "content": "私立学校的对面就是梅迪纳",
      "music": 0.0
    },
    {
      "from": 138.83,
      "to": 140.645,
      "sid": 73,
      "location": 2,
      "content": "真正的公共公园",
      "music": 0.0
    },
    {
      "from": 150.3,
      "to": 153.42,
      "sid": 74,
      "location": 2,
      "content": "我感觉这边维护的还是挺不错啊",
      "music": 0.0
    },
    {
      "from": 153.42,
      "to": 154.54,
      "sid": 75,
      "location": 2,
      "content": "我当天路过的时候",
      "music": 0.0
    },
    {
      "from": 154.54,
      "to": 157.16,
      "sid": 76,
      "location": 2,
      "content": "就看了好几个园艺师在那边捡树枝",
      "music": 0.0
    },
    {
      "from": 157.16,
      "to": 158.7,
      "sid": 77,
      "location": 2,
      "content": "这边还有遛狗的步道",
      "music": 0.0
    },
    {
      "from": 158.7,
      "to": 159.92,
      "sid": 78,
      "location": 2,
      "content": "网球场什么的",
      "music": 0.0
    },
    {
      "from": 159.92,
      "to": 160.8,
      "sid": 79,
      "location": 2,
      "content": "出乎意料的是",
      "music": 0.0
    },
    {
      "from": 160.8,
      "to": 162.67,
      "sid": 80,
      "location": 2,
      "content": "我还见到了好多个中国老人",
      "music": 0.0
    },
    {
      "from": 162.67,
      "to": 164.39,
      "sid": 81,
      "location": 2,
      "content": "都是家里孩子在附近工作",
      "music": 0.0
    },
    {
      "from": 164.39,
      "to": 165.65,
      "sid": 82,
      "location": 2,
      "content": "把他们接过来的",
      "music": 0.0
    },
    {
      "from": 165.65,
      "to": 168.85,
      "sid": 83,
      "location": 2,
      "content": "每天他们就在这个公园一个凉亭附近锻炼",
      "music": 0.0
    },
    {
      "from": 168.85,
      "to": 169.57,
      "sid": 84,
      "location": 2,
      "content": "站立",
      "music": 0.0
    },
    {
      "from": 170.65,
      "to": 174.24,
      "sid": 85,
      "location": 2,
      "content": "目光内海神不忘区域",
      "music": 0.0
    },
    {
      "from": 174.24,
      "to": 177.12,
      "sid": 86,
      "location": 2,
      "content": "我跟这些老人刚见面搭话的时候",
      "music": 0.0
    },
    {
      "from": 177.12,
      "to": 179.149,
      "sid": 87,
      "location": 2,
      "content": "他们还问我是不是来看房子的",
      "music": 0.0
    },
    {
      "from": 179.149,
      "to": 180.849,
      "sid": 88,
      "location": 2,
      "content": "他们还是太看得起我了",
      "music": 0.0
    },
    {
      "from": 180.849,
      "to": 181.869,
      "sid": 89,
      "location": 2,
      "content": "不过话说回来",
      "music": 0.0
    },
    {
      "from": 181.869,
      "to": 184.37,
      "sid": 90,
      "location": 2,
      "content": "梅迪纳之边27%的人都是亚裔",
      "music": 0.0
    },
    {
      "from": 184.37,
      "to": 186.43,
      "sid": 91,
      "location": 2,
      "content": "估计其中有不少都是中国人",
      "music": 0.0
    },
    {
      "from": 186.43,
      "to": 187.45,
      "sid": 92,
      "location": 2,
      "content": "公园再往南走",
      "music": 0.0
    },
    {
      "from": 187.45,
      "to": 188.91,
      "sid": 93,
      "location": 2,
      "content": "就是这边的公立小学",
      "music": 0.0
    },
    {
      "from": 188.91,
      "to": 191.31,
      "sid": 94,
      "location": 2,
      "content": "他们这边好像正在上体育课什么的",
      "music": 0.0
    },
    {
      "from": 191.31,
      "to": 193.27,
      "sid": 95,
      "location": 2,
      "content": "我看不少都是中国人的面孔",
      "music": 0.0
    },
    {
      "from": 193.27,
      "to": 196.15,
      "sid": 96,
      "location": 2,
      "content": "其实到现在我去的也都是梅迪纳这个社区里面",
      "music": 0.0
    },
    {
      "from": 196.15,
      "to": 197.37,
      "sid": 97,
      "location": 2,
      "content": "比较平民的地方",
      "music": 0.0
    },
    {
      "from": 197.37,
      "to": 199.899,
      "sid": 98,
      "location": 2,
      "content": "因为这些地方还都是在内陆地区",
      "music": 0.0
    },
    {
      "from": 199.899,
      "to": 201.319,
      "sid": 99,
      "location": 2,
      "content": "一是看不到海景",
      "music": 0.0
    },
    {
      "from": 201.319,
      "to": 202.959,
      "sid": 100,
      "location": 2,
      "content": "二是隐蔽性比较差",
      "music": 0.0
    },
    {
      "from": 202.959,
      "to": 205.179,
      "sid": 101,
      "location": 2,
      "content": "像我这些路过的人都可以拍得到的",
      "music": 0.0
    },
    {
      "from": 205.179,
      "to": 207.05,
      "sid": 102,
      "location": 2,
      "content": "只能算是百万级的房子",
      "music": 0.0
    },
    {
      "from": 207.05,
      "to": 209.71,
      "sid": 103,
      "location": 2,
      "content": "而千万级的豪宅都是可以直接看得到海",
      "music": 0.0
    },
    {
      "from": 209.71,
      "to": 211.35,
      "sid": 104,
      "location": 2,
      "content": "且不跟马路直接连着的",
      "music": 0.0
    },
    {
      "from": 211.35,
      "to": 213.149,
      "sid": 105,
      "location": 2,
      "content": "这种都是有专属的车道",
      "music": 0.0
    },
    {
      "from": 213.149,
      "to": 214.869,
      "sid": 106,
      "location": 2,
      "content": "隐私性如果做的强的话",
      "music": 0.0
    },
    {
      "from": 214.869,
      "to": 217.609,
      "sid": 107,
      "location": 2,
