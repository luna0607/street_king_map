  "body": [
    {
      "from": 0.04,
      "to": 1.1,
      "sid": 1,
      "location": 2,
      "content": "一夜的暴风雪后",
      "music": 0.0
    },
    {
      "from": 1.1,
      "to": 3.84,
      "sid": 2,
      "location": 2,
      "content": "我来到了美国大平原上的765人小村庄",
      "music": 0.0
    },
    {
      "from": 3.84,
      "to": 4.9,
      "sid": 3,
      "location": 2,
      "content": "阿尔姆伍德",
      "music": 0.0
    },
    {
      "from": 4.9,
      "to": 6.78,
      "sid": 4,
      "location": 2,
      "content": "这片人口构成是98%",
      "music": 0.0
    },
    {
      "from": 6.78,
      "to": 7.82,
      "sid": 5,
      "location": 2,
      "content": "白人1%",
      "music": 0.0
    },
    {
      "from": 7.82,
      "to": 9.78,
      "sid": 6,
      "location": 2,
      "content": "原住民1%混合种族",
      "music": 0.0
    },
    {
      "from": 9.78,
      "to": 11.96,
      "sid": 7,
      "location": 2,
      "content": "阿尔姆伍德是一个农业小村",
      "music": 0.0
    },
    {
      "from": 11.96,
      "to": 13.22,
      "sid": 8,
      "location": 2,
      "content": "方圆25km内",
      "music": 0.0
    },
    {
      "from": 13.22,
      "to": 14.6,
      "sid": 9,
      "location": 2,
      "content": "除了玉米地和大豆田",
      "music": 0.0
    },
    {
      "from": 14.6,
      "to": 15.42,
      "sid": 10,
      "location": 2,
      "content": "什么都没有",
      "music": 0.0
    },
    {
      "from": 15.42,
      "to": 18.17,
      "sid": 11,
      "location": 2,
      "content": "今天的户外温度差不多是零下11度",
      "music": 0.0
    },
    {
      "from": 18.17,
      "to": 20.01,
      "sid": 12,
      "location": 2,
      "content": "小村的主街上基本没有人",
      "music": 0.0
    },
    {
      "from": 20.01,
      "to": 22.1,
      "sid": 13,
      "location": 2,
      "content": "这条路上面空置的房子也不少",
      "music": 0.0
    },
    {
      "from": 22.1,
      "to": 23.52,
      "sid": 14,
      "location": 2,
      "content": "再加上雪后的周六",
      "music": 0.0
    },
    {
      "from": 23.52,
      "to": 25.2,
      "sid": 15,
      "location": 2,
      "content": "大部分商家也都歇业了",
      "music": 0.0
    },
    {
      "from": 25.2,
      "to": 27.44,
      "sid": 16,
      "location": 2,
      "content": "要不是前面这个棕色小房子的窗上",
      "music": 0.0
    },
    {
      "from": 27.44,
      "to": 28.68,
      "sid": 17,
      "location": 2,
      "content": "贴了一张小小的便签",
      "music": 0.0
    },
    {
      "from": 28.68,
      "to": 29.84,
      "sid": 18,
      "location": 2,
      "content": "携带有一元的甩卖",
      "music": 0.0
    },
    {
      "from": 29.84,
      "to": 31.44,
      "sid": 19,
      "location": 2,
      "content": "我还以为他们也倒闭了呢",
      "music": 0.0
    },
    {
      "from": 31.44,
      "to": 33.98,
      "sid": 20,
      "location": 2,
      "content": "开门进去发现是一家二手慈善商店",
      "music": 0.0
    },
    {
      "from": 33.98,
      "to": 36.32,
      "sid": 21,
      "location": 2,
      "content": "没想到里面杂七杂八的东西挺多的",
      "music": 0.0
    },
    {
      "from": 36.32,
      "to": 37.92,
      "sid": 22,
      "location": 2,
      "content": "而且价格还挺便宜的",
      "music": 0.0
    },
    {
      "from": 37.92,
      "to": 39.72,
      "sid": 23,
      "location": 2,
      "content": "有很多十美元以内的衣服",
      "music": 0.0
    },
    {
      "from": 39.72,
      "to": 41.24,
      "sid": 24,
      "location": 2,
      "content": "而很多书籍桌游",
      "music": 0.0
    },
    {
      "from": 41.24,
      "to": 42.02,
      "sid": 25,
      "location": 2,
      "content": "还有小物件",
      "music": 0.0
    },
    {
      "from": 42.02,
      "to": 43.269,
      "sid": 26,
      "location": 2,
      "content": "真的只要一块钱",
      "music": 0.0
    },
    {
      "from": 43.269,
      "to": 44.989,
      "sid": 27,
      "location": 2,
      "content": "虽然说我只象征性的买了一个",
      "music": 0.0
    },
    {
      "from": 44.989,
      "to": 46.669,
      "sid": 28,
      "location": 2,
      "content": "99美分的芝麻街玩偶",
      "music": 0.0
    },
    {
      "from": 46.669,
      "to": 48.769,
      "sid": 29,
      "location": 2,
      "content": "店员老奶奶依旧对我非常热情",
      "music": 0.0
    },
    {
      "from": 48.769,
      "to": 51.589,
      "sid": 30,
      "location": 2,
      "content": "一是在这个98%都是白人的小村子里",
      "music": 0.0
    },
    {
      "from": 51.589,
      "to": 53.03,
      "sid": 31,
      "location": 2,
      "content": "我一看就不是本地人",
      "music": 0.0
    },
    {
      "from": 53.03,
      "to": 55.13,
      "sid": 32,
      "location": 2,
      "content": "美国中西部的人还是比较热情的",
      "music": 0.0
    },
    {
      "from": 55.13,
      "to": 57.92,
      "sid": 33,
      "location": 2,
      "content": "二是这个小店本身就是一个非营利组织",
      "music": 0.0
    },
    {
      "from": 57.92,
      "to": 60.3,
      "sid": 34,
      "location": 2,
      "content": "大部分卖的物品都是村民捐赠的",
      "music": 0.0
    },
    {
      "from": 60.3,
      "to": 63.48,
      "sid": 35,
      "location": 2,
      "content": "这个小店的历史可以追溯到1994年那年",
      "music": 0.0
    },
    {
      "from": 63.48,
      "to": 66.04,
      "sid": 36,
      "location": 2,
      "content": "2月一场大火烧毁了小村的主教堂",
      "music": 0.0
    },
    {
      "from": 66.04,
      "to": 67.12,
      "sid": 37,
      "location": 2,
      "content": "很多人联合起来",
      "music": 0.0
    },
    {
      "from": 67.12,
      "to": 69.72,
      "sid": 38,
      "location": 2,
      "content": "租下了一栋主街上面的65平方小房子",
      "music": 0.0
    },
    {
      "from": 69.72,
      "to": 70.789,
      "sid": 39,
      "location": 2,
      "content": "做二手市场",
      "music": 0.0
    },
    {
      "from": 70.789,
      "to": 72.949,
      "sid": 40,
      "location": 2,
      "content": "大家的捐赠和购买意愿都很强",
      "music": 0.0
    },
    {
      "from": 72.949,
      "to": 74.589,
      "sid": 41,
      "location": 2,
      "content": "很快就筹够了资金",
      "music": 0.0
    },
    {
      "from": 74.589,
      "to": 76.029,
      "sid": 42,
      "location": 2,
      "content": "虽然说目标达成了",
      "music": 0.0
    },
    {
      "from": 76.029,
      "to": 78.37,
      "sid": 43,
      "location": 2,
      "content": "但是村民们也很喜欢这个二手商店",
      "music": 0.0
    },
    {
      "from": 78.37,
      "to": 80.37,
      "sid": 44,
      "location": 2,
      "content": "于是他就一直经营到了今天",
      "music": 0.0
    },
    {
      "from": 80.37,
      "to": 82.29,
      "sid": 45,
      "location": 2,
      "content": "如今这个店的面积已经扩大到了",
      "music": 0.0
    },
    {
      "from": 82.29,
      "to": 83.59,
      "sid": 46,
      "location": 2,
      "content": "278平方米",
      "music": 0.0
    },
    {
      "from": 83.59,
      "to": 85.35,
      "sid": 47,
      "location": 2,
      "content": "它经营的宗旨有两个",
      "music": 0.0
    },
    {
      "from": 85.35,
      "to": 86.67,
      "sid": 48,
      "location": 2,
      "content": "一是为了废物利用",
      "music": 0.0
    },
    {
      "from": 86.67,
      "to": 88.83,
      "sid": 49,
      "location": 2,
      "content": "并给大家一个淘便宜货的选择",
      "music": 0.0
    },
    {
      "from": 88.83,
      "to": 91.43,
      "sid": 50,
      "location": 2,
      "content": "二是为了教会以及村里各种各样的组织",
      "music": 0.0
    },
    {
      "from": 91.43,
      "to": 92.949,
      "sid": 51,
      "location": 2,
      "content": "筹集活动基金",
      "music": 0.0
    },
    {
      "from": 92.949,
      "to": 95.709,
      "sid": 52,
      "location": 2,
      "content": "比起二手商店阿姆伍德村民更自豪的是",
      "music": 0.0
    },
    {
      "from": 95.709,
      "to": 97.429,
      "sid": 53,
      "location": 2,
      "content": "他们这里出了一个很有名的作家",
      "music": 0.0
    },
    {
      "from": 97.429,
      "to": 98.07,
      "sid": 54,
      "location": 2,
      "content": "Bs",
      "music": 0.0
    },
    {
      "from": 98.07,
      "to": 100.43,
      "sid": 55,
      "location": 2,
      "content": "像是主街上面的壁画和村公园的牌子",
      "music": 0.0
    },
    {
      "from": 100.43,
      "to": 103.43,
      "sid": 56,
      "location": 2,
      "content": "上面都写着阿尔姆伍德best的故乡",
      "music": 0.0
    },
    {
      "from": 103.43,
      "to": 104.79,
      "sid": 57,
      "location": 2,
      "content": "best s在美国很有名",
      "music": 0.0
    },
    {
      "from": 104.79,
      "to": 106.87,
      "sid": 58,
      "location": 2,
      "content": "但是在中文互联网上资料很少",
      "music": 0.0
    },
    {
      "from": 106.87,
      "to": 108.47,
      "sid": 59,
      "location": 2,
      "content": "其实我的文化水平也不高",
      "music": 0.0
    },
    {
      "from": 108.47,
      "to": 109.35,
      "sid": 60,
      "location": 2,
      "content": "要不是来这里",
      "music": 0.0
    },
    {
      "from": 109.35,
      "to": 110.9,
      "sid": 61,
      "location": 2,
      "content": "我也没有听说过他",
      "music": 0.0
    },
    {
      "from": 110.9,
      "to": 111.98,
      "sid": 62,
      "location": 2,
      "content": "苦思冥想很久",
      "music": 0.0
    },
    {
      "from": 111.98,
      "to": 114.2,
      "sid": 63,
      "location": 2,
      "content": "也不知道怎么给大家介绍这个作家",
      "music": 0.0
    },
    {
      "from": 114.2,
      "to": 116.949,
      "sid": 64,
      "location": 2,
      "content": "于是我只能求助我查资料的好伙伴",
      "music": 0.0
    },
    {
      "from": 116.949,
      "to": 118.289,
      "sid": 65,
      "location": 2,
      "content": "小霸王AI",
      "music": 0.0
    },
    {
      "from": 118.289,
      "to": 120.949,
      "sid": 66,
      "location": 2,
      "content": "我觉得他这个上面形容的还是挺准确的",
      "music": 0.0
    },
    {
      "from": 120.949,
      "to": 122.429,
      "sid": 67,
      "location": 2,
      "content": "在此之外补充一下",
      "music": 0.0
    },
    {
      "from": 122.429,
      "to": 123.509,
      "sid": 68,
      "location": 2,
      "content": "BETH在世的时候",
      "music": 0.0
    },
    {
      "from": 123.509,
      "to": 125.729,
      "sid": 69,
      "location": 2,
      "content": "曾经是全美收入最高的女作家",
      "music": 0.0
    },
    {
      "from": 125.729,
      "to": 126.729,
      "sid": 70,
      "location": 2,
      "content": "而他成名后",
      "music": 0.0
    },
    {
      "from": 126.729,
      "to": 129.389,
      "sid": 71,
      "location": 2,
      "content": "依旧选择留在阿尔姆伍德这个小村生活",
      "music": 0.0
    },
    {
      "from": 129.389,
      "to": 132.829,
      "sid": 72,
      "location": 2,
      "content": "而best s的旧居就在这个公园洗手间的斜对面",
      "music": 0.0
    },
    {
      "from": 132.829,
      "to": 135.069,
      "sid": 73,
      "location": 2,
      "content": "这个故居只有周末的下午开门",
      "music": 0.0
    },
    {
      "from": 135.069,
      "to": 136.069,
      "sid": 74,
      "location": 2,
      "content": "接待我的是一个",
      "music": 0.0
    },
    {
      "from": 136.069,
      "to": 138.19,
      "sid": 75,
      "location": 2,
      "content": "在这里做了18年向导的老奶奶",
      "music": 0.0
    },
    {
      "from": 138.19,
      "to": 139.29,
      "sid": 76,
      "location": 2,
      "content": "还有他们的馆长",
      "music": 0.0
    },
    {
      "from": 139.29,
      "to": 142.21,
      "sid": 77,
      "location": 2,
      "content": "曾经在小村教了30多年书的退休老教师",
      "music": 0.0
    },
    {
      "from": 142.21,
      "to": 142.91,
      "sid": 78,
      "location": 2,
      "content": "Came from iowa",
      "music": 0.0
    },
    {
      "from": 142.91,
      "to": 145.88,
      "sid": 79,
      "location": 2,
      "content": "Originally and better her husband wanted to on a bank somewhere",
      "music": 0.0
    },
    {
      "from": 145.88,
      "to": 147.34,
      "sid": 80,
      "location": 2,
      "content": "Or so she followed a lot",
      "music": 0.0
    },
    {
      "from": 147.34,
      "to": 148.46,
      "sid": 81,
      "location": 2,
      "content": "She wasn't very exciting",
      "music": 0.0
    },
    {
      "from": 148.46,
      "to": 152.22,
      "sid": 82,
      "location": 2,
      "content": "Because what for her memories of nebraska was meant that she",
      "music": 0.0
    },
    {
      "from": 152.22,
      "to": 152.96,
      "sid": 83,
      "location": 2,
      "content": "And her mother would",
      "music": 0.0
    },
    {
      "from": 152.96,
      "to": 155.18,
      "sid": 84,
      "location": 2,
      "content": "Dry apples and take old clothes and mend them",
      "music": 0.0
    },
    {
      "from": 155.18,
      "to": 157.04,
      "sid": 85,
      "location": 2,
      "content": "And send them to those poor people in nebraska",
      "music": 0.0
    },
    {
      "from": 157.04,
      "to": 157.84,
      "sid": 86,
      "location": 2,
      "content": "So she wasn't thinking",
      "music": 0.0
    },
    {
      "from": 157.84,
      "to": 160.64,
      "sid": 87,
      "location": 2,
      "content": "She was getting into a very good situation and in fact when she arrived",
      "music": 0.0
    },
    {
      "from": 160.64,
      "to": 161.6,
      "sid": 88,
      "location": 2,
      "content": "It was during a dust storm",
      "music": 0.0
    },
    {
      "from": 161.6,
      "to": 163.4,
      "sid": 89,
      "location": 2,
      "content": "It is not like a dust storm that we think of today",
      "music": 0.0
    },
    {
      "from": 163.4,
      "to": 165.39,
      "sid": 90,
      "location": 2,
      "content": "I mean she couldn't see across the street",
      "music": 0.0
    },
    {
      "from": 165.39,
      "to": 168.12,
      "sid": 91,
      "location": 2,
      "content": "And so um she was thinking this isn't going very well",
      "music": 0.0
    },
    {
      "from": 168.12,
      "to": 169.0,
      "sid": 92,
      "location": 2,
      "content": "And they drove up to the house",
      "music": 0.0
    },
    {
      "from": 169.0,
      "to": 169.68,
      "sid": 93,
      "location": 2,
      "content": "That they were trent",
      "music": 0.0
    },
    {
      "from": 169.68,
      "to": 171.16,
      "sid": 94,
      "location": 2,
      "content": "And her favorite rocker was on the front porch",
      "music": 0.0
    },
    {
      "from": 171.16,
      "to": 172.0,
      "sid": 95,
      "location": 2,
      "content": "And it was broken",
      "music": 0.0
    },
    {
      "from": 172.0,
      "to": 173.12,
      "sid": 96,
      "location": 2,
      "content": "So this isn't gonna build",
      "music": 0.0
    },
    {
      "from": 173.12,
      "to": 173.52,
      "sid": 97,
      "location": 2,
      "content": "Very well",
      "music": 0.0
    },
    {
      "from": 173.52,
      "to": 174.87,
      "sid": 98,
      "location": 2,
      "content": "So she walked inside though",
      "music": 0.0
    },
    {
      "from": 174.87,
      "to": 177.07,
      "sid": 99,
      "location": 2,
      "content": "And the neighbor lady had unpacked all of her dishes",
      "music": 0.0
    },
    {
      "from": 177.07,
      "to": 178.09,
      "sid": 100,
      "location": 2,
      "content": "And had cooked her her meal",
      "music": 0.0
    },
    {
      "from": 178.09,
      "to": 179.95,
      "sid": 101,
      "location": 2,
      "content": "And she said that was the type of hospitality",
      "music": 0.0
    },
    {
      "from": 179.95,
      "to": 181.09,
      "sid": 102,
      "location": 2,
      "content": "She experienced in this town",
      "music": 0.0
    },
    {
      "from": 181.09,
      "to": 182.13,
      "sid": 103,
      "location": 2,
      "content": "Every day of her life is",
      "music": 0.0
    },
    {
      "from": 182.13,
      "to": 184.17,
      "sid": 104,
      "location": 2,
      "content": "So that's why even after her husband died her",
      "music": 0.0
    },
    {
      "from": 184.17,
      "to": 185.49,
      "sid": 105,
      "location": 2,
      "content": "Publishers said come to the coast",
      "music": 0.0
    },
    {
      "from": 185.49,
      "to": 186.71,
      "sid": 106,
      "location": 2,
      "content": "We want to work with you on the coast",
      "music": 0.0
    },
    {
      "from": 186.71,
      "to": 187.73,
      "sid": 107,
      "location": 2,
      "content": "But she stayed right here",
      "music": 0.0
    },
    {
      "from": 187.73,
      "to": 189.31,
      "sid": 108,
      "location": 2,
      "content": "Because the people of this town",
      "music": 0.0
    },
    {
      "from": 189.31,
      "to": 191.67,
      "sid": 109,
      "location": 2,
      "content": "Were her essentially her extended family for her children",
      "music": 0.0
    },
    {
      "from": 191.67,
      "to": 193.41,
      "sid": 110,
      "location": 2,
      "content": "Who were still sixteen to four",
      "music": 0.0
