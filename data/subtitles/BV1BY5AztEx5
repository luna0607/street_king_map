  "body": [
    {
      "from": 0.0,
      "to": 2.52,
      "sid": 1,
      "location": 2,
      "content": "今天我来到了美国最穷的州密西西比乡下",
      "music": 0.0
    },
    {
      "from": 2.52,
      "to": 4.0,
      "sid": 2,
      "location": 2,
      "content": "一个94.56%",
      "music": 0.0
    },
    {
      "from": 4.0,
      "to": 5.56,
      "sid": 3,
      "location": 2,
      "content": "都是黑人的2000人小镇",
      "music": 0.0
    },
    {
      "from": 5.56,
      "to": 6.64,
      "sid": 4,
      "location": 2,
      "content": "谢尔比小智",
      "music": 0.0
    },
    {
      "from": 6.64,
      "to": 9.62,
      "sid": 5,
      "location": 2,
      "content": "这条半废弃主街上面大部分的店铺都空置了",
      "music": 0.0
    },
    {
      "from": 9.62,
      "to": 10.88,
      "sid": 6,
      "location": 2,
      "content": "除了开在街角的一家",
      "music": 0.0
    },
    {
      "from": 10.88,
      "to": 13.1,
      "sid": 7,
      "location": 2,
      "content": "已经有百年历史的中国杂货店",
      "music": 0.0
    },
    {
      "from": 13.1,
      "to": 15.42,
      "sid": 8,
      "location": 2,
      "content": "西雅比周边的密西西比河三角洲地区",
      "music": 0.0
    },
    {
      "from": 15.42,
      "to": 17.59,
      "sid": 9,
      "location": 2,
      "content": "曾经是美国最重要的棉花产地",
      "music": 0.0
    },
    {
      "from": 17.59,
      "to": 18.63,
      "sid": 10,
      "location": 2,
      "content": "南北战争之后",
      "music": 0.0
    },
    {
      "from": 18.63,
      "to": 19.75,
      "sid": 11,
      "location": 2,
      "content": "黑人获得了自由",
      "music": 0.0
    },
    {
      "from": 19.75,
      "to": 22.33,
      "sid": 12,
      "location": 2,
      "content": "很多白人农场主为了寻求更便宜的劳工",
      "music": 0.0
    },
    {
      "from": 22.33,
      "to": 24.9,
      "sid": 13,
      "location": 2,
      "content": "从广东的4亿地区引入了不少中国人",
      "music": 0.0
    },
    {
      "from": 24.9,
      "to": 25.92,
      "sid": 14,
      "location": 2,
      "content": "来这一块种地",
      "music": 0.0
    },
    {
      "from": 25.92,
      "to": 29.25,
      "sid": 15,
      "location": 2,
      "content": "但聪慧的华人们反倒很快在这块做起了生意",
      "music": 0.0
    },
    {
      "from": 29.25,
      "to": 30.13,
      "sid": 16,
      "location": 2,
      "content": "在20世纪",
      "music": 0.0
    },
    {
      "from": 30.13,
      "to": 32.21,
      "sid": 17,
      "location": 2,
      "content": "基本上这片地区所有的黑人小镇上",
      "music": 0.0
    },
    {
      "from": 32.21,
      "to": 34.27,
      "sid": 18,
      "location": 2,
      "content": "都会有一家华人开的小杂货店",
      "music": 0.0
    },
    {
      "from": 34.27,
      "to": 36.11,
      "sid": 19,
      "location": 2,
      "content": "但随着这块农村地区的衰落",
      "music": 0.0
    },
    {
      "from": 36.11,
      "to": 37.61,
      "sid": 20,
      "location": 2,
      "content": "就业机会也越来越少",
      "music": 0.0
    },
    {
      "from": 37.61,
      "to": 39.93,
      "sid": 21,
      "location": 2,
      "content": "最早一批老广东华人退休了之后",
      "music": 0.0
    },
    {
      "from": 39.93,
      "to": 41.57,
      "sid": 22,
      "location": 2,
      "content": "他们的后代纷纷离开了这里",
      "music": 0.0
    },
    {
      "from": 41.57,
      "to": 43.47,
      "sid": 23,
      "location": 2,
      "content": "到城市里寻找更好的生活",
      "music": 0.0
    },
    {
      "from": 43.47,
      "to": 45.79,
      "sid": 24,
      "location": 2,
      "content": "这家在谢尔比的詹姆斯品质市场",
      "music": 0.0
    },
    {
      "from": 45.79,
      "to": 48.16,
      "sid": 25,
      "location": 2,
      "content": "算是为数不多仅存的华人超市了",
      "music": 0.0
    },
    {
      "from": 48.16,
      "to": 50.24,
      "sid": 26,
      "location": 2,
      "content": "2004年老的老板退休的时候",
      "music": 0.0
    },
    {
      "from": 50.24,
      "to": 52.19,
      "sid": 27,
      "location": 2,
      "content": "就有一对福建夫妻经营",
      "music": 0.0
    },
    {
      "from": 52.19,
      "to": 54.99,
      "sid": 28,
      "location": 2,
      "content": "我这里在这个探联算中心都有人",
      "music": 0.0
    },
    {
      "from": 54.99,
      "to": 56.87,
      "sid": 29,
      "location": 2,
      "content": "一直就是比较税嘛",
      "music": 0.0
    },
    {
      "from": 56.87,
      "to": 58.27,
      "sid": 30,
      "location": 2,
      "content": "都是几块钱几块钱",
      "music": 0.0
    },
    {
      "from": 58.27,
      "to": 59.88,
      "sid": 31,
      "location": 2,
      "content": "有人进来买伊利的糖",
      "music": 0.0
    },
    {
      "from": 59.88,
      "to": 61.58,
      "sid": 32,
      "location": 2,
      "content": "有人买买饮料啊",
      "music": 0.0
    },
    {
      "from": 61.58,
      "to": 63.17,
      "sid": 33,
      "location": 2,
      "content": "这里主要比较方便嗯",
      "music": 0.0
    },
    {
      "from": 63.17,
      "to": 66.39,
      "sid": 34,
      "location": 2,
      "content": "为什么你看邮电局银行都在这对面",
      "music": 0.0
    },
    {
      "from": 66.39,
      "to": 67.63,
      "sid": 35,
      "location": 2,
      "content": "老四家是警察",
      "music": 0.0
    },
    {
      "from": 67.63,
      "to": 69.13,
      "sid": 36,
      "location": 2,
      "content": "警局火烧了",
      "music": 0.0
    },
    {
      "from": 69.13,
      "to": 69.95,
      "sid": 37,
      "location": 2,
      "content": "被烧了",
      "music": 0.0
    },
    {
      "from": 69.95,
      "to": 74.06,
      "sid": 38,
      "location": 2,
      "content": "然后现在这个整栋办公楼当关掉了关掉",
      "music": 0.0
    },
    {
      "from": 74.06,
      "to": 76.94,
      "sid": 39,
      "location": 2,
      "content": "然后警察局搬到这个图书馆里面去了",
      "music": 0.0
    },
    {
      "from": 76.94,
      "to": 78.82,
      "sid": 40,
      "location": 2,
      "content": "这个郑州西也就是你们家开",
      "music": 0.0
    },
    {
      "from": 78.82,
      "to": 80.51,
      "sid": 41,
      "location": 2,
      "content": "其他都都开了呃",
      "music": 0.0
    },
    {
      "from": 80.51,
      "to": 82.35,
      "sid": 42,
      "location": 2,
      "content": "店很多都瓜得了很多的",
      "music": 0.0
    },
    {
      "from": 82.35,
      "to": 84.97,
      "sid": 43,
      "location": 2,
      "content": "我觉得这些老黑都挺挺善良",
      "music": 0.0
    },
    {
      "from": 84.97,
      "to": 88.07,
      "sid": 44,
      "location": 2,
      "content": "别的西林里面大城市有没有他比较凶",
