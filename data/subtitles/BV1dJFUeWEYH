  "body": [
    {
      "from": 0.0,
      "to": 0.92,
      "sid": 1,
      "location": 2,
      "content": "今天我来到了美国",
      "music": 0.0
    },
    {
      "from": 0.92,
      "to": 2.96,
      "sid": 2,
      "location": 2,
      "content": "一个黑人占比99.08%",
      "music": 0.0
    },
    {
      "from": 2.96,
      "to": 4.16,
      "sid": 3,
      "location": 2,
      "content": "的1500人小镇",
      "music": 0.0
    },
    {
      "from": 4.16,
      "to": 5.02,
      "sid": 4,
      "location": 2,
      "content": "芒德拜隆",
      "music": 0.0
    },
    {
      "from": 5.02,
      "to": 5.9,
      "sid": 5,
      "location": 2,
      "content": "在1887年",
      "music": 0.0
    },
    {
      "from": 5.9,
      "to": 7.26,
      "sid": 6,
      "location": 2,
      "content": "由获得自由的黑人们",
      "music": 0.0
    },
    {
      "from": 7.26,
      "to": 9.82,
      "sid": 7,
      "location": 2,
      "content": "在原先美国脑南方蓄奴州的核心",
      "music": 0.0
    },
    {
      "from": 9.82,
      "to": 13.27,
      "sid": 8,
      "location": 2,
      "content": "密西西比河三角洲建立了一个黑人自治小镇",
      "music": 0.0
    },
    {
      "from": 13.27,
      "to": 15.59,
      "sid": 9,
      "location": 2,
      "content": "南北战争只能说是结束的奴隶制",
      "music": 0.0
    },
    {
      "from": 15.59,
      "to": 18.4,
      "sid": 10,
      "location": 2,
      "content": "可是那时在种族歧视严重的美国南方",
      "music": 0.0
    },
    {
      "from": 18.4,
      "to": 20.8,
      "sid": 11,
      "location": 2,
      "content": "黑人在以白人主导的社会和经济中",
      "music": 0.0
    },
    {
      "from": 20.8,
      "to": 22.2,
      "sid": 12,
      "location": 2,
      "content": "肯定没有翻身之地",
      "music": 0.0
    },
    {
      "from": 22.2,
      "to": 25.66,
      "sid": 13,
      "location": 2,
      "content": "于是几个前奴隶买下了一些当时未开发的土地",
      "music": 0.0
    },
    {
      "from": 25.66,
      "to": 29.75,
      "sid": 14,
      "location": 2,
      "content": "并尝试建立一个以黑人自主领导的社区小镇",
      "music": 0.0
    },
    {
      "from": 29.75,
      "to": 30.19,
      "sid": 15,
      "location": 2,
      "content": "建立之后",
      "music": 0.0
    },
    {
      "from": 30.19,
      "to": 31.87,
      "sid": 16,
      "location": 2,
      "content": "很快吸引了周边的黑人",
      "music": 0.0
    },
    {
      "from": 31.87,
      "to": 35.43,
      "sid": 17,
      "location": 2,
      "content": "这里也渐渐生长出一套黑人社区的经济模式",
      "music": 0.0
    },
    {
      "from": 35.43,
      "to": 37.27,
      "sid": 18,
      "location": 2,
      "content": "毛多拜龙在巅峰期的时候",
      "music": 0.0
    },
    {
      "from": 37.27,
      "to": 38.45,
      "sid": 19,
      "location": 2,
      "content": "有自己的火车站",
      "music": 0.0
    },
    {
      "from": 38.45,
      "to": 39.59,
      "sid": 20,
      "location": 2,
      "content": "银行工厂",
      "music": 0.0
    },
    {
      "from": 39.59,
      "to": 40.75,
      "sid": 21,
      "location": 2,
      "content": "还有动物园",
      "music": 0.0
    },
    {
      "from": 40.75,
      "to": 44.19,
      "sid": 22,
      "location": 2,
      "content": "小镇周边大部分的土地也都是归黑人所有",
      "music": 0.0
    },
    {
      "from": 44.19,
      "to": 46.37,
      "sid": 23,
      "location": 2,
      "content": "当时由于这边发展的繁荣",
      "music": 0.0
    },
    {
      "from": 46.37,
      "to": 49.61,
      "sid": 24,
      "location": 2,
      "content": "1908年老罗斯福总统还造访过这里",
      "music": 0.0
    },
    {
      "from": 49.61,
      "to": 52.19,
      "sid": 25,
      "location": 2,
      "content": "他称赞这里是三角洲的明珠",
      "music": 0.0
    },
    {
      "from": 52.19,
      "to": 54.63,
      "sid": 26,
      "location": 2,
      "content": "不过小镇的发展也不是顺风顺水",
      "music": 0.0
    },
    {
      "from": 54.63,
      "to": 57.07,
      "sid": 27,
      "location": 2,
      "content": "首先密西西比州一直是保守白人掌权",
      "music": 0.0
    },
    {
      "from": 57.07,
      "to": 58.15,
      "sid": 28,
      "location": 2,
      "content": "直到今日",
      "music": 0.0
    },
    {
      "from": 58.15,
      "to": 61.35,
      "sid": 29,
      "location": 2,
      "content": "这种黑人社区模式肯定是对体制的一种挑战",
      "music": 0.0
    },
    {
      "from": 61.35,
      "to": 63.63,
      "sid": 30,
      "location": 2,
      "content": "那个时候黑人大部分也没有投票权",
      "music": 0.0
    },
    {
      "from": 63.63,
      "to": 66.56,
      "sid": 31,
      "location": 2,
      "content": "这也就导致小镇经常会受到上面的打压",
      "music": 0.0
    },
    {
      "from": 66.56,
      "to": 67.32,
      "sid": 32,
      "location": 2,
      "content": "除此之外",
      "music": 0.0
    },
    {
      "from": 67.32,
      "to": 69.84,
      "sid": 33,
      "location": 2,
      "content": "还有三件大事对小智能历史影响很大",
      "music": 0.0
    },
    {
      "from": 69.84,
      "to": 72.22,
      "sid": 34,
      "location": 2,
      "content": "一是1920年代棉花价格的暴跌",
      "music": 0.0
    },
    {
      "from": 72.22,
      "to": 75.32,
      "sid": 35,
      "location": 2,
      "content": "小镇周边棉花田的黑人农场主损失都很惨重",
      "music": 0.0
    },
    {
      "from": 75.32,
      "to": 77.1,
      "sid": 36,
      "location": 2,
      "content": "很多人被迫都把地卖掉",
      "music": 0.0
    },
    {
      "from": 77.1,
      "to": 78.02,
      "sid": 37,
      "location": 2,
      "content": "1940年",
      "music": 0.0
    },
    {
      "from": 78.02,
      "to": 79.72,
      "sid": 38,
      "location": 2,
      "content": "镇中心遭遇了一场大火",
      "music": 0.0
    },
    {
      "from": 79.72,
      "to": 81.67,
      "sid": 39,
      "location": 2,
      "content": "大部分的商铺都被烧掉了",
      "music": 0.0
    },
    {
      "from": 81.67,
      "to": 82.43,
      "sid": 40,
      "location": 2,
      "content": "讽刺的是",
      "music": 0.0
    },
    {
      "from": 82.43,
      "to": 83.99,
      "sid": 41,
      "location": 2,
      "content": "对小镇打击最大的其实是",
      "music": 0.0
    },
    {
      "from": 83.99,
      "to": 86.19,
      "sid": 42,
      "location": 2,
      "content": "终结了种族隔离的美国民权运动",
      "music": 0.0
    },
    {
      "from": 88.46,
      "to": 90.22,
      "sid": 43,
      "location": 2,
      "content": "整个社会的流动性变大了",
      "music": 0.0
    },
    {
      "from": 90.22,
      "to": 91.82,
      "sid": 44,
      "location": 2,
      "content": "这反倒是打破了毛德拜龙",
      "music": 0.0
    },
    {
      "from": 91.82,
      "to": 93.9,
      "sid": 45,
      "location": 2,
      "content": "自成一体的黑人经济模式",
      "music": 0.0
    },
    {
      "from": 93.9,
      "to": 94.7,
      "sid": 46,
      "location": 2,
      "content": "1980年",
      "music": 0.0
    },
    {
      "from": 94.7,
      "to": 96.9,
      "sid": 47,
      "location": 2,
      "content": "这边人口到达2900人的巅峰期后",
      "music": 0.0
    },
    {
      "from": 96.9,
      "to": 97.86,
      "sid": 48,
      "location": 2,
      "content": "就慢慢减少",
      "music": 0.0
    },
    {
      "from": 97.86,
      "to": 99.729,
      "sid": 49,
      "location": 2,
      "content": "如今就剩下1500人",
      "music": 0.0
    },
    {
      "from": 99.729,
      "to": 101.569,
      "sid": 50,
      "location": 2,
      "content": "如今这里44.5%的人",
      "music": 0.0
    },
    {
      "from": 101.569,
      "to": 102.829,
      "sid": 51,
      "location": 2,
      "content": "都在贫困线以下",
      "music": 0.0
    },
    {
      "from": 102.829,
      "to": 105.449,
      "sid": 52,
      "location": 2,
      "content": "人均年收入收位数是1万5000美元",
      "music": 0.0
    },
    {
      "from": 105.449,
      "to": 107.96,
      "sid": 53,
      "location": 2,
      "content": "不过这个小镇当年繁华的老底子还在",
      "music": 0.0
    },
    {
      "from": 107.96,
      "to": 110.6,
      "sid": 54,
      "location": 2,
      "content": "相比起我之前去的几个同地区的黑人小镇",
      "music": 0.0
    },
    {
      "from": 110.6,
      "to": 112.06,
      "sid": 55,
      "location": 2,
      "content": "看起来要发达不少",
      "music": 0.0
    },
    {
      "from": 112.06,
      "to": 113.95,
      "sid": 56,
      "location": 2,
