      "music": 0.0
    },
    {
      "from": 130.5,
      "to": 131.1,
      "sid": 68,
      "location": 2,
      "content": "进去之后",
      "music": 0.0
    },
    {
      "from": 131.1,
      "to": 134.18,
      "sid": 69,
      "location": 2,
      "content": "我先是看了一个介绍小镇大概情况的纪录片",
      "music": 0.0
    },
    {
      "from": 134.18,
      "to": 136.46,
      "sid": 70,
      "location": 2,
      "content": "在电视上讲话的人是大哥的哥哥",
      "music": 0.0
    },
    {
      "from": 136.46,
