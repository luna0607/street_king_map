  "body": [
    {
      "from": 0.0,
      "to": 1.86,
      "sid": 1,
      "location": 2,
      "content": "I moved here there were signs out",
      "music": 0.0
    },
    {
      "from": 1.86,
      "to": 3.71,
      "sid": 2,
      "location": 2,
      "content": "No backs allow probably",
      "music": 0.0
    },
    {
      "from": 3.71,
      "to": 5.71,
      "sid": 3,
      "location": 2,
      "content": "Not not asians are lowed you",
      "music": 0.0
    },
    {
      "from": 5.71,
      "to": 8.54,
      "sid": 4,
      "location": 2,
      "content": "今天我来到了全佛罗里达最保守的霍尔姆斯县",
      "music": 0.0
    },
    {
      "from": 8.54,
      "to": 9.3,
      "sid": 5,
      "location": 2,
      "content": "2024年",
      "music": 0.0
    },
    {
      "from": 9.3,
      "to": 11.5,
      "sid": 6,
      "location": 2,
      "content": "这里90%的选民都投给了特朗普",
      "music": 0.0
    },
    {
      "from": 11.5,
      "to": 13.66,
      "sid": 7,
      "location": 2,
      "content": "佛罗里达是全美人口第三多的州",
      "music": 0.0
    },
    {
      "from": 13.66,
      "to": 16.6,
      "sid": 8,
      "location": 2,
      "content": "这里也是特朗普私人区所海湖庄园的所在地",
      "music": 0.0
    },
    {
      "from": 16.6,
      "to": 19.38,
      "sid": 9,
      "location": 2,
      "content": "那么这个州最讨厌和支持特朗普的现有区别呢",
      "music": 0.0
    },
    {
      "from": 19.38,
      "to": 21.8,
      "sid": 10,
      "location": 2,
      "content": "现在大家看特朗普的铁票仓霍尔姆斯县",
      "music": 0.0
    },
    {
      "from": 21.8,
      "to": 23.22,
      "sid": 11,
      "location": 2,
      "content": "我对这个县的第一印象就是",
      "music": 0.0
    },
    {
      "from": 23.22,
      "to": 24.52,
      "sid": 12,
      "location": 2,
      "content": "设在森林里面的休息站",
      "music": 0.0
    },
    {
      "from": 24.52,
      "to": 26.68,
      "sid": 13,
      "location": 2,
      "content": "整个霍尔姆斯县的面积有一个香港",
      "music": 0.0
    },
    {
      "from": 26.68,
      "to": 28.08,
      "sid": 14,
      "location": 2,
      "content": "再加上四个澳门那么大",
      "music": 0.0
    },
    {
      "from": 28.08,
      "to": 30.42,
      "sid": 15,
      "location": 2,
      "content": "但是他的人口一共只有1万9000人",
      "music": 0.0
    },
    {
      "from": 30.42,
      "to": 31.52,
      "sid": 16,
      "location": 2,
      "content": "美国东西大动脉",
      "music": 0.0
    },
    {
      "from": 31.52,
      "to": 34.22,
      "sid": 17,
      "location": 2,
      "content": "10号洲际公路穿过霍尔姆斯县的最南端",
      "music": 0.0
    },
    {
      "from": 34.22,
      "to": 37.2,
      "sid": 18,
      "location": 2,
      "content": "而这个县大部分人口都聚集在洲际公路附近",
      "music": 0.0
    },
    {
      "from": 37.2,
      "to": 38.64,
      "sid": 19,
      "location": 2,
      "content": "毕竟高速出口的加油站",
      "music": 0.0
    },
    {
      "from": 38.64,
      "to": 39.12,
      "sid": 20,
      "location": 2,
      "content": "休息站",
      "music": 0.0
    },
    {
      "from": 39.12,
      "to": 41.16,
      "sid": 21,
      "location": 2,
      "content": "餐厅什么的都能提供不少就业",
      "music": 0.0
    },
    {
      "from": 41.16,
      "to": 42.84,
      "sid": 22,
      "location": 2,
      "content": "这个森林里面的免费休息区",
      "music": 0.0
    },
    {
      "from": 42.84,
      "to": 44.5,
      "sid": 23,
      "location": 2,
      "content": "感觉还挺干净整洁的",
      "music": 0.0
    },
    {
      "from": 44.5,
      "to": 46.32,
      "sid": 24,
      "location": 2,
      "content": "但除了休息区里面的厕所",
      "music": 0.0
    },
    {
      "from": 46.32,
      "to": 47.44,
      "sid": 25,
      "location": 2,
      "content": "这个线也没有什么别的",
      "music": 0.0
    },
    {
      "from": 47.44,
      "to": 49.36,
      "sid": 26,
      "location": 2,
      "content": "可以吸引过往旅客的地方",
      "music": 0.0
    },
    {
      "from": 49.36,
      "to": 50.68,
      "sid": 27,
      "location": 2,
      "content": "可能99%的人",
      "music": 0.0
    },
    {
      "from": 50.68,
      "to": 52.519,
      "sid": 28,
      "location": 2,
      "content": "用完洗手间就接着上路了",
      "music": 0.0
    },
    {
      "from": 52.519,
      "to": 55.159,
      "sid": 29,
      "location": 2,
      "content": "前面这两座就是10号洲际公路的公路桥",
      "music": 0.0
    },
    {
      "from": 55.159,
      "to": 57.039,
      "sid": 30,
      "location": 2,
      "content": "而从这两座桥下面穿过去",
      "music": 0.0
    },
    {
      "from": 57.039,
      "to": 59.479,
      "sid": 31,
      "location": 2,
      "content": "就是霍尔姆县人口第二多的小镇",
      "music": 0.0
    },
    {
      "from": 59.479,
      "to": 61.83,
      "sid": 32,
      "location": 2,
      "content": "504人的小镇庞塞德莱昂",
      "music": 0.0
    },
    {
      "from": 61.83,
      "to": 64.05,
      "sid": 33,
      "location": 2,
      "content": "佛罗里达最早是西班牙的殖民地",
      "music": 0.0
    },
    {
      "from": 64.05,
      "to": 64.99,
      "sid": 34,
      "location": 2,
      "content": "而庞塞德莱昂",
      "music": 0.0
    },
    {
      "from": 64.99,
      "to": 67.67,
      "sid": 35,
      "location": 2,
      "content": "是第一个登陆佛罗里达的西班牙探险家",
      "music": 0.0
    },
    {
      "from": 67.67,
      "to": 69.27,
      "sid": 36,
      "location": 2,
      "content": "这哥们在各种野史中",
      "music": 0.0
    },
    {
      "from": 69.27,
      "to": 69.79,
      "sid": 37,
      "location": 2,
      "content": "是寻找",
      "music": 0.0
    },
    {
      "from": 69.79,
      "to": 72.83,
      "sid": 38,
      "location": 2,
      "content": "可以让人返老还童的青春之泉的传奇人物",
      "music": 0.0
    },
    {
      "from": 72.83,
      "to": 74.91,
      "sid": 39,
      "location": 2,
      "content": "可以他名字命名的庞塞德朗",
      "music": 0.0
    },
    {
      "from": 74.91,
      "to": 77.05,
      "sid": 40,
      "location": 2,
      "content": "却只是一个佛罗里达的偏僻小镇",
      "music": 0.0
    },
    {
      "from": 77.05,
      "to": 79.61,
      "sid": 41,
      "location": 2,
      "content": "这个小镇2010年有598个人",
      "music": 0.0
    },
    {
      "from": 79.61,
      "to": 81.759,
      "sid": 42,
      "location": 2,
      "content": "在过去10年减少了15%",
      "music": 0.0
    },
    {
      "from": 81.759,
      "to": 83.459,
      "sid": 43,
      "location": 2,
      "content": "现在只剩504个人",
      "music": 0.0
    },
    {
      "from": 83.459,
      "to": 85.599,
      "sid": 44,
      "location": 2,
      "content": "其中93.65%是白人",
      "music": 0.0
    },
    {
      "from": 85.599,
      "to": 88.14,
      "sid": 45,
      "location": 2,
      "content": "亚洲人和黑人加起来一共只有四个",
      "music": 0.0
    },
    {
      "from": 88.14,
      "to": 89.34,
      "sid": 46,
      "location": 2,
      "content": "在进小说的时候",
      "music": 0.0
    },
    {
      "from": 89.34,
      "to": 91.22,
      "sid": 47,
      "location": 2,
      "content": "发现有一个阿姨在路边举了个牌子",
      "music": 0.0
    },
    {
      "from": 91.22,
      "to": 91.62,
      "sid": 48,
      "location": 2,
      "content": "写道",
      "music": 0.0
    },
    {
      "from": 91.62,
      "to": 92.82,
      "sid": 49,
      "location": 2,
      "content": "我不是无家可归",
      "music": 0.0
    },
    {
      "from": 92.82,
      "to": 94.14,
      "sid": 50,
      "location": 2,
      "content": "只是想要一点钱",
      "music": 0.0
    },
    {
      "from": 94.14,
      "to": 96.06,
      "sid": 51,
      "location": 2,
      "content": "我本来想到公路边找个地方停车",
      "music": 0.0
    },
    {
      "from": 96.06,
      "to": 97.28,
      "sid": 52,
      "location": 2,
      "content": "再来找他聊聊的",
      "music": 0.0
    },
    {
      "from": 97.28,
      "to": 99.18,
      "sid": 53,
      "location": 2,
      "content": "兜了一圈回来发现陷阱来了",
      "music": 0.0
    },
    {
      "from": 99.18,
      "to": 101.52,
      "sid": 54,
      "location": 2,
      "content": "咱就不主动找佛罗里达警察匹配了",
      "music": 0.0
    },
    {
      "from": 101.52,
      "to": 104.28,
      "sid": 55,
      "location": 2,
      "content": "还是先带大家看看庞塞德莱昂小镇里面吧",
      "music": 0.0
    },
    {
      "from": 104.28,
      "to": 105.84,
      "sid": 56,
      "location": 2,
      "content": "这算是小镇最老的片区",
      "music": 0.0
    },
    {
      "from": 105.84,
      "to": 106.84,
      "sid": 57,
      "location": 2,
      "content": "在铁轨旁边",
      "music": 0.0
    },
    {
      "from": 106.84,
      "to": 108.48,
      "sid": 58,
      "location": 2,
      "content": "以前在汽车没有普及的时候",
      "music": 0.0
    },
    {
      "from": 108.48,
      "to": 109.8,
      "sid": 59,
      "location": 2,
      "content": "大家都靠铁路出行",
      "music": 0.0
    },
    {
      "from": 109.8,
      "to": 111.68,
      "sid": 60,
      "location": 2,
      "content": "所以老店铺都开在铁轨旁边",
      "music": 0.0
    },
    {
      "from": 111.68,
      "to": 113.4,
      "sid": 61,
      "location": 2,
      "content": "如今这里已经没有客运火车了",
      "music": 0.0
    },
    {
      "from": 113.4,
      "to": 114.949,
      "sid": 62,
      "location": 2,
      "content": "所以这排房子都废弃了",
      "music": 0.0
    },
    {
      "from": 114.949,
      "to": 116.869,
      "sid": 63,
      "location": 2,
      "content": "铁道两侧的老路也是坑坑洼洼",
      "music": 0.0
    },
    {
      "from": 116.869,
      "to": 118.409,
      "sid": 64,
      "location": 2,
      "content": "像是多年没有维护了",
      "music": 0.0
    },
    {
      "from": 118.409,
      "to": 121.25,
      "sid": 65,
      "location": 2,
      "content": "这个小镇一半的房子的价值都不到10万美元",
      "music": 0.0
    },
    {
      "from": 121.25,
      "to": 122.13,
      "sid": 66,
      "location": 2,
      "content": "看数据的话",
      "music": 0.0
    },
    {
      "from": 122.13,
      "to": 125.01,
      "sid": 67,
      "location": 2,
      "content": "整个小镇30万美元以上的房子是一栋都没有",
      "music": 0.0
    },
    {
      "from": 125.01,
      "to": 127.27,
      "sid": 68,
      "location": 2,
      "content": "而在佛罗里达一些比较热门的海滨小镇",
      "music": 0.0
    },
    {
      "from": 127.27,
      "to": 129.01,
      "sid": 69,
      "location": 2,
      "content": "可能最差的房子十倍的价格",
      "music": 0.0
    },
    {
      "from": 129.01,
      "to": 130.47,
      "sid": 70,
      "location": 2,
      "content": "300万美元都买不到",
      "music": 0.0
    },
    {
      "from": 130.47,
      "to": 132.69,
      "sid": 71,
      "location": 2,
      "content": "现在我去庞塞德莱昂的CBD看看",
      "music": 0.0
    },
    {
      "from": 132.69,
      "to": 133.71,
      "sid": 72,
      "location": 2,
      "content": "这个核心商业区",
      "music": 0.0
    },
    {
      "from": 133.71,
      "to": 135.23,
      "sid": 73,
      "location": 2,
      "content": "就是公路边的一个小平房",
      "music": 0.0
    },
    {
      "from": 135.23,
      "to": 136.84,
      "sid": 74,
      "location": 2,
      "content": "再加上餐车的综合体",
      "music": 0.0
    },
    {
      "from": 136.84,
      "to": 139.32,
      "sid": 75,
      "location": 2,
      "content": "我先在他们这个餐车里买了个六美元的猪肉",
      "music": 0.0
    },
    {
      "from": 139.32,
      "to": 139.78,
      "sid": 76,
      "location": 2,
      "content": "汉堡",
      "music": 0.0
    },
    {
      "from": 139.78,
      "to": 140.84,
      "sid": 77,
      "location": 2,
      "content": "肉量还是挺大的",
      "music": 0.0
    },
    {
      "from": 140.84,
      "to": 141.8,
      "sid": 78,
      "location": 2,
      "content": "味道也还不错",
      "music": 0.0
    },
    {
      "from": 141.8,
      "to": 143.32,
      "sid": 79,
      "location": 2,
      "content": "觉得值得扣一不值得扣",
      "music": 0.0
    },
    {
      "from": 143.32,
      "to": 146.06,
      "sid": 80,
      "location": 2,
      "content": "二吃完汉堡去他们这个小超市里看看",
      "music": 0.0
    },
    {
      "from": 146.06,
      "to": 147.52,
      "sid": 81,
      "location": 2,
      "content": "店里面的氛围还不错",
      "music": 0.0
    },
    {
      "from": 147.52,
      "to": 148.96,
      "sid": 82,
      "location": 2,
      "content": "大家也都互相认识",
      "music": 0.0
    },
    {
      "from": 148.96,
      "to": 150.68,
      "sid": 83,
      "location": 2,
      "content": "毕竟这个小镇一共就500人",
      "music": 0.0
    },
    {
      "from": 150.68,
      "to": 153.3,
      "sid": 84,
      "location": 2,
      "content": "也不太会有像我这样特地来参观的外地人",
      "music": 0.0
    },
    {
      "from": 153.3,
      "to": 154.58,
      "sid": 85,
      "location": 2,
      "content": "我在店里面瞎逛的时候",
      "music": 0.0
    },
    {
      "from": 154.58,
      "to": 156.9,
      "sid": 86,
      "location": 2,
      "content": "还有陌生人特地给我打招呼",
      "music": 0.0
    },
    {
      "from": 156.9,
      "to": 157.92,
      "sid": 87,
      "location": 2,
      "content": "Hello",
      "music": 0.0
    },
    {
      "from": 157.92,
      "to": 159.1,
      "sid": 88,
      "location": 2,
      "content": "这大姐突然这么友好",
      "music": 0.0
    },
    {
      "from": 159.1,
      "to": 160.24,
      "sid": 89,
      "location": 2,
      "content": "我都没有反应过来",
      "music": 0.0
    },
    {
      "from": 160.24,
      "to": 162.4,
      "sid": 90,
      "location": 2,
      "content": "现在回想起来应该把她拉来聊天",
      "music": 0.0
    },
    {
      "from": 162.4,
      "to": 163.92,
      "sid": 91,
      "location": 2,
      "content": "这个小超市里面也有熟食卖",
      "music": 0.0
    },
    {
      "from": 163.92,
      "to": 165.38,
      "sid": 92,
      "location": 2,
      "content": "我就随手拿了一个小汉堡",
      "music": 0.0
    },
    {
      "from": 165.38,
      "to": 167.96,
      "sid": 93,
      "location": 2,
      "content": "我一出超市发现店门口停的这个大皮卡",
      "music": 0.0
    },
    {
      "from": 167.96,
      "to": 170.04,
      "sid": 94,
      "location": 2,
      "content": "车头直接挂了个蓄奴州邦联的旗子",
      "music": 0.0
    },
    {
      "from": 170.04,
      "to": 172.48,
      "sid": 95,
      "location": 2,
      "content": "美国很多州是不要求挂前车牌的",
      "music": 0.0
    },
    {
      "from": 172.48,
      "to": 173.96,
      "sid": 96,
      "location": 2,
      "content": "车主可以自行装饰",
      "music": 0.0
    },
    {
      "from": 173.96,
      "to": 175.92,
      "sid": 97,
      "location": 2,
      "content": "佛罗里达在成为旅游胜地之前",
      "music": 0.0
    },
    {
      "from": 175.92,
      "to": 177.32,
      "sid": 98,
      "location": 2,
      "content": "历史上也是一个种植园",
      "music": 0.0
    },
    {
      "from": 177.32,
      "to": 178.43,
      "sid": 99,
      "location": 2,
      "content": "遍地的蓄奴州",
      "music": 0.0
    },
    {
      "from": 178.43,
      "to": 180.69,
      "sid": 100,
      "location": 2,
      "content": "这个霍尔姆斯县位于北佛罗里达",
      "music": 0.0
    },
    {
      "from": 180.69,
      "to": 183.37,
      "sid": 101,
      "location": 2,
      "content": "跟以前最重要的匈奴中阿拉巴马是交界的",
      "music": 0.0
    },
    {
      "from": 183.37,
      "to": 185.86,
      "sid": 102,
      "location": 2,
      "content": "反倒是离佛罗里达有名的大城市都很远",
      "music": 0.0
    },
    {
      "from": 185.86,
      "to": 188.14,
      "sid": 103,
      "location": 2,
      "content": "这里倒有迪士尼和环球影城的奥兰多",
      "music": 0.0
    },
    {
      "from": 188.14,
      "to": 189.18,
      "sid": 104,
      "location": 2,
      "content": "要580km",
      "music": 0.0
    },
    {
      "from": 189.18,
      "to": 190.649,
      "sid": 105,
      "location": 2,
      "content": "也就是五个小时车程",
      "music": 0.0
    },
