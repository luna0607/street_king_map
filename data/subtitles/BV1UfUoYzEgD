      "music": 0.0
    },
    {
      "from": 46.78,
      "to": 48.04,
      "sid": 23,
      "location": 2,
      "content": "这边有拜登的照片",
      "music": 0.0
    },
    {
      "from": 48.04,
      "to": 48.16,
      "sid": 24,
      "location": 2,
      "content": "是",
      "music": 0.0
    },
    {
      "from": 48.16,
      "to": 51.25,
      "sid": 25,
      "location": 2,
      "content": "因为联邦法院和邮局都是美国联邦政府的地盘",
