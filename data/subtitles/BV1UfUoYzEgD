    {
      "from": 0.08,
      "to": 2.68,
      "sid": 1,
      "location": 2,
      "content": "今天我来到了美国四周交界处的德州小城",
      "music": 0.0
    },
    {
      "from": 2.68,
      "to": 3.92,
      "sid": 2,
      "location": 2,
      "content": "德克萨卡纳",
      "music": 0.0
    },
    {
      "from": 3.92,
      "to": 6.31,
      "sid": 3,
      "location": 2,
      "content": "德克萨卡纳是一个人造复合词",
      "music": 0.0
    },
    {
      "from": 6.31,
      "to": 9.29,
      "sid": 4,
      "location": 2,
      "content": "由TEXASARKANSAS和路易斯ANNA拼接而成",
      "music": 0.0
    },
    {
      "from": 9.29,
      "to": 12.03,
      "sid": 5,
      "location": 2,
      "content": "这里离路易斯那州和俄克拉荷马州很近",
      "music": 0.0
    },
    {
      "from": 12.03,
      "to": 13.91,
      "sid": 6,
      "location": 2,
      "content": "而目前行驶在了小镇主干道",
      "music": 0.0
    },
    {
      "from": 13.91,
      "to": 15.86,
      "sid": 7,
      "location": 2,
      "content": "就是德州和阿肯色州的州界",
      "music": 0.0
    },
    {
      "from": 15.86,
      "to": 18.46,
      "sid": 8,
      "location": 2,
      "content": "这条马路把德克萨卡纳一分为二路",
      "music": 0.0
    },
    {
      "from": 18.46,
      "to": 19.3,
      "sid": 9,
      "location": 2,
      "content": "进球的小房子",
      "music": 0.0
    },
    {
      "from": 19.3,
      "to": 22.17,
      "sid": 10,
      "location": 2,
      "content": "也是美国唯一一个横跨两个州的法院和邮局",
      "music": 0.0
    },
    {
      "from": 22.17,
      "to": 24.97,
      "sid": 11,
      "location": 2,
      "content": "算是德州和阿肯色州公用的这个广场",
      "music": 0.0
    },
    {
      "from": 24.97,
      "to": 27.41,
      "sid": 12,
      "location": 2,
      "content": "上面的牌子算是一个小旅游打卡点了",
      "music": 0.0
    },
    {
      "from": 27.41,
      "to": 29.85,
      "sid": 13,
      "location": 2,
      "content": "就是给大家指示一下周建马路的位置",
      "music": 0.0
    },
    {
      "from": 29.85,
      "to": 32.23,
      "sid": 14,
      "location": 2,
      "content": "以及德州和阿肯色州分别的方位",
      "music": 0.0
    },
    {
      "from": 32.23,
      "to": 33.71,
      "sid": 15,
      "location": 2,
      "content": "因为怕早上人太多",
      "music": 0.0
    },
    {
      "from": 33.71,
      "to": 34.49,
      "sid": 16,
      "location": 2,
      "content": "比较羞耻",
      "music": 0.0
    },
    {
      "from": 34.49,
      "to": 36.43,
      "sid": 17,
      "location": 2,
      "content": "我在前一天晚上空无一人的时候",
      "music": 0.0
    },
    {
      "from": 36.43,
      "to": 39.32,
      "sid": 18,
      "location": 2,
      "content": "在这个邮局门口做了一个比较标准的游客行为",
      "music": 0.0
    },
    {
      "from": 39.32,
      "to": 40.84,
      "sid": 19,
      "location": 2,
      "content": "也就是在这个牌子前面",
      "music": 0.0
    },
    {
      "from": 40.84,
      "to": 43.84,
      "sid": 20,
      "location": 2,
      "content": "坐一个横跨德克萨斯州和阿肯色州的人",
