      "from": 73.46,
      "to": 76.18,
      "sid": 37,
      "location": 2,
      "content": "无论是铁路还是公路都会经过这边",
      "music": 0.0
    },
    {
      "from": 76.18,
      "to": 78.88,
      "sid": 38,
      "location": 2,
