  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.04,
      "to": 1.32,
      "sid": 1,
      "location": 2,
      "content": "接下来我来到德克萨斯州",
      "music": 0.0
    },
    {
      "from": 1.32,
      "to": 2.58,
      "sid": 2,
      "location": 2,
      "content": "一个180人的小镇",
      "music": 0.0
    },
    {
      "from": 2.58,
      "to": 3.34,
      "sid": 3,
      "location": 2,
      "content": "佩内洛普",
      "music": 0.0
    },
    {
      "from": 3.34,
      "to": 4.56,
      "sid": 4,
      "location": 2,
      "content": "这看似荒凉的小镇",
      "music": 0.0
    },
    {
      "from": 4.56,
      "to": 6.64,
      "sid": 5,
      "location": 2,
      "content": "其实位于如今美国发展最快的地区",
      "music": 0.0
    },
    {
      "from": 6.64,
      "to": 7.74,
      "sid": 6,
      "location": 2,
      "content": "德州三角地带",
      "music": 0.0
    },
    {
      "from": 7.74,
      "to": 10.3,
      "sid": 7,
      "location": 2,
      "content": "这个城市群得名于德州三个最大的城市",
      "music": 0.0
    },
    {
      "from": 10.3,
      "to": 10.74,
      "sid": 8,
      "location": 2,
      "content": "达拉斯",
      "music": 0.0
    },
    {
      "from": 10.74,
      "to": 12.08,
      "sid": 9,
      "location": 2,
      "content": "休斯顿和圣安东尼奥",
      "music": 0.0
    },
    {
      "from": 12.08,
      "to": 14.08,
      "sid": 10,
      "location": 2,
      "content": "以及把它们两两相连的45号",
      "music": 0.0
    },
    {
      "from": 14.08,
      "to": 16.86,
      "sid": 11,
      "location": 2,
      "content": "10号以及35号洲际公路沿线的城市",
      "music": 0.0
    },
    {
      "from": 16.86,
      "to": 18.2,
      "sid": 12,
      "location": 2,
      "content": "形成的三角形地带",
      "music": 0.0
    },
    {
      "from": 18.2,
      "to": 19.74,
      "sid": 13,
      "location": 2,
      "content": "可光看这张夜晚的灯光图",
      "music": 0.0
    },
    {
      "from": 19.74,
      "to": 20.34,
      "sid": 14,
      "location": 2,
      "content": "就显示出",
      "music": 0.0
    },
    {
      "from": 20.34,
      "to": 23.5,
      "sid": 15,
      "location": 2,
      "content": "人类聚集点都是在洲际公路以及核心城市周围",
      "music": 0.0
    },
    {
      "from": 23.5,
      "to": 25.64,
      "sid": 16,
      "location": 2,
      "content": "中间这么一大片黑暗的德州农村",
      "music": 0.0
    },
    {
      "from": 25.64,
      "to": 27.509,
      "sid": 17,
      "location": 2,
      "content": "便是我今天要带各位探索",
      "music": 0.0
    },
    {
      "from": 27.509,
      "to": 29.069,
      "sid": 18,
      "location": 2,
      "content": "这个叫佩内洛普的小镇",
      "music": 0.0
    },
    {
      "from": 29.069,
      "to": 32.109,
      "sid": 19,
      "location": 2,
      "content": "在1980年抵达人口巅峰235人之后",
      "music": 0.0
    },
    {
      "from": 32.109,
      "to": 33.57,
      "sid": 20,
      "location": 2,
      "content": "如今只剩180人",
      "music": 0.0
    },
    {
      "from": 33.57,
      "to": 35.15,
      "sid": 21,
      "location": 2,
      "content": "居民绝大多数是白人",
      "music": 0.0
    },
    {
      "from": 35.15,
      "to": 35.69,
      "sid": 22,
      "location": 2,
      "content": "除了这些",
      "music": 0.0
    },
    {
      "from": 35.69,
      "to": 38.04,
      "sid": 23,
      "location": 2,
      "content": "我也找不到其他和小镇相关的信息",
      "music": 0.0
    },
    {
      "from": 38.04,
      "to": 40.44,
      "sid": 24,
      "location": 2,
      "content": "这边地少人多的优势就是大部分人门口",
      "music": 0.0
    },
    {
      "from": 40.44,
      "to": 42.42,
      "sid": 25,
      "location": 2,
      "content": "草地上都堆满了各种各样的杂物",
      "music": 0.0
    },
    {
      "from": 42.42,
      "to": 44.12,
      "sid": 26,
      "location": 2,
      "content": "我在小智转悠了十几分钟",
      "music": 0.0
    },
    {
      "from": 44.12,
      "to": 46.28,
      "sid": 27,
      "location": 2,
      "content": "真的一个活人都见不到",
      "music": 0.0
    },
    {
      "from": 51.34,
      "to": 53.5,
      "sid": 28,
      "location": 2,
      "content": "虽然佩内洛普只有180个人",
      "music": 0.0
    },
    {
      "from": 53.5,
      "to": 56.42,
      "sid": 29,
      "location": 2,
      "content": "但是小镇主街上还有一个自愿性质的消防局",
      "music": 0.0
    },
    {
      "from": 56.42,
      "to": 58.9,
      "sid": 30,
      "location": 2,
      "content": "当然马路对面还是有我们频道的保留节目",
      "music": 0.0
    },
    {
      "from": 58.9,
      "to": 59.879,
      "sid": 31,
      "location": 2,
      "content": "小镇邮局",
      "music": 0.0
    },
    {
      "from": 59.879,
      "to": 61.119,
      "sid": 32,
      "location": 2,
      "content": "虽然这是在德州",
      "music": 0.0
    },
    {
      "from": 61.119,
      "to": 63.679,
      "sid": 33,
      "location": 2,
      "content": "但是邮局门口还是写的不得带枪进入",
      "music": 0.0
    },
    {
      "from": 63.679,
      "to": 64.939,
      "sid": 34,
      "location": 2,
      "content": "这里的门是不锁的",
      "music": 0.0
    },
    {
      "from": 64.939,
      "to": 67.53,
      "sid": 35,
      "location": 2,
      "content": "所以24小时任何时间都可以进入",
      "music": 0.0
    },
    {
      "from": 67.53,
      "to": 70.39,
      "sid": 36,
      "location": 2,
      "content": "虽然说佩内洛普看着像是个与世隔绝的地方",
      "music": 0.0
    },
    {
      "from": 70.39,
      "to": 72.25,
      "sid": 37,
      "location": 2,
      "content": "但实际上这里并不是很偏",
      "music": 0.0
    },
    {
      "from": 72.25,
      "to": 75.48,
      "sid": 38,
      "location": 2,
      "content": "我拿到15万人的小城维科只要30分钟",
      "music": 0.0
    },
    {
      "from": 75.48,
      "to": 76.72,
      "sid": 39,
      "location": 2,
      "content": "可能一些人听说过",
      "music": 0.0
    },
    {
      "from": 76.72,
      "to": 79.87,
      "sid": 40,
      "location": 2,
      "content": "当年美国联邦调查局和大卫教对射的维科惨案",
      "music": 0.0
    },
    {
      "from": 79.87,
      "to": 81.99,
      "sid": 41,
      "location": 2,
      "content": "还有很多人没有办法接受的黑暗饮料",
      "music": 0.0
    },
    {
      "from": 83.87,
      "to": 86.39,
      "sid": 42,
      "location": 2,
      "content": "从佩内洛普往维科的方向向南开10分钟",
      "music": 0.0
    },
    {
      "from": 86.39,
      "to": 87.58,
      "sid": 43,
      "location": 2,
      "content": "明显车就多了不少",
      "music": 0.0
    },
    {
      "from": 87.58,
      "to": 90.6,
      "sid": 44,
      "location": 2,
      "content": "我现在拿到的是354人的勒罗伊小镇",
      "music": 0.0
    },
    {
      "from": 90.6,
      "to": 92.58,
      "sid": 45,
      "location": 2,
      "content": "这里就没有佩依洛普那种破败感",
      "music": 0.0
    },
    {
      "from": 92.58,
      "to": 94.24,
      "sid": 46,
      "location": 2,
      "content": "甚至还有一些老房子在整修",
      "music": 0.0
    },
    {
      "from": 94.24,
      "to": 96.64,
      "sid": 47,
      "location": 2,
      "content": "这个小镇毕竟离维科就20分钟车程",
      "music": 0.0
    },
    {
      "from": 96.64,
      "to": 98.08,
      "sid": 48,
      "location": 2,
      "content": "很多在大城市工作的人",
      "music": 0.0
    },
    {
      "from": 98.08,
      "to": 99.92,
      "sid": 49,
      "location": 2,
      "content": "会选择住在这样的地方通勤",
      "music": 0.0
    },
    {
      "from": 99.92,
      "to": 102.0,
      "sid": 50,
      "location": 2,
      "content": "因此这个小镇最近40年都在增长",
      "music": 0.0
    },
    {
      "from": 102.0,
      "to": 103.5,
      "sid": 51,
      "location": 2,
      "content": "人口虽然增加的不多",
      "music": 0.0
    },
    {
      "from": 103.5,
      "to": 106.26,
      "sid": 52,
      "location": 2,
      "content": "也是从253个人变成了354个人",
      "music": 0.0
    },
    {
      "from": 106.26,
      "to": 108.0,
      "sid": 53,
      "location": 2,
      "content": "当然勒罗伊也有自己的邮局",
      "music": 0.0
    },
    {
      "from": 108.0,
      "to": 109.42,
      "sid": 54,
      "location": 2,
      "content": "甚至还有一家小酒馆",
      "music": 0.0
    },
    {
      "from": 109.42,
      "to": 111.82,
      "sid": 55,
      "location": 2,
      "content": "这边通往维克的路看着也挺新的",
      "music": 0.0
    },
    {
      "from": 111.82,
      "to": 113.5,
      "sid": 56,
      "location": 2,
      "content": "但如果从开头的佩内洛普",
      "music": 0.0
    },
    {
      "from": 113.5,
      "to": 115.18,
      "sid": 57,
      "location": 2,
      "content": "往维科的反方向开5分钟",
      "music": 0.0
    },
    {
      "from": 115.18,
      "to": 116.9,
      "sid": 58,
      "location": 2,
      "content": "我来到了这个叫马龙的小镇",
      "music": 0.0
    },
    {
      "from": 116.9,
      "to": 118.69,
      "sid": 59,
      "location": 2,
      "content": "比佩内洛普还要更破一些",
      "music": 0.0
    },
    {
      "from": 118.69,
      "to": 121.59,
      "sid": 60,
      "location": 2,
      "content": "马龙的这个主街街头甚至还有点末日风",
      "music": 0.0
    },
    {
      "from": 121.59,
      "to": 123.41,
      "sid": 61,
      "location": 2,
      "content": "在1920年马龙刚建立的时候",
      "music": 0.0
    },
    {
      "from": 123.41,
      "to": 124.79,
      "sid": 62,
      "location": 2,
      "content": "有488个人",
      "music": 0.0
    },
    {
      "from": 124.79,
      "to": 126.8,
      "sid": 63,
      "location": 2,
      "content": "如今只剩237个人了",
      "music": 0.0
    },
    {
      "from": 126.8,
      "to": 128.88,
      "sid": 64,
      "location": 2,
      "content": "这家原先在公路边卖商品的小店",
      "music": 0.0
    },
    {
      "from": 128.88,
      "to": 131.84,
      "sid": 65,
      "location": 2,
      "content": "看着也倒闭好些年头了",
      "music": 0.0
    },
    {
      "from": 134.36,
      "to": 136.12,
      "sid": 66,
      "location": 2,
      "content": "马龙最早是一个公路小镇",
      "music": 0.0
    },
    {
      "from": 136.12,
      "to": 138.96,
      "sid": 67,
      "location": 2,
      "content": "他是1939年修建的德州171号公路",
      "music": 0.0
    },
    {
      "from": 138.96,
      "to": 140.88,
      "sid": 68,
      "location": 2,
      "content": "和1948年修建的308号",
      "music": 0.0
    },
    {
      "from": 140.88,
      "to": 142.44,
      "sid": 69,
      "location": 2,
      "content": "德州乡村公路的交汇处",
      "music": 0.0
    },
    {
      "from": 142.44,
      "to": 144.92,
      "sid": 70,
      "location": 2,
      "content": "但这两条单方面只有一条车道的老公路",
      "music": 0.0
    },
    {
      "from": 144.92,
      "to": 147.68,
      "sid": 71,
      "location": 2,
      "content": "显然是比不上几条新修的封闭式高速公路",
      "music": 0.0
    },
    {
      "from": 147.68,
      "to": 148.88,
      "sid": 72,
      "location": 2,
      "content": "老的非封闭式公路",
      "music": 0.0
    },
    {
      "from": 148.88,
      "to": 151.079,
      "sid": 73,
      "location": 2,
      "content": "沿途会有很多像马龙这样的小镇",
      "music": 0.0
    },
    {
      "from": 151.079,
      "to": 153.519,
      "sid": 74,
      "location": 2,
      "content": "在过去路过的车会来这些地方补给",
      "music": 0.0
    },
    {
      "from": 153.519,
      "to": 155.919,
      "sid": 75,
      "location": 2,
      "content": "但沿途的居民区也意味着经过的车流",
      "music": 0.0
    },
    {
      "from": 155.919,
      "to": 156.879,
      "sid": 76,
      "location": 2,
      "content": "经常得要减速",
      "music": 0.0
    },
    {
      "from": 156.879,
      "to": 158.16,
      "sid": 77,
      "location": 2,
      "content": "或者在路口让行",
      "music": 0.0
    },
    {
      "from": 158.16,
      "to": 159.6,
      "sid": 78,
      "location": 2,
      "content": "其实40分钟的车程",
      "music": 0.0
    },
    {
      "from": 159.6,
      "to": 160.8,
      "sid": 79,
      "location": 2,
      "content": "走马龙这里的老公路",
      "music": 0.0
    },
    {
      "from": 160.8,
      "to": 162.79,
      "sid": 80,
      "location": 2,
      "content": "也只比走洲际公路慢6分钟",
      "music": 0.0
    },
    {
      "from": 162.79,
      "to": 164.23,
      "sid": 81,
      "location": 2,
      "content": "但除了这周边的居民",
      "music": 0.0
    },
    {
      "from": 164.23,
      "to": 165.75,
      "sid": 82,
      "location": 2,
      "content": "并不会再有人路过这里",
      "music": 0.0
    },
    {
      "from": 165.75,
      "to": 168.31,
      "sid": 83,
      "location": 2,
      "content": "在离马路不远的一个交叉路口的stop sum旁边",
      "music": 0.0
    },
    {
      "from": 168.31,
      "to": 170.1,
      "sid": 84,
      "location": 2,
      "content": "我还发现了一个废弃的加油站",
      "music": 0.0
    },
    {
      "from": 170.1,
      "to": 172.7,
      "sid": 85,
      "location": 2,
      "content": "虽然说全美国增长最快的几个德州都市圈",
      "music": 0.0
    },
    {
      "from": 172.7,
      "to": 174.0,
      "sid": 86,
      "location": 2,
      "content": "就在几10km之外",
      "music": 0.0
    },
    {
      "from": 174.0,
      "to": 176.32,
      "sid": 87,
      "location": 2,
      "content": "但这些地方跟我之前去过的衰败小镇",
      "music": 0.0
    },
    {
      "from": 176.32,
      "to": 177.6,
      "sid": 88,
      "location": 2,
      "content": "并没有太大的差别",
      "music": 0.0
    },
    {
      "from": 177.6,
      "to": 180.05,
      "sid": 89,
      "location": 2,
      "content": "这些地方当地唯一的产业就是农业了",
      "music": 0.0
    },
    {
      "from": 180.05,
      "to": 182.13,
      "sid": 90,
      "location": 2,
      "content": "佩内洛普和马龙所在的希尔县",
      "music": 0.0
    },
    {
      "from": 182.13,
      "to": 184.45,
      "sid": 91,
      "location": 2,
      "content": "分别在20162020和2024",
      "music": 0.0
    },
    {
      "from": 184.45,
      "to": 186.03,
      "sid": 92,
      "location": 2,
      "content": "投了特朗普78%",
      "music": 0.0
    },
    {
      "from": 186.03,
      "to": 188.37,
      "sid": 93,
      "location": 2,
      "content": "80%和82%的票",
      "music": 0.0
    },
    {
      "from": 188.37,
      "to": 189.13,
      "sid": 94,
      "location": 2,
      "content": "离开马龙",
      "music": 0.0
    },
    {
      "from": 189.13,
      "to": 191.45,
      "sid": 95,
      "location": 2,
      "content": "沿着德州308号农村公路一路向北",
      "music": 0.0
    },
    {
      "from": 191.45,
      "to": 192.79,
      "sid": 96,
      "location": 2,
      "content": "往达拉斯的方向开",
      "music": 0.0
    },
    {
      "from": 192.79,
      "to": 193.41,
      "sid": 97,
      "location": 2,
      "content": "穿公路",
      "music": 0.0
    },
    {
      "from": 193.41,
      "to": 194.87,
      "sid": 98,
      "location": 2,
      "content": "两边无穷无尽的农场",
      "music": 0.0
    },
    {
      "from": 194.87,
      "to": 195.79,
      "sid": 99,
      "location": 2,
      "content": "23分钟之后",
      "music": 0.0
    },
    {
      "from": 195.79,
      "to": 196.95,
      "sid": 100,
      "location": 2,
      "content": "我就到了一个叫意大利的",
      "music": 0.0
    },
    {
      "from": 196.95,
      "to": 198.45,
      "sid": 101,
      "location": 2,
      "content": "1926人小镇",
      "music": 0.0
    },
    {
      "from": 198.45,
      "to": 198.87,
      "sid": 102,
      "location": 2,
      "content": "意大利",
      "music": 0.0
    },
    {
      "from": 198.87,
      "to": 201.76,
      "sid": 103,
      "location": 2,
      "content": "这个小镇曾经是周边地区的农产品交易中心",
      "music": 0.0
    },
    {
      "from": 201.76,
      "to": 202.64,
      "sid": 104,
      "location": 2,
      "content": "但这里的经济",
      "music": 0.0
    },
    {
      "from": 202.64,
      "to": 205.2,
      "sid": 105,
      "location": 2,
      "content": "在1930年受到美国大萧条很大的打击",
      "music": 0.0
    },
    {
      "from": 205.2,
      "to": 206.84,
