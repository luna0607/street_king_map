  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.0,
      "to": 2.28,
      "sid": 1,
      "location": 2,
      "content": "骑手来到了与美国最穷印第安人保留地",
      "music": 0.0
    },
    {
      "from": 2.28,
      "to": 5.02,
      "sid": 2,
      "location": 2,
      "content": "南达科他州的松尼保罗地交界的巴人小村",
      "music": 0.0
    },
    {
      "from": 5.02,
      "to": 5.88,
      "sid": 3,
      "location": 2,
      "content": "怀特克莱",
      "music": 0.0
    },
    {
      "from": 5.88,
      "to": 8.06,
      "sid": 4,
      "location": 2,
      "content": "虽说这里的常住人口还不到十个人",
      "music": 0.0
    },
    {
      "from": 8.06,
      "to": 9.5,
      "sid": 5,
      "location": 2,
      "content": "但光2010年全年",
      "music": 0.0
    },
    {
      "from": 9.5,
      "to": 11.74,
      "sid": 6,
      "location": 2,
      "content": "这杯就卖出了490多万罐啤酒",
      "music": 0.0
    },
    {
      "from": 11.74,
      "to": 14.28,
      "sid": 7,
      "location": 2,
      "content": "平均下来一天可以卖出去1万3000多罐",
      "music": 0.0
    },
    {
      "from": 14.28,
      "to": 17.2,
      "sid": 8,
      "location": 2,
      "content": "光消费税有怀特克莱就交了40多万美元",
      "music": 0.0
    },
    {
      "from": 17.2,
      "to": 19.88,
      "sid": 9,
      "location": 2,
      "content": "来这里消费的主力军都是保罗蒂上面的达克",
      "music": 0.0
    },
    {
      "from": 19.88,
      "to": 21.96,
      "sid": 10,
      "location": 2,
      "content": "他人与怀特克莱接壤的松尼",
      "music": 0.0
    },
    {
      "from": 21.96,
      "to": 24.59,
      "sid": 11,
      "location": 2,
      "content": "保罗蒂上面是禁止贩卖酒类产品的",
      "music": 0.0
    },
    {
      "from": 24.59,
      "to": 27.53,
      "sid": 12,
      "location": 2,
      "content": "萨保罗蒂上的原住民们的酗酒问题很严重",
      "music": 0.0
    },
    {
      "from": 27.53,
      "to": 29.11,
      "sid": 13,
      "location": 2,
      "content": "这里的位置又特别偏",
      "music": 0.0
    },
    {
      "from": 29.11,
      "to": 30.979,
      "sid": 14,
      "location": 2,
      "content": "周围没有任何的大城镇",
      "music": 0.0
    },
    {
      "from": 30.979,
      "to": 32.799,
      "sid": 15,
      "location": 2,
      "content": "很多人便发现了这个商机",
      "music": 0.0
    },
    {
      "from": 32.799,
      "to": 34.299,
      "sid": 16,
      "location": 2,
      "content": "从20世纪初开始",
      "music": 0.0
    },
    {
      "from": 34.299,
      "to": 35.979,
      "sid": 17,
      "location": 2,
      "content": "在紧挨着保罗蒂上的荒野",
      "music": 0.0
    },
    {
      "from": 35.979,
      "to": 38.42,
      "sid": 18,
      "location": 2,
      "content": "就建立起了很多酒馆和酒类商店",
      "music": 0.0
    },
    {
      "from": 38.42,
      "to": 40.18,
      "sid": 19,
      "location": 2,
      "content": "后面这边还加了很多杂货店",
      "music": 0.0
    },
    {
      "from": 40.18,
      "to": 41.06,
      "sid": 20,
      "location": 2,
      "content": "饭店什么的",
      "music": 0.0
    },
    {
      "from": 41.06,
      "to": 42.94,
      "sid": 21,
      "location": 2,
      "content": "渐渐就形成了一个小村落",
      "music": 0.0
    },
    {
      "from": 42.94,
      "to": 44.42,
      "sid": 22,
      "location": 2,
      "content": "但随着90年代起",
      "music": 0.0
    },
    {
      "from": 44.42,
      "to": 46.769,
      "sid": 23,
      "location": 2,
      "content": "保罗蒂上面的酗酒问题越来越严重",
      "music": 0.0
    },
    {
      "from": 46.769,
      "to": 49.47,
      "sid": 24,
      "location": 2,
      "content": "瓦罗蒂和怀特克莱之间的矛盾也越来越多",
      "music": 0.0
    },
    {
      "from": 49.47,
      "to": 51.23,
      "sid": 25,
      "location": 2,
      "content": "本来我想用最近很火的deep seek",
      "music": 0.0
    },
    {
      "from": 51.23,
      "to": 52.79,
      "sid": 26,
      "location": 2,
      "content": "帮我理一下冲突的细节",
      "music": 0.0
    },
    {
      "from": 52.79,
      "to": 55.04,
      "sid": 27,
      "location": 2,
      "content": "但是发现deep seek经常服务器繁忙",
      "music": 0.0
    },
    {
      "from": 55.04,
      "to": 56.4,
      "sid": 28,
      "location": 2,
      "content": "于是我打开了问小白",
      "music": 0.0
    },
    {
      "from": 56.4,
      "to": 58.92,
      "sid": 29,
      "location": 2,
      "content": "deep seek r一六百七十一B满血版",
      "music": 0.0
    },
    {
      "from": 58.92,
      "to": 60.3,
      "sid": 30,
      "location": 2,
      "content": "它的搜索速度超快",
      "music": 0.0
    },
    {
      "from": 60.3,
      "to": 60.72,
      "sid": 31,
      "location": 2,
      "content": "不卡顿",
      "music": 0.0
    },
    {
      "from": 60.72,
      "to": 61.62,
      "sid": 32,
      "location": 2,
      "content": "也不限次数",
      "music": 0.0
    },
    {
      "from": 61.62,
      "to": 63.2,
      "sid": 33,
      "location": 2,
      "content": "无论是网页还是app版",
      "music": 0.0
    },
    {
      "from": 63.2,
      "to": 64.08,
      "sid": 34,
      "location": 2,
      "content": "都是全免费",
      "music": 0.0
    },
    {
      "from": 64.08,
      "to": 66.5,
      "sid": 35,
      "location": 2,
      "content": "而且温小白就算是分析国外的社会问题",
      "music": 0.0
    },
    {
      "from": 66.5,
      "to": 67.6,
      "sid": 36,
      "location": 2,
      "content": "也是又快又准",
      "music": 0.0
    },
    {
      "from": 67.6,
      "to": 67.9,
      "sid": 37,
      "location": 2,
      "content": "松",
      "music": 0.0
    },
    {
      "from": 67.9,
      "to": 71.08,
      "sid": 38,
      "location": 2,
      "content": "林保罗蒂迪是美国最贫困和失业率最高的地区",
      "music": 0.0
    },
    {
      "from": 71.08,
      "to": 74.02,
      "sid": 39,
      "location": 2,
      "content": "而怀特克兰的存在加剧了保罗蒂上的社会问题",
      "music": 0.0
    },
    {
      "from": 74.02,
      "to": 76.54,
      "sid": 40,
      "location": 2,
      "content": "温小白还有一个很强大的推理画图功能",
      "music": 0.0
    },
    {
      "from": 76.54,
      "to": 79.74,
      "sid": 41,
      "location": 2,
      "content": "我让他试着用图片的形式呈现两者的冲突",
      "music": 0.0
    },
    {
      "from": 79.74,
      "to": 80.9,
      "sid": 42,
      "location": 2,
      "content": "他还真发给了我",
      "music": 0.0
    },
    {
      "from": 80.9,
      "to": 84.53,
      "sid": 43,
      "location": 2,
      "content": "两张写实主义画风中融入象征主义构图的大作",
      "music": 0.0
    },
    {
      "from": 84.53,
      "to": 85.67,
      "sid": 44,
      "location": 2,
      "content": "有点扯远了",
      "music": 0.0
    },
    {
      "from": 85.67,
      "to": 87.51,
      "sid": 45,
      "location": 2,
      "content": "在原住民不断的抗争之后",
      "music": 0.0
    },
    {
      "from": 87.51,
      "to": 88.37,
      "sid": 46,
      "location": 2,
      "content": "2017年",
      "music": 0.0
    },
    {
      "from": 88.37,
      "to": 91.19,
      "sid": 47,
      "location": 2,
      "content": "酒类管理局拒绝与怀特克莱的九行续约",
      "music": 0.0
    },
    {
      "from": 91.19,
      "to": 92.75,
      "sid": 48,
      "location": 2,
      "content": "而德克莱也就变成了现在",
      "music": 0.0
    },
    {
      "from": 92.75,
      "to": 94.41,
      "sid": 49,
      "location": 2,
      "content": "这么一个平静的小村庄",
      "music": 0.0
    },
    {
      "from": 94.41,
      "to": 97.71,
      "sid": 50,
      "location": 2,
      "content": "但是这边卖其他生活物资的商店生意都很不错",
      "music": 0.0
    },
    {
      "from": 97.71,
      "to": 100.29,
      "sid": 51,
      "location": 2,
      "content": "主要是因为保利地上面的商业非常匮乏",
      "music": 0.0
    },
    {
      "from": 100.29,
      "to": 101.59,
      "sid": 52,
      "location": 2,
      "content": "酒之外的很多物资",
      "music": 0.0
    },
    {
      "from": 101.59,
      "to": 103.59,
      "sid": 53,
      "location": 2,
      "content": "原住民也得带怀特克来进货",
      "music": 0.0
    },
    {
      "from": 103.59,
      "to": 105.91,
      "sid": 54,
      "location": 2,
      "content": "现在带大家来逛一下他们这个杂货店",
      "music": 0.0
    },
    {
      "from": 105.91,
      "to": 108.15,
      "sid": 55,
      "location": 2,
      "content": "怀特克莱的邮局也在这个超市里面",
      "music": 0.0
    },
    {
      "from": 108.15,
      "to": 109.53,
      "sid": 56,
      "location": 2,
      "content": "这个超市是白人开的",
      "music": 0.0
    },
    {
      "from": 109.53,
      "to": 111.29,
      "sid": 57,
      "location": 2,
      "content": "里面的工作人员都是部落的",
      "music": 0.0
    },
    {
      "from": 111.29,
      "to": 113.05,
      "sid": 58,
      "location": 2,
      "content": "他们确实长得有点像亚洲人",
      "music": 0.0
    },
    {
      "from": 113.05,
      "to": 114.81,
      "sid": 59,
      "location": 2,
      "content": "可能看我长得跟他们差不多",
      "music": 0.0
    },
    {
      "from": 114.81,
      "to": 116.39,
      "sid": 60,
      "location": 2,
      "content": "大家对我也挺友好的",
      "music": 0.0
    },
    {
      "from": 116.39,
      "to": 118.24,
      "sid": 61,
      "location": 2,
      "content": "这边是没有新鲜蔬果卖的",
      "music": 0.0
    },
    {
      "from": 118.24,
      "to": 119.64,
      "sid": 62,
      "location": 2,
      "content": "全部是罐头食品",
      "music": 0.0
    },
    {
      "from": 119.64,
      "to": 121.34,
      "sid": 63,
      "location": 2,
      "content": "这个超市对面有一个服装店",
      "music": 0.0
    },
    {
      "from": 121.34,
      "to": 122.94,
      "sid": 64,
      "location": 2,
      "content": "这里主要卖两种东西",
      "music": 0.0
    },
    {
      "from": 122.94,
      "to": 124.68,
      "sid": 65,
      "location": 2,
      "content": "一个是老西部风服装",
      "music": 0.0
    },
    {
      "from": 124.68,
      "to": 126.58,
      "sid": 66,
      "location": 2,
      "content": "另外一个是部落的服装",
      "music": 0.0
    },
    {
      "from": 126.58,
      "to": 127.56,
      "sid": 67,
      "location": 2,
      "content": "我查了一下",
      "music": 0.0
    },
    {
      "from": 127.56,
      "to": 131.16,
      "sid": 68,
      "location": 2,
      "content": "在松林保罗地8800平方公里的土地上面",
      "music": 0.0
    },
    {
      "from": 131.16,
      "to": 132.98,
      "sid": 69,
      "location": 2,
      "content": "一家专卖服装的店都没有",
      "music": 0.0
    },
    {
      "from": 132.98,
      "to": 135.0,
      "sid": 70,
      "location": 2,
      "content": "最多是有便利店卖卖衣服什么的",
      "music": 0.0
    },
    {
      "from": 135.0,
      "to": 137.06,
      "sid": 71,
      "location": 2,
      "content": "我不确定保罗蒂上面能不能网购",
      "music": 0.0
    },
    {
      "from": 137.06,
      "to": 138.64,
      "sid": 72,
      "location": 2,
      "content": "不过要想在线下买的话",
      "music": 0.0
    },
    {
      "from": 138.64,
      "to": 139.57,
      "sid": 73,
      "location": 2,
      "content": "只能来这里",
      "music": 0.0
    },
    {
      "from": 139.57,
      "to": 140.37,
      "sid": 74,
      "location": 2,
      "content": "逛完商店",
      "music": 0.0
    },
    {
      "from": 140.37,
      "to": 141.77,
      "sid": 75,
      "location": 2,
      "content": "去马路对面吃个午饭",
      "music": 0.0
    },
    {
      "from": 141.77,
      "to": 143.69,
      "sid": 76,
      "location": 2,
      "content": "这里卖的都是一些快餐",
      "music": 0.0
    },
    {
      "from": 143.69,
      "to": 146.18,
      "sid": 77,
      "location": 2,
      "content": "不过意外的比我想象中的好吃很多",
      "music": 0.0
    },
    {
      "from": 146.18,
      "to": 148.46,
      "sid": 78,
      "location": 2,
      "content": "我点了一个五美元一份的鸡肉泡饭",
      "music": 0.0
    },
    {
      "from": 148.46,
      "to": 150.3,
      "sid": 79,
      "location": 2,
      "content": "和一个四美元的香肠三明治",
      "music": 0.0
    },
    {
      "from": 150.3,
      "to": 151.98,
      "sid": 80,
      "location": 2,
      "content": "再加上一罐一美元的汽水",
      "music": 0.0
    },
    {
      "from": 151.98,
      "to": 153.26,
      "sid": 81,
      "location": 2,
      "content": "一共是十块钱",
      "music": 0.0
    },
    {
      "from": 153.26,
      "to": 154.7,
      "sid": 82,
      "location": 2,
      "content": "各位觉得价格如何",
      "music": 0.0
    },
    {
      "from": 154.7,
      "to": 156.56,
      "sid": 83,
      "location": 2,
      "content": "虽说怀特克莱不再卖酒了",
      "music": 0.0
    },
    {
      "from": 156.56,
      "to": 158.18,
      "sid": 84,
      "location": 2,
      "content": "但保罗蒂上面的酗酒问题",
      "music": 0.0
    },
    {
      "from": 158.18,
      "to": 160.209,
      "sid": 85,
      "location": 2,
      "content": "肯定也不可能这么轻易的解决",
      "music": 0.0
    },
    {
      "from": 160.209,
      "to": 162.529,
      "sid": 86,
      "location": 2,
      "content": "很多人主要通过我现在行驶在的公路",
      "music": 0.0
    },
    {
      "from": 162.529,
      "to": 165.309,
      "sid": 87,
      "location": 2,
      "content": "南下到怀特克莱所在的谢里登县县城",
      "music": 0.0
    },
    {
      "from": 165.309,
      "to": 166.62,
      "sid": 88,
      "location": 2,
      "content": "拉什维尔进货",
      "music": 0.0
    },
    {
      "from": 166.62,
      "to": 168.46,
      "sid": 89,
      "location": 2,
      "content": "这一条路两侧都是草场",
      "music": 0.0
    },
    {
      "from": 168.46,
      "to": 169.42,
      "sid": 90,
      "location": 2,
      "content": "只见得到牛",
      "music": 0.0
    },
    {
      "from": 169.42,
      "to": 170.28,
      "sid": 91,
      "location": 2,
      "content": "见不到人",
      "music": 0.0
    },
    {
      "from": 170.28,
      "to": 171.64,
      "sid": 92,
      "location": 2,
      "content": "怀特克拉戒酒之后",
      "music": 0.0
    },
    {
      "from": 171.64,
      "to": 173.94,
      "sid": 93,
      "location": 2,
      "content": "很多人甚至直接徒步穿越这么一段",
      "music": 0.0
    },
    {
      "from": 173.94,
      "to": 177.08,
      "sid": 94,
      "location": 2,
      "content": "35km的无人区公路去拉什维尔路两侧",
      "music": 0.0
    },
    {
      "from": 177.08,
      "to": 178.72,
      "sid": 95,
      "location": 2,
      "content": "也有很多人想搭便车",
      "music": 0.0
    },
    {
      "from": 178.72,
      "to": 181.87,
      "sid": 96,
      "location": 2,
      "content": "劳拉什维尔只是一个816人的普通小镇",
      "music": 0.0
    },
    {
      "from": 181.87,
      "to": 184.47,
      "sid": 97,
      "location": 2,
      "content": "这边跟我去过的很多美国偏僻乡村一样",
      "music": 0.0
    },
    {
      "from": 184.47,
      "to": 187.34,
      "sid": 98,
      "location": 2,
      "content": "每10年以10%左右的比例流失人口",
      "music": 0.0
    },
    {
      "from": 187.34,
      "to": 188.76,
      "sid": 99,
      "location": 2,
      "content": "这里的产业除了农业",
      "music": 0.0
    },
    {
      "from": 188.76,
      "to": 190.38,
      "sid": 100,
      "location": 2,
      "content": "还有跟保罗蒂上面的贸易",
      "music": 0.0
    },
    {
      "from": 190.38,
      "to": 192.9,
      "sid": 101,
      "location": 2,
      "content": "比如说这边有距离保罗地最近的银行",
      "music": 0.0
    },
    {
      "from": 192.9,
      "to": 195.82,
      "sid": 102,
      "location": 2,
      "content": "说来你可能不信保罗地上面一家银行都没有",
      "music": 0.0
    },
    {
      "from": 195.82,
      "to": 198.88,
      "sid": 103,
      "location": 2,
      "content": "所以说想办银行卡的原住民得来拉什维尔开户",
      "music": 0.0
    },
    {
      "from": 198.88,
      "to": 200.42,
      "sid": 104,
      "location": 2,
      "content": "当然还有酒类生意",
      "music": 0.0
    },
    {
      "from": 200.42,
      "to": 202.12,
