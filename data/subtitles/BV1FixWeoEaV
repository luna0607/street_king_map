    {
      "from": 0.0,
      "to": 2.95,
      "sid": 1,
      "location": 2,
      "content": "今天我来到了美国一座叫开罗的城市的市中心",
      "music": 0.0
    },
    {
      "from": 2.95,
      "to": 4.99,
      "sid": 2,
      "location": 2,
      "content": "这片在1920年人口巅峰的时候",
      "music": 0.0
    },
    {
      "from": 4.99,
      "to": 6.17,
      "sid": 3,
      "location": 2,
      "content": "就有1万5000人",
