  "body": [
    {
      "from": 0.04,
      "to": 2.52,
      "sid": 1,
      "location": 2,
      "content": "现在我在离洛杉矶机场最近的一个地铁站",
      "music": 0.0
    },
    {
      "from": 2.52,
      "to": 4.08,
      "sid": 2,
      "location": 2,
      "content": "时间晚上十点左右",
      "music": 0.0
    },
    {
      "from": 4.08,
      "to": 6.0,
      "sid": 3,
      "location": 2,
      "content": "我现在其实也不知道要去哪里",
      "music": 0.0
    },
    {
      "from": 6.0,
      "to": 8.06,
      "sid": 4,
      "location": 2,
      "content": "因为我刚刚坐航班抵达洛杉矶",
      "music": 0.0
    },
    {
      "from": 8.06,
      "to": 11.12,
      "sid": 5,
      "location": 2,
      "content": "而我的下一个航班要到第二天的早上五点左右",
      "music": 0.0
    },
    {
      "from": 11.12,
      "to": 14.34,
      "sid": 6,
      "location": 2,
      "content": "所以我今天就开启一段洛杉矶深夜随机之旅",
      "music": 0.0
    },
    {
      "from": 14.34,
      "to": 16.28,
      "sid": 7,
      "location": 2,
      "content": "我一上车就发现自己坐反了",
      "music": 0.0
    },
    {
      "from": 16.28,
      "to": 18.12,
      "sid": 8,
      "location": 2,
      "content": "往各郊区的方向坐了一站",
      "music": 0.0
    },
    {
      "from": 18.12,
      "to": 19.8,
      "sid": 9,
      "location": 2,
      "content": "于是我立马就下车了",
      "music": 0.0
    },
    {
      "from": 19.8,
      "to": 21.88,
      "sid": 10,
      "location": 2,
      "content": "但是这个轻轨站看着好冷清啊",
      "music": 0.0
    },
    {
      "from": 21.88,
      "to": 23.28,
      "sid": 11,
      "location": 2,
      "content": "怎么一个人都没有",
      "music": 0.0
    },
    {
      "from": 23.28,
      "to": 24.74,
      "sid": 12,
      "location": 2,
      "content": "有人吗",
      "music": 0.0
    },
    {
      "from": 27.26,
      "to": 28.9,
      "sid": 13,
      "location": 2,
      "content": "有人吗",
      "music": 0.0
    },
    {
      "from": 33.499,
      "to": 34.699,
      "sid": 14,
      "location": 2,
      "content": "车终于来了",
      "music": 0.0
    },
    {
      "from": 34.699,
      "to": 37.23,
      "sid": 15,
      "location": 2,
      "content": "眼前的观众可能发现我还提着行李",
      "music": 0.0
    },
    {
      "from": 37.23,
      "to": 39.53,
      "sid": 16,
      "location": 2,
      "content": "由于我下一程要到第二天的凌晨",
      "music": 0.0
    },
    {
      "from": 39.53,
      "to": 40.75,
      "sid": 17,
      "location": 2,
      "content": "就算办好了值机",
      "music": 0.0
    },
    {
      "from": 40.75,
      "to": 42.83,
      "sid": 18,
      "location": 2,
      "content": "我也只能第二天再把行李放过去",
      "music": 0.0
    },
    {
      "from": 42.83,
      "to": 45.019,
      "sid": 19,
      "location": 2,
      "content": "这导致我只能提着行李到处走",
      "music": 0.0
    },
    {
      "from": 45.019,
      "to": 47.939,
      "sid": 20,
      "location": 2,
      "content": "但是坐这个电梯似乎有一点亏待我的行李箱",
      "music": 0.0
    },
    {
      "from": 47.939,
      "to": 49.099,
      "sid": 21,
      "location": 2,
      "content": "然后电梯门一开",
      "music": 0.0
    },
    {
      "from": 49.099,
      "to": 50.87,
      "sid": 22,
      "location": 2,
      "content": "我就目睹了这一幕",
      "music": 0.0
    },
    {
      "from": 50.87,
      "to": 53.72,
      "sid": 23,
      "location": 2,
      "content": "不再翻翻翻再翻",
      "music": 0.0
    },
    {
      "from": 55.04,
      "to": 56.9,
      "sid": 24,
      "location": 2,
      "content": "他们俩好像还打起来了",
      "music": 0.0
    },
    {
      "from": 56.9,
      "to": 58.28,
      "sid": 25,
      "location": 2,
      "content": "后排的乘客还蛮多",
      "music": 0.0
    },
    {
      "from": 58.28,
      "to": 59.52,
      "sid": 26,
      "location": 2,
      "content": "但是没有人劝架",
      "music": 0.0
    },
    {
      "from": 59.52,
      "to": 60.4,
      "sid": 27,
      "location": 2,
      "content": "最奇怪的是",
      "music": 0.0
    },
    {
      "from": 60.4,
      "to": 61.72,
      "sid": 28,
      "location": 2,
      "content": "这个车还关上了车门",
      "music": 0.0
    },
    {
      "from": 61.72,
      "to": 62.41,
      "sid": 29,
      "location": 2,
      "content": "开走了",
      "music": 0.0
    },
    {
      "from": 62.41,
      "to": 64.61,
      "sid": 30,
      "location": 2,
      "content": "我反正觉得一切都很魔幻",
      "music": 0.0
    },
    {
      "from": 64.61,
      "to": 69.44,
      "sid": 31,
      "location": 2,
      "content": "感觉这个轻轨站是闸门大开",
      "music": 0.0
    },
    {
      "from": 69.44,
      "to": 71.27,
      "sid": 32,
      "location": 2,
      "content": "付费全靠自觉",
      "music": 0.0
    },
    {
      "from": 71.27,
      "to": 73.31,
      "sid": 33,
      "location": 2,
      "content": "这个地铁站出来什么都没有",
      "music": 0.0
    },
    {
      "from": 73.31,
      "to": 75.99,
      "sid": 34,
      "location": 2,
      "content": "然后如果我要到马路另外一边的话",
      "music": 0.0
    },
    {
      "from": 75.99,
      "to": 78.58,
      "sid": 35,
      "location": 2,
      "content": "我得过这个也没有人行横道",
      "music": 0.0
    },
    {
      "from": 78.58,
      "to": 80.0,
      "sid": 36,
      "location": 2,
      "content": "这边是高速路口",
      "music": 0.0
    },
    {
      "from": 80.0,
      "to": 81.34,
      "sid": 37,
      "location": 2,
      "content": "我其实特别不喜欢",
      "music": 0.0
    },
    {
      "from": 81.34,
      "to": 83.77,
      "sid": 38,
      "location": 2,
      "content": "美国这种一切以车为主的城市规划",
      "music": 0.0
    },
    {
      "from": 83.77,
      "to": 85.05,
      "sid": 39,
      "location": 2,
      "content": "到处不是高速路",
      "music": 0.0
    },
    {
      "from": 85.05,
      "to": 87.35,
      "sid": 40,
      "location": 2,
      "content": "就是大片大片空空荡荡的停车场",
      "music": 0.0
    },
    {
      "from": 87.35,
      "to": 89.53,
      "sid": 41,
      "location": 2,
      "content": "作为一个行人和公共交通爱好者",
      "music": 0.0
    },
    {
      "from": 89.53,
      "to": 90.61,
      "sid": 42,
      "location": 2,
      "content": "我太难了",
      "music": 0.0
    },
    {
      "from": 90.61,
      "to": 92.55,
      "sid": 43,
      "location": 2,
      "content": "我经过了这边一个购物中心",
      "music": 0.0
    },
    {
      "from": 92.55,
      "to": 93.09,
      "sid": 44,
      "location": 2,
      "content": "太晚了",
      "music": 0.0
    },
    {
      "from": 93.09,
      "to": 93.83,
      "sid": 45,
      "location": 2,
      "content": "店都关了",
      "music": 0.0
    },
    {
      "from": 93.83,
      "to": 97.479,
      "sid": 46,
      "location": 2,
      "content": "我想不如去最近的加州汉堡店in and out吃个晚饭",
      "music": 0.0
    },
    {
      "from": 97.479,
      "to": 98.659,
      "sid": 47,
      "location": 2,
      "content": "但是手机一查",
      "music": 0.0
    },
    {
      "from": 98.659,
      "to": 100.699,
      "sid": 48,
      "location": 2,
      "content": "下一班公交车差不多要半个小时",
      "music": 0.0
    },
    {
      "from": 100.699,
      "to": 102.399,
      "sid": 49,
      "location": 2,
      "content": "我走过去也是半个小时",
      "music": 0.0
    },
    {
      "from": 102.399,
      "to": 104.65,
      "sid": 50,
      "location": 2,
      "content": "那我还不如去看看这边的居民区",
      "music": 0.0
    },
    {
      "from": 104.65,
      "to": 105.69,
      "sid": 51,
      "location": 2,
      "content": "我后面查了一下",
      "music": 0.0
    },
    {
      "from": 105.69,
      "to": 107.33,
      "sid": 52,
      "location": 2,
      "content": "这个城市叫做英格五",
      "music": 0.0
    },
    {
      "from": 107.33,
      "to": 110.83,
      "sid": 53,
      "location": 2,
      "content": "是一个黑人和拉美人为主的工薪阶层社区",
      "music": 0.0
    },
    {
      "from": 110.83,
      "to": 113.73,
      "sid": 54,
      "location": 2,
      "content": "所以说这边大多都是这些矮矮的小平房",
      "music": 0.0
    },
    {
      "from": 113.73,
      "to": 116.37,
      "sid": 55,
      "location": 2,
      "content": "而不是网上说的那种加州豪宅",
      "music": 0.0
    },
    {
      "from": 116.37,
      "to": 118.33,
      "sid": 56,
      "location": 2,
      "content": "我其实没有走离机场太远",
      "music": 0.0
    },
    {
      "from": 118.33,
      "to": 120.479,
      "sid": 57,
      "location": 2,
      "content": "抬头时不时都能看到大飞机",
      "music": 0.0
    },
    {
      "from": 120.479,
      "to": 122.199,
      "sid": 58,
      "location": 2,
      "content": "一开始我还非常的兴奋",
      "music": 0.0
    },
    {
      "from": 122.199,
      "to": 123.519,
      "sid": 59,
      "location": 2,
      "content": "但是看了四五架之后",
      "music": 0.0
    },
    {
      "from": 123.519,
      "to": 124.719,
      "sid": 60,
      "location": 2,
      "content": "我也渐渐腻了",
      "music": 0.0
    },
    {
      "from": 124.719,
      "to": 128.119,
      "sid": 61,
      "location": 2,
      "content": "想必这边的居民天天苦于噪声所扰",
      "music": 0.0
    },
    {
      "from": 139.66,
      "to": 142.34,
      "sid": 62,
      "location": 2,
      "content": "这什么morning side high school",
      "music": 0.0
    },
    {
      "from": 143.709,
      "to": 146.81,
      "sid": 63,
      "location": 2,
      "content": "看着像一个关犯人的地方",
      "music": 0.0
    },
    {
      "from": 147.25,
      "to": 148.17,
      "sid": 64,
      "location": 2,
      "content": "高州头上",
      "music": 0.0
    },
    {
      "from": 148.17,
      "to": 152.95,
      "sid": 65,
      "location": 2,
      "content": "我拖着我的箱子来吃这个加州云菜",
      "music": 0.0
    },
    {
      "from": 152.95,
      "to": 155.29,
      "sid": 66,
      "location": 2,
      "content": "这么多人排队都是车",
      "music": 0.0
    },
    {
      "from": 155.29,
      "to": 159.06,
      "sid": 67,
      "location": 2,
      "content": "现在我这个步行的优势就体现出来了",
      "music": 0.0
    },
    {
      "from": 176.74,
      "to": 179.079,
      "sid": 68,
      "location": 2,
      "content": "我又买了一个汉堡和一个薯条",
      "music": 0.0
    },
    {
      "from": 179.079,
      "to": 181.499,
      "sid": 69,
      "location": 2,
      "content": "然后这个小辣椒还蛮开胃的",
      "music": 0.0
    },
    {
      "from": 181.499,
      "to": 185.059,
      "sid": 70,
      "location": 2,
      "content": "我又拿了四个在这里坐着啃",
      "music": 0.0
    },
    {
      "from": 185.059,
      "to": 186.97,
      "sid": 71,
      "location": 2,
      "content": "反正也没有别的事情",
      "music": 0.0
    },
    {
      "from": 186.97,
      "to": 189.19,
      "sid": 72,
      "location": 2,
      "content": "这个配上怡宝矿泉水",
      "music": 0.0
    },
    {
      "from": 189.19,
      "to": 190.39,
      "sid": 73,
      "location": 2,
      "content": "是不是有点假",
      "music": 0.0
    },
    {
      "from": 190.39,
      "to": 192.17,
      "sid": 74,
      "location": 2,
      "content": "看起",
      "music": 0.0
    },
    {
      "from": 193.5,
      "to": 195.48,
      "sid": 75,
      "location": 2,
      "content": "我在店里面坐了两个小时",
      "music": 0.0
    },
    {
      "from": 195.48,
      "to": 196.26,
      "sid": 76,
      "location": 2,
      "content": "12点了",
      "music": 0.0
    },
    {
      "from": 196.26,
      "to": 197.3,
      "sid": 77,
      "location": 2,
      "content": "一个人都没有了",
      "music": 0.0
    },
    {
      "from": 197.3,
      "to": 199.1,
      "sid": 78,
      "location": 2,
      "content": "这边的公交车一个小时一班",
      "music": 0.0
    },
    {
      "from": 199.1,
      "to": 200.75,
      "sid": 79,
      "location": 2,
      "content": "我来的时候刚走一班",
      "music": 0.0
    },
    {
      "from": 200.75,
      "to": 202.69,
      "sid": 80,
      "location": 2,
      "content": "吃完了玩手机又悟了一半了",
      "music": 0.0
    },
    {
      "from": 202.69,
      "to": 204.01,
      "sid": 81,
      "location": 2,
      "content": "现在我真得走了",
      "music": 0.0
    },
    {
      "from": 204.01,
      "to": 204.69,
      "sid": 82,
      "location": 2,
      "content": "嘿嘿",
      "music": 0.8421048199448237
    },
    {
      "from": 204.69,
      "to": 209.61,
      "sid": 83,
      "location": 2,
      "content": "How much are ten dollars and twenty dollars",
      "music": 0.0
    },
    {
      "from": 209.61,
      "to": 210.57,
      "sid": 84,
      "location": 2,
      "content": "Ten dollars",
      "music": 0.0
    },
    {
      "from": 210.57,
      "to": 211.09,
      "sid": 85,
      "location": 2,
      "content": "Five dollars",
      "music": 0.0
    },
    {
      "from": 211.09,
      "to": 212.71,
      "sid": 86,
      "location": 2,
      "content": "One rose good",
      "music": 0.0
    },
    {
      "from": 212.71,
      "to": 214.225,
      "sid": 87,
      "location": 2,
      "content": "Thank you of",
      "music": 0.0
    },
    {
      "from": 227.12,
      "to": 229.04,
      "sid": 88,
      "location": 2,
      "content": "这个公交车说是说到机场",
      "music": 0.0
    },
    {
      "from": 229.04,
      "to": 231.18,
      "sid": 89,
      "location": 2,
      "content": "但是他其实不把你送到航站楼",
      "music": 0.0
    },
    {
      "from": 231.18,
      "to": 232.96,
      "sid": 90,
      "location": 2,
      "content": "而是把人放在一个公路口",
      "music": 0.0
    },
    {
      "from": 232.96,
      "to": 234.66,
      "sid": 91,
      "location": 2,
      "content": "你得自己想办法走进去",
      "music": 0.0
    },
    {
      "from": 234.66,
      "to": 236.46,
      "sid": 92,
      "location": 2,
      "content": "我看前面这个提着行李的大爷",
      "music": 0.0
    },
    {
      "from": 236.46,
      "to": 238.62,
      "sid": 93,
      "location": 2,
      "content": "在一个荒郊野岭的地方下车了",
      "music": 0.0
    },
    {
      "from": 238.62,
      "to": 239.7,
      "sid": 94,
      "location": 2,
      "content": "我立刻感觉不对",
      "music": 0.0
    },
    {
      "from": 239.7,
      "to": 240.84,
      "sid": 95,
      "location": 2,
      "content": "也跟着下去了",
      "music": 0.0
    },
    {
      "from": 240.84,
      "to": 242.26,
      "sid": 96,
      "location": 2,
      "content": "这边也时不时可以遇到",
      "music": 0.0
    },
    {
      "from": 242.26,
      "to": 244.43,
      "sid": 97,
      "location": 2,
      "content": "看着像机场上班的工作人员",
      "music": 0.0
    },
    {
      "from": 244.43,
      "to": 246.29,
      "sid": 98,
      "location": 2,
      "content": "然后就像一个跟踪狂一样",
      "music": 0.0
    },
    {
      "from": 246.29,
      "to": 247.47,
      "sid": 99,
      "location": 2,
      "content": "一路跟着他走",
      "music": 0.0
    },
    {
      "from": 247.47,
      "to": 249.41,
      "sid": 100,
      "location": 2,
      "content": "后面还是主动跟他搭话了",
      "music": 0.0
    },
    {
      "from": 249.41,
      "to": 250.59,
      "sid": 101,
      "location": 2,
      "content": "他很自豪的跟我说",
      "music": 0.0
    },
    {
      "from": 250.59,
      "to": 253.47,
      "sid": 102,
      "location": 2,
      "content": "这是只有很少人知道的小众路线",
      "music": 0.0
    },
    {
      "from": 261.76,
      "to": 263.84,
      "sid": 103,
      "location": 2,
      "content": "我大概是凌晨一点到的机场",
      "music": 0.0
    },
    {
      "from": 263.84,
      "to": 266.44,
      "sid": 104,
      "location": 2,
      "content": "平时熙熙攘攘的值机柜台和行李转盘",
      "music": 0.0
    },
    {
      "from": 266.44,
      "to": 268.28,
      "sid": 105,
      "location": 2,
      "content": "都是空空荡荡",
      "music": 0.0
    },
    {
      "from": 272.48,
      "to": 274.48,
      "sid": 106,
      "location": 2,
      "content": "而机场的电梯也不运行了",
      "music": 0.0
    },
    {
      "from": 274.48,
      "to": 276.92,
      "sid": 107,
      "location": 2,
      "content": "现在还留着的大多是机场的工作人员",
      "music": 0.0
    },
    {
      "from": 276.92,
      "to": 279.2,
      "sid": 108,
      "location": 2,
      "content": "这几辆也是只有工作人员才能上的",
      "music": 0.0
    },
    {
