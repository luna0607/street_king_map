  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.08,
      "to": 1.16,
      "sid": 1,
      "location": 2,
      "content": "在一个夏日的午后",
      "music": 0.0
    },
    {
      "from": 1.16,
      "to": 3.12,
      "sid": 2,
      "location": 2,
      "content": "来到了美国人口最少的村子",
      "music": 0.0
    },
    {
      "from": 3.12,
      "to": 6.33,
      "sid": 3,
      "location": 2,
      "content": "仅有一名居民的内布拉斯加州小镇莫诺维",
      "music": 0.0
    },
    {
      "from": 6.33,
      "to": 9.58,
      "sid": 4,
      "location": 2,
      "content": "这里在1930年曾经是100多人的小村庄",
      "music": 0.0
    },
    {
      "from": 9.58,
      "to": 12.02,
      "sid": 5,
      "location": 2,
      "content": "但是随着这一块地区的人口减少",
      "music": 0.0
    },
    {
      "from": 12.02,
      "to": 13.92,
      "sid": 6,
      "location": 2,
      "content": "这里现在只剩下了一个人",
      "music": 0.0
    },
    {
      "from": 13.92,
      "to": 16.62,
      "sid": 7,
      "location": 2,
      "content": "也就是莫洛维小酒版的老板埃尔希",
      "music": 0.0
    },
    {
      "from": 16.62,
      "to": 19.52,
      "sid": 8,
      "location": 2,
      "content": "由于小村还保留着当年的法律建制",
      "music": 0.0
    },
    {
      "from": 19.52,
      "to": 21.84,
      "sid": 9,
      "location": 2,
      "content": "阿尔西算是这边的村长警长",
      "music": 0.0
    },
    {
      "from": 21.84,
      "to": 22.78,
      "sid": 10,
      "location": 2,
      "content": "图书管理员",
      "music": 0.0
    },
    {
      "from": 22.78,
      "to": 25.14,
      "sid": 11,
      "location": 2,
      "content": "或者说任何他想自己封的称号",
      "music": 0.0
    },
    {
      "from": 25.14,
      "to": 27.93,
      "sid": 12,
      "location": 2,
      "content": "不过他确实自己得处理很多行政工作",
      "music": 0.0
    },
    {
      "from": 27.93,
      "to": 30.51,
      "sid": 13,
      "location": 2,
      "content": "比如说卖酒的许可收税",
      "music": 0.0
    },
    {
      "from": 30.51,
      "to": 32.59,
      "sid": 14,
      "location": 2,
      "content": "以及向上级政府申请拨款",
      "music": 0.0
    },
    {
      "from": 32.59,
      "to": 33.989,
      "sid": 15,
      "location": 2,
      "content": "维护村里面的道路",
      "music": 0.0
    },
    {
      "from": 33.989,
      "to": 35.409,
      "sid": 16,
      "location": 2,
      "content": "进到小酒馆里面",
      "music": 0.0
    },
    {
      "from": 35.409,
      "to": 37.369,
      "sid": 17,
      "location": 2,
      "content": "这边墙上展示的算是莫诺维",
      "music": 0.0
    },
    {
      "from": 37.369,
      "to": 40.19,
      "sid": 18,
      "location": 2,
      "content": "或者说阿尔西关于自己一生的小博物馆",
      "music": 0.0
    },
    {
      "from": 40.19,
      "to": 41.35,
      "sid": 19,
      "location": 2,
      "content": "在2000年的时候",
      "music": 0.0
    },
    {
      "from": 41.35,
      "to": 42.99,
      "sid": 20,
      "location": 2,
      "content": "莫洛维曾经有两个居民",
      "music": 0.0
    },
    {
      "from": 42.99,
      "to": 44.98,
      "sid": 21,
      "location": 2,
      "content": "阿尔西和他的丈夫卢比",
      "music": 0.0
    },
    {
      "from": 44.98,
      "to": 46.66,
      "sid": 22,
      "location": 2,
      "content": "也就是桥上面的合照",
      "music": 0.0
    },
    {
      "from": 46.66,
      "to": 48.78,
      "sid": 23,
      "location": 2,
      "content": "卢比在2004年去世了之后",
      "music": 0.0
    },
    {
      "from": 48.78,
      "to": 51.02,
      "sid": 24,
      "location": 2,
      "content": "阿尔西就是一个人经营这家小酒馆",
      "music": 0.0
    },
    {
      "from": 51.02,
      "to": 52.74,
      "sid": 25,
      "location": 2,
      "content": "虽然说只有一个人的小村庄",
      "music": 0.0
    },
    {
      "from": 52.74,
      "to": 53.95,
      "sid": 26,
      "location": 2,
      "content": "听起来很孤单",
      "music": 0.0
    },
    {
      "from": 53.95,
      "to": 55.91,
      "sid": 27,
      "location": 2,
      "content": "但是莫洛维就在公路旁边",
      "music": 0.0
    },
    {
      "from": 55.91,
      "to": 58.97,
      "sid": 28,
      "location": 2,
      "content": "而且它是方圆20km内唯一的一家餐厅",
      "music": 0.0
    },
    {
      "from": 58.97,
      "to": 60.41,
      "sid": 29,
      "location": 2,
      "content": "很多开车经过的人",
      "music": 0.0
    },
    {
      "from": 60.41,
      "to": 62.21,
      "sid": 30,
      "location": 2,
      "content": "或者在附近农田里面干活的",
      "music": 0.0
    },
    {
      "from": 62.21,
      "to": 63.65,
      "sid": 31,
      "location": 2,
      "content": "中午都会来这边吃饭",
      "music": 0.0
    },
    {
      "from": 63.65,
      "to": 65.05,
      "sid": 32,
      "location": 2,
      "content": "所以说我刚进去的时候",
      "music": 0.0
    },
    {
      "from": 65.05,
      "to": 66.58,
      "sid": 33,
      "location": 2,
      "content": "里面其实非常的热闹",
      "music": 0.0
    },
    {
      "from": 66.58,
      "to": 68.32,
      "sid": 34,
      "location": 2,
      "content": "这也导致阿尔西非常的忙",
      "music": 0.0
    },
    {
      "from": 68.32,
      "to": 70.2,
      "sid": 35,
      "location": 2,
      "content": "我就边吃我的三明治边等",
      "music": 0.0
    },
    {
      "from": 70.2,
      "to": 73.03,
      "sid": 36,
      "location": 2,
      "content": "但是我也一直没有找到单独跟他搭话的时机",
      "music": 0.0
    },
    {
      "from": 73.03,
      "to": 75.51,
      "sid": 37,
      "location": 2,
      "content": "不过其实阿尔西应该算这一片地区里",
      "music": 0.0
    },
    {
      "from": 75.51,
      "to": 76.39,
      "sid": 38,
      "location": 2,
      "content": "最有名的人",
      "music": 0.0
    },
    {
      "from": 76.39,
      "to": 79.07,
      "sid": 39,
      "location": 2,
      "content": "很多我好奇的问题之前都有人问过了",
      "music": 0.0
    },
    {
      "from": 79.07,
      "to": 81.15,
      "sid": 40,
      "location": 2,
      "content": "比如说一个人在这么一个小村子里面",
      "music": 0.0
    },
    {
      "from": 81.15,
      "to": 82.1,
      "sid": 41,
      "location": 2,
      "content": "会不会孤单",
      "music": 0.0
    },
    {
      "from": 82.1,
      "to": 84.52,
      "sid": 42,
      "location": 2,
      "content": "其实阿尔西年轻的时候在堪萨斯城",
      "music": 0.0
    },
    {
      "from": 84.52,
      "to": 86.44,
      "sid": 43,
      "location": 2,
      "content": "达拉斯这种大城市里面住过",
      "music": 0.0
    },
    {
      "from": 86.44,
      "to": 87.58,
      "sid": 44,
      "location": 2,
      "content": "只是说年纪大了",
      "music": 0.0
    },
    {
      "from": 87.58,
      "to": 89.42,
      "sid": 45,
      "location": 2,
      "content": "他更喜欢回到安静的乡下",
      "music": 0.0
    },
    {
      "from": 89.42,
      "to": 92.34,
      "sid": 46,
      "location": 2,
      "content": "这里也是她和丈夫卢比一起长大的地方",
      "music": 0.0
    },
    {
      "from": 92.34,
      "to": 93.9,
      "sid": 47,
      "location": 2,
      "content": "在卢比去世了之后",
      "music": 0.0
    },
    {
      "from": 93.9,
      "to": 96.1,
      "sid": 48,
      "location": 2,
      "content": "阿尔西在摩诺维建立一个图书馆",
      "music": 0.0
    },
    {
      "from": 96.1,
      "to": 97.92,
      "sid": 49,
      "location": 2,
      "content": "里面放的都是卢比的藏书",
      "music": 0.0
    },
    {
      "from": 97.92,
      "to": 100.02,
      "sid": 50,
      "location": 2,
      "content": "图书馆左侧是阿尔希的家",
      "music": 0.0
    },
    {
      "from": 100.02,
      "to": 101.7,
      "sid": 51,
      "location": 2,
      "content": "而右侧就是小酒馆了",
      "music": 0.0
    },
    {
      "from": 101.7,
      "to": 103.82,
      "sid": 52,
      "location": 2,
      "content": "这些也就是莫诺维的全部了",
      "music": 0.0
    },
    {
      "from": 103.82,
      "to": 104.68,
      "sid": 53,
      "location": 2,
      "content": "除了小镇",
      "music": 0.0
    },
    {
      "from": 104.68,
      "to": 107.01,
      "sid": 54,
      "location": 2,
      "content": "公路两边都是无穷无尽的田野",
      "music": 0.0
    },
    {
      "from": 107.01,
      "to": 110.09,
      "sid": 55,
      "location": 2,
      "content": "估计现在冬天应该都已经是白雪覆盖了",
      "music": 0.0
    },
    {
      "from": 110.09,
      "to": 113.05,
      "sid": 56,
      "location": 2,
      "content": "其实这种路开久了也很容易视觉疲劳",
      "music": 0.0
    },
    {
      "from": 113.05,
      "to": 114.78,
      "sid": 57,
      "location": 2,
      "content": "风景有一些单调",
      "music": 0.0
    },
    {
      "from": 114.78,
      "to": 116.78,
      "sid": 58,
      "location": 2,
      "content": "而且对面除了偶尔有卡车",
      "music": 0.0
    },
    {
      "from": 116.78,
      "to": 118.08,
      "sid": 59,
      "location": 2,
      "content": "基本上没有来车",
      "music": 0.0
    },
    {
      "from": 118.08,
      "to": 120.78,
      "sid": 60,
      "location": 2,
      "content": "于是我就随便找了一个路边休息了一下",
      "music": 0.0
    },
    {
      "from": 120.78,
      "to": 122.5,
      "sid": 61,
      "location": 2,
      "content": "像是公路边的这种小岔路",
      "music": 0.0
    },
    {
      "from": 122.5,
      "to": 123.7,
      "sid": 62,
      "location": 2,
      "content": "就没有人维护了",
      "music": 0.0
    },
    {
      "from": 123.7,
      "to": 124.92,
      "sid": 63,
      "location": 2,
      "content": "如果没有皮卡",
      "music": 0.0
    },
    {
      "from": 124.92,
      "to": 127.8,
      "sid": 64,
      "location": 2,
      "content": "像我这样的小轿车是没有办法开得进去的",
      "music": 0.0
    },
    {
      "from": 127.8,
      "to": 129.34,
      "sid": 65,
      "location": 2,
      "content": "莫洛维这样的异人村庄",
      "music": 0.0
    },
    {
      "from": 129.34,
      "to": 131.29,
      "sid": 66,
      "location": 2,
      "content": "算是一个比较极端的案例",
      "music": 0.0
    },
    {
      "from": 131.29,
      "to": 134.33,
      "sid": 67,
      "location": 2,
      "content": "但是它也算是这片地区人口流失的一个缩影",
      "music": 0.0
    },
    {
      "from": 134.33,
      "to": 136.01,
      "sid": 68,
      "location": 2,
      "content": "从莫洛维往东开8分钟",
      "music": 0.0
    },
    {
      "from": 136.01,
      "to": 137.57,
      "sid": 69,
      "location": 2,
      "content": "就到了38人的小村庄",
      "music": 0.0
    },
    {
      "from": 137.57,
      "to": 138.23,
      "sid": 70,
      "location": 2,
      "content": "福德尔",
      "music": 0.0
    },
    {
      "from": 138.23,
      "to": 139.51,
      "sid": 71,
      "location": 2,
      "content": "这里和穆洛维一样",
      "music": 0.0
    },
    {
      "from": 139.51,
      "to": 141.03,
      "sid": 72,
      "location": 2,
      "content": "所有的居民都是白人",
      "music": 0.0
    },
    {
      "from": 141.03,
      "to": 143.11,
      "sid": 73,
      "location": 2,
      "content": "这条公路就是村子的主干道",
      "music": 0.0
    },
    {
      "from": 143.11,
      "to": 146.079,
      "sid": 74,
      "location": 2,
      "content": "但是由于这一块基本上没有什么经过的车流",
      "music": 0.0
    },
    {
      "from": 146.079,
      "to": 146.439,
      "sid": 75,
      "location": 2,
      "content": "路",
      "music": 0.0
    },
    {
      "from": 146.439,
      "to": 148.559,
      "sid": 76,
      "location": 2,
      "content": "两边的商业基本上都是荒废了",
      "music": 0.0
    },
    {
      "from": 148.559,
      "to": 149.539,
      "sid": 77,
      "location": 2,
      "content": "相比之下",
      "music": 0.0
    },
    {
      "from": 149.539,
      "to": 153.04,
      "sid": 78,
      "location": 2,
      "content": "有一个小酒馆的莫洛维反倒是没有这么的萧条",
      "music": 0.0
    },
    {
      "from": 153.04,
      "to": 156.12,
      "sid": 79,
      "location": 2,
      "content": "福特尔和莫诺维曾经在同一条铁路线上",
      "music": 0.0
    },
    {
      "from": 156.12,
      "to": 158.16,
      "sid": 80,
      "location": 2,
      "content": "这一条铁路废弃了之后",
      "music": 0.0
    },
    {
      "from": 158.16,
      "to": 159.46,
      "sid": 81,
      "location": 2,
      "content": "很多人都离开了",
      "music": 0.0
    },
    {
      "from": 159.46,
      "to": 162.18,
      "sid": 82,
      "location": 2,
      "content": "只剩下了老人和周围做农业工作的",
      "music": 0.0
    },
    {
      "from": 162.18,
      "to": 164.41,
      "sid": 83,
      "location": 2,
      "content": "像是福德尔所在的诺克斯县",
      "music": 0.0
    },
    {
      "from": 164.41,
      "to": 167.29,
      "sid": 84,
      "location": 2,
      "content": "人口在1930年达到1万9的巅峰期之后",
      "music": 0.0
    },
    {
      "from": 167.29,
      "to": 168.45,
      "sid": 85,
      "location": 2,
      "content": "每年都在减少",
      "music": 0.0
    },
    {
      "from": 168.45,
      "to": 170.6,
      "sid": 86,
      "location": 2,
      "content": "现在只剩下8300人",
      "music": 0.0
    },
    {
      "from": 170.6,
      "to": 172.4,
      "sid": 87,
      "location": 2,
      "content": "而我之后要去的诺克斯县",
      "music": 0.0
    },
    {
      "from": 172.4,
      "to": 174.73,
      "sid": 88,
      "location": 2,
      "content": "县城森特也就只有73个人",
      "music": 0.0
    },
    {
      "from": 174.73,
      "to": 175.97,
      "sid": 89,
      "location": 2,
      "content": "经常看B友评论说",
      "music": 0.0
    },
    {
      "from": 175.97,
      "to": 178.81,
      "sid": 90,
      "location": 2,
      "content": "这样的半废弃小镇很适合当恐怖电影的取景地",
      "music": 0.0
    },
    {
      "from": 178.81,
      "to": 181.5,
      "sid": 91,
      "location": 2,
      "content": "美国确实有很多小镇主题的恐怖惊悚片",
      "music": 0.0
    },
    {
      "from": 181.5,
      "to": 183.2,
      "sid": 92,
      "location": 2,
      "content": "像是寂静岭逃出绝命镇",
      "music": 0.0
    },
    {
      "from": 183.2,
      "to": 185.2,
      "sid": 93,
      "location": 2,
      "content": "怪奇物语都是和小镇相关的故事",
      "music": 0.0
    },
    {
      "from": 185.2,
      "to": 187.94,
      "sid": 94,
      "location": 2,
      "content": "很多朋友通过看剧看电影的方式去学习英语",
      "music": 0.0
    },
    {
      "from": 187.94,
      "to": 189.5,
      "sid": 95,
      "location": 2,
      "content": "但是剧情很精彩的影视作品",
      "music": 0.0
    },
    {
      "from": 189.5,
      "to": 191.86,
      "sid": 96,
      "location": 2,
      "content": "很容易让人沉浸在剧情中忘记学习",
      "music": 0.0
    },
    {
      "from": 191.86,
      "to": 192.66,
      "sid": 97,
      "location": 2,
      "content": "最近这段时间",
      "music": 0.0
    },
    {
      "from": 192.66,
      "to": 194.9,
      "sid": 98,
      "location": 2,
      "content": "我用知识派听力app看无字幕电影",
      "music": 0.0
    },
    {
      "from": 194.9,
      "to": 196.6,
      "sid": 99,
      "location": 2,
      "content": "学习英语效果很不错",
      "music": 0.0
    },
    {
      "from": 196.6,
      "to": 198.99,
      "sid": 100,
      "location": 2,
      "content": "这个app汇集了丰富的电影资源",
      "music": 0.0
    },
    {
      "from": 198.99,
      "to": 200.47,
      "sid": 101,
      "location": 2,
      "content": "还有海量新闻广播剧",
      "music": 0.0
    },
    {
      "from": 200.47,
      "to": 200.93,
      "sid": 102,
      "location": 2,
      "content": "美剧",
      "music": 0.0
    },
    {
      "from": 200.93,
      "to": 203.19,
      "sid": 103,
      "location": 2,
      "content": "通过知识点讲解重点单词背诵",
      "music": 0.0
    },
    {
      "from": 203.19,
      "to": 205.13,
      "sid": 104,
      "location": 2,
      "content": "帮助你无字幕听懂英美剧",
      "music": 0.0
    },
    {
      "from": 205.13,
      "to": 207.61,
      "sid": 105,
      "location": 2,
      "content": "在戏曲中学习英语和锻炼听力水平",
      "music": 0.0
    },
    {
      "from": 207.61,
