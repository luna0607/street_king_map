  "body": [
    {
      "from": 0.1,
      "to": 1.78,
      "sid": 1,
      "location": 2,
      "content": "基特来到了利亚巴尔地摩",
      "music": 0.0
    },
    {
      "from": 1.78,
      "to": 4.2,
      "sid": 2,
      "location": 2,
      "content": "获得美国谋杀之都称号的圣路易斯中",
      "music": 0.0
    },
    {
      "from": 4.2,
      "to": 5.62,
      "sid": 3,
      "location": 2,
      "content": "犯罪率最高的区之一",
      "music": 0.0
    },
    {
      "from": 5.62,
      "to": 6.22,
      "sid": 4,
      "location": 2,
      "content": "The view",
      "music": 0.0
    },
    {
      "from": 6.22,
      "to": 8.84,
      "sid": 5,
      "location": 2,
      "content": "整个圣路易斯是42.8%黑人",
      "music": 0.0
    },
    {
      "from": 8.84,
      "to": 10.88,
      "sid": 6,
      "location": 2,
      "content": "而这个区是96%黑人",
      "music": 0.0
    },
    {
      "from": 10.88,
      "to": 11.88,
      "sid": 7,
      "location": 2,
      "content": "打开犯罪地图",
      "music": 0.0
    },
    {
      "from": 11.88,
      "to": 14.33,
      "sid": 8,
      "location": 2,
      "content": "看这边似乎没有一寸土地是安全的",
      "music": 0.0
    },
    {
      "from": 14.33,
      "to": 15.89,
      "sid": 9,
      "location": 2,
      "content": "全部都是F评级",
      "music": 0.0
    },
    {
      "from": 15.89,
      "to": 17.93,
      "sid": 10,
      "location": 2,
      "content": "我拍摄用的手机都被震了下来",
      "music": 0.0
    },
    {
      "from": 17.93,
      "to": 20.05,
      "sid": 11,
      "location": 2,
      "content": "毕竟路况实在是有一点颠簸",
      "music": 0.0
    },
    {
      "from": 20.05,
      "to": 21.85,
      "sid": 12,
      "location": 2,
      "content": "路两旁的破房子也很多",
      "music": 0.0
    },
    {
      "from": 21.85,
      "to": 23.47,
      "sid": 13,
      "location": 2,
      "content": "不过在这个路口拐一个弯",
      "music": 0.0
    },
    {
      "from": 23.47,
      "to": 24.89,
      "sid": 14,
      "location": 2,
      "content": "面前出现的这个建筑",
      "music": 0.0
    },
    {
      "from": 24.89,
      "to": 27.06,
      "sid": 15,
      "location": 2,
      "content": "似乎和周围的环境不是太搭啊",
      "music": 0.0
    },
    {
      "from": 27.06,
      "to": 29.22,
      "sid": 16,
      "location": 2,
      "content": "我现在进去看看是什么个情况",
      "music": 0.0
    },
    {
      "from": 29.22,
      "to": 31.42,
      "sid": 17,
      "location": 2,
      "content": "这期带了个对黑人文化感兴趣的B友",
      "music": 0.0
    },
    {
      "from": 31.42,
      "to": 32.48,
      "sid": 18,
      "location": 2,
      "content": "一起体验一下",
      "music": 0.0
    },
    {
      "from": 32.48,
      "to": 35.489,
      "sid": 19,
      "location": 2,
      "content": "我们一进门就被一对当地人给团团围住了",
      "music": 0.0
    },
    {
      "from": 35.489,
      "to": 38.589,
      "sid": 20,
      "location": 2,
      "content": "毕竟我们这些中国人在这边肯定是稀有物种",
      "music": 0.0
    },
    {
      "from": 38.589,
      "to": 40.83,
      "sid": 21,
      "location": 2,
      "content": "他们真的对我们是超级友好",
      "music": 0.0
    },
    {
      "from": 40.83,
      "to": 43.83,
      "sid": 22,
      "location": 2,
      "content": "以至于我根本没有时间掏出相机来录视频",
      "music": 0.0
    },
    {
      "from": 43.83,
      "to": 46.69,
      "sid": 23,
      "location": 2,
      "content": "他这个进门的大厅里面不止有一个小喷泉",
      "music": 0.0
    },
    {
      "from": 46.69,
      "to": 48.65,
      "sid": 24,
      "location": 2,
      "content": "还有不少花花草草什么的",
      "music": 0.0
    },
    {
      "from": 48.65,
      "to": 50.07,
      "sid": 25,
      "location": 2,
      "content": "可惜我忘记拍了",
      "music": 0.0
    },
    {
      "from": 50.07,
      "to": 52.51,
      "sid": 26,
      "location": 2,
      "content": "然后他这个礼拜堂里面是非常的嗨啊",
      "music": 0.0
    },
    {
      "from": 52.51,
      "to": 55.17,
      "sid": 27,
      "location": 2,
      "content": "感觉更像是在开演唱会",
      "music": 0.0
    },
    {
      "from": 61.38,
      "to": 62.86,
      "sid": 28,
      "location": 2,
      "content": "大家唱完歌之后呢",
      "music": 0.0
    },
    {
      "from": 62.86,
      "to": 64.16,
      "sid": 29,
      "location": 2,
      "content": "还有一个捐款环节",
      "music": 0.0
    },
    {
      "from": 64.16,
      "to": 65.46,
      "sid": 30,
      "location": 2,
      "content": "像是这种小教会的",
      "music": 0.0
    },
    {
      "from": 65.46,
      "to": 67.96,
      "sid": 31,
      "location": 2,
      "content": "所有收入都是要靠普通人的小捐赠的",
      "music": 0.0
    },
    {
      "from": 67.96,
      "to": 70.4,
      "sid": 32,
      "location": 2,
      "content": "看这个建筑能在the view区维护的这么好",
      "music": 0.0
    },
    {
      "from": 70.53,
      "to": 72.88,
      "sid": 33,
      "location": 2,
      "content": "想必当地人都是非常的虔诚啊",
      "music": 0.0
    },
    {
      "from": 72.88,
      "to": 74.66,
      "sid": 34,
      "location": 2,
      "content": "同行的庇佑也被感化了",
      "music": 0.0
    },
    {
      "from": 74.66,
      "to": 81.0,
      "sid": 35,
      "location": 2,
      "content": "去献了一份爱心爱心",
      "music": 0.6432748349919629
    },
    {
      "from": 81.809,
      "to": 84.689,
      "sid": 36,
      "location": 2,
      "content": "一般来说这周礼拜过后都是有免费的饭吃的",
      "music": 0.0
    },
    {
      "from": 84.689,
      "to": 86.96,
      "sid": 37,
      "location": 2,
      "content": "这边这个长老还让我们留下来吃饭",
      "music": 0.0
    },
    {
      "from": 86.96,
      "to": 89.52,
      "sid": 38,
      "location": 2,
      "content": "之前我在黑人农村教会那一期里面展示过",
      "music": 0.0
    },
    {
      "from": 89.52,
      "to": 90.34,
      "sid": 39,
      "location": 2,
      "content": "他们的午饭",
      "music": 0.0
    },
    {
      "from": 90.34,
      "to": 92.24,
      "sid": 40,
      "location": 2,
      "content": "无论你是什么人都可以去吃",
      "music": 0.0
    },
    {
      "from": 92.24,
      "to": 93.9,
      "sid": 41,
      "location": 2,
      "content": "像是讲师里的很多餐",
      "music": 0.0
    },
    {
      "from": 93.9,
      "to": 95.28,
      "sid": 42,
      "location": 2,
      "content": "还有免费物资之类的",
      "music": 0.0
    },
    {
      "from": 95.28,
      "to": 97.2,
      "sid": 43,
      "location": 2,
      "content": "大部分都是类似的组织搞的",
      "music": 0.0
    },
    {
      "from": 97.2,
      "to": 98.78,
      "sid": 44,
      "location": 2,
      "content": "因为我当天另有计划",
      "music": 0.0
    },
    {
      "from": 98.78,
      "to": 100.06,
      "sid": 45,
      "location": 2,
      "content": "于是我就先溜了",
      "music": 0.0
    },
    {
      "from": 100.06,
      "to": 102.8,
      "sid": 46,
      "location": 2,
      "content": "结果他们这个长老还特地跑出来送我们一程",
      "music": 0.0
    },
    {
      "from": 102.8,
      "to": 105.74,
      "sid": 47,
      "location": 2,
      "content": "其实教会在黑人族群中是非常重要的存在",
      "music": 0.0
    },
    {
      "from": 105.74,
      "to": 106.42,
      "sid": 48,
      "location": 2,
      "content": "在美国",
      "music": 0.0
    },
    {
      "from": 106.42,
      "to": 109.48,
      "sid": 49,
      "location": 2,
      "content": "91%的黑人认同宗教对生活的重要性",
      "music": 0.0
    },
    {
      "from": 109.48,
      "to": 110.3,
      "sid": 50,
      "location": 2,
      "content": "相比之下",
      "music": 0.0
    },
    {
      "from": 110.3,
      "to": 112.44,
      "sid": 51,
      "location": 2,
      "content": "只有75%的白人这么认为",
      "music": 0.0
    },
    {
      "from": 112.44,
      "to": 114.2,
      "sid": 52,
      "location": 2,
      "content": "黑人这么虔诚的很大原因",
      "music": 0.0
    },
    {
      "from": 114.2,
      "to": 114.36,
      "sid": 53,
      "location": 2,
      "content": "就是",
      "music": 0.0
    },
    {
      "from": 114.36,
      "to": 117.38,
      "sid": 54,
      "location": 2,
      "content": "因为他们在历史上一直受到各种歧视和压迫",
      "music": 0.0
    },
    {
      "from": 117.38,
      "to": 119.2,
      "sid": 55,
      "location": 2,
      "content": "要是没有宗教的精神慰藉",
      "music": 0.0
    },
    {
      "from": 119.2,
      "to": 121.06,
      "sid": 56,
      "location": 2,
      "content": "生活就根本没有希望了",
      "music": 0.0
    },
    {
      "from": 121.06,
      "to": 123.39,
      "sid": 57,
      "location": 2,
      "content": "而且教会的社区功能也很重要",
      "music": 0.0
    },
    {
      "from": 123.39,
      "to": 126.41,
      "sid": 58,
      "location": 2,
      "content": "像是当年明确运动中的玛丽路德金就是牧师",
      "music": 0.0
    },
    {
      "from": 126.41,
      "to": 127.85,
      "sid": 59,
      "location": 2,
      "content": "我刚刚去的那个教会",
      "music": 0.0
    },
    {
      "from": 127.85,
      "to": 129.59,
      "sid": 60,
      "location": 2,
      "content": "除了会搞搞讲师参之外",
      "music": 0.0
    },
    {
      "from": 129.59,
      "to": 132.11,
      "sid": 61,
      "location": 2,
      "content": "也会给那种黑人贫困学生奖学金",
      "music": 0.0
    },
    {
      "from": 132.11,
      "to": 134.11,
      "sid": 62,
      "location": 2,
      "content": "组织各种社区活动之类的",
      "music": 0.0
    },
    {
      "from": 134.11,
      "to": 136.63,
      "sid": 63,
      "location": 2,
      "content": "所以说本地人也比较爱护这么一个组织",
      "music": 0.0
    },
    {
      "from": 136.63,
      "to": 140.019,
      "sid": 64,
      "location": 2,
      "content": "我现在来到了5分钟车程之外的黑人天主教堂",
      "music": 0.0
    },
    {
      "from": 140.019,
      "to": 141.779,
      "sid": 65,
      "location": 2,
      "content": "这边和刚刚的有点像",
      "music": 0.0
    },
    {
      "from": 141.779,
      "to": 143.019,
      "sid": 66,
      "location": 2,
      "content": "除了教会的建筑",
      "music": 0.0
    },
    {
      "from": 143.019,
      "to": 144.299,
      "sid": 67,
      "location": 2,
      "content": "看起来维护的不错",
      "music": 0.0
    },
    {
      "from": 144.299,
      "to": 146.18,
      "sid": 68,
      "location": 2,
      "content": "周围都是破破烂烂的",
      "music": 0.0
    },
    {
      "from": 146.18,
      "to": 147.02,
      "sid": 69,
      "location": 2,
      "content": "在入口处",
      "music": 0.0
    },
    {
      "from": 147.02,
      "to": 148.52,
      "sid": 70,
      "location": 2,
      "content": "我一个老哥在那边要钱",
      "music": 0.0
    },
    {
      "from": 148.52,
      "to": 150.02,
      "sid": 71,
      "location": 2,
      "content": "我觉得老哥能选到这里",
      "music": 0.0
    },
    {
      "from": 150.02,
      "to": 151.64,
      "sid": 72,
      "location": 2,
      "content": "说明很有商业头脑啊",
      "music": 0.0
    },
    {
      "from": 151.64,
      "to": 154.06,
      "sid": 73,
      "location": 2,
      "content": "老哥也给我们讲了一下自己的人生",
      "music": 0.0
    },
    {
      "from": 154.06,
      "to": 155.72,
      "sid": 74,
      "location": 2,
      "content": "他今年75岁了",
      "music": 0.0
    },
    {
      "from": 155.72,
      "to": 157.26,
      "sid": 75,
      "location": 2,
      "content": "之前强制征兵的时候",
      "music": 0.0
    },
    {
      "from": 157.26,
      "to": 159.32,
      "sid": 76,
      "location": 2,
      "content": "把他和哥哥都送到越南去了",
      "music": 0.0
    },
    {
      "from": 159.32,
      "to": 160.9,
      "sid": 77,
      "location": 2,
      "content": "他的哥哥在越南战死了",
      "music": 0.0
    },
    {
      "from": 160.9,
      "to": 162.35,
      "sid": 78,
      "location": 2,
      "content": "但是他活着回来了",
      "music": 0.0
    },
    {
      "from": 162.35,
      "to": 164.01,
      "sid": 79,
      "location": 2,
      "content": "前两天他的癫痫症发作",
      "music": 0.0
    },
    {
      "from": 164.01,
      "to": 165.29,
      "sid": 80,
      "location": 2,
      "content": "直接倒在了路上",
      "music": 0.0
    },
    {
      "from": 165.29,
      "to": 167.329,
      "sid": 81,
      "location": 2,
      "content": "不过他最近交了一个女朋友",
      "music": 0.0
    },
    {
      "from": 167.329,
      "to": 170.209,
      "sid": 82,
      "location": 2,
      "content": "他的腰包就是女朋友去赌场用积分兑换",
      "music": 0.0
    },
    {
      "from": 170.209,
      "to": 171.069,
      "sid": 83,
      "location": 2,
      "content": "送给他的",
      "music": 0.0
    },
    {
      "from": 171.069,
      "to": 173.32,
      "sid": 84,
      "location": 2,
      "content": "有爱心的B友给了老哥五美元",
      "music": 0.0
    },
    {
      "from": 173.32,
      "to": 174.4,
      "sid": 85,
      "location": 2,
      "content": "老鹅跟我们说",
      "music": 0.0
    },
    {
      "from": 174.4,
      "to": 176.12,
      "sid": 86,
      "location": 2,
      "content": "下周他还会来这里等我们",
      "music": 0.0
    },
    {
      "from": 176.12,
      "to": 178.47,
      "sid": 87,
      "location": 2,
      "content": "其实黑人天主教堂非常的罕见",
      "music": 0.0
    },
    {
      "from": 178.47,
      "to": 181.43,
      "sid": 88,
      "location": 2,
      "content": "因为黑人群体中信天主教的只占6%",
      "music": 0.0
    },
    {
      "from": 181.43,
      "to": 184.13,
      "sid": 89,
      "location": 2,
      "content": "不过圣路易斯这边黑人人口基数够大",
      "music": 0.0
    },
    {
      "from": 184.13,
      "to": 185.64,
      "sid": 90,
      "location": 2,
      "content": "所以说问题不大",
      "music": 0.0
    },
    {
      "from": 185.64,
      "to": 188.38,
      "sid": 91,
      "location": 2,
      "content": "像是这些墙上挂的一些照片都是黑人的",
      "music": 0.0
    },
    {
      "from": 188.38,
      "to": 190.4,
      "sid": 92,
      "location": 2,
      "content": "不过我个人对宗教是一窍不通",
      "music": 0.0
    },
    {
      "from": 190.4,
      "to": 192.93,
      "sid": 93,
      "location": 2,
      "content": "所以我也不知道墙上挂的这些人是谁",
      "music": 0.0
    },
    {
      "from": 192.93,
      "to": 195.25,
      "sid": 94,
      "location": 2,
      "content": "不过这个教会的牧师却是一个白人",
      "music": 0.0
    },
    {
      "from": 195.25,
      "to": 196.17,
      "sid": 95,
      "location": 2,
      "content": "我去查了一下",
      "music": 0.0
    },
    {
      "from": 196.17,
      "to": 199.51,
      "sid": 96,
      "location": 2,
      "content": "他们这个细分领域的白人牧师确实占绝大多数",
      "music": 0.0
    },
    {
      "from": 199.51,
      "to": 202.57,
      "sid": 97,
      "location": 2,
      "content": "而且这边肉眼观测也有10%是白人吧",
      "music": 0.0
    },
    {
      "from": 202.57,
      "to": 203.95,
      "sid": 98,
      "location": 2,
      "content": "刚刚那个我可以肯定",
      "music": 0.0
    },
    {
      "from": 203.95,
      "to": 206.45,
      "sid": 99,
      "location": 2,
      "content": "除了我们两个亚洲人是100%黑人",
      "music": 0.0
    },
    {
      "from": 206.45,
      "to": 209.29,
      "sid": 100,
      "location": 2,
      "content": "不过天主教堂一般来说修的都是比较华丽啊",
      "music": 0.0
    },
    {
      "from": 209.29,
      "to": 211.64,
      "sid": 101,
      "location": 2,
      "content": "这也导致整体环境比较庄严",
      "music": 0.0
    },
    {
      "from": 211.64,
      "to": 212.6,
      "sid": 102,
      "location": 2,
      "content": "太压抑了",
      "music": 0.0
    },
    {
      "from": 212.6,
      "to": 213.22,
      "sid": 103,
      "location": 2,
      "content": "家人们",
      "music": 0.0
    },
    {
      "from": 213.22,
      "to": 215.56,
      "sid": 104,
      "location": 2,
      "content": "这导致各位兄弟姐妹们很难嗨起来",
      "music": 0.0
    },
    {
      "from": 215.56,
      "to": 216.58,
      "sid": 105,
      "location": 2,
      "content": "唱歌之类的",
      "music": 0.0
    },
    {
      "from": 216.58,
      "to": 219.86,
