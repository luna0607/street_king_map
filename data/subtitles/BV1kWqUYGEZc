  "type": "AIsubtitle",
  "lang": "zh",
  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.04,
      "to": 1.4,
      "sid": 1,
      "location": 2,
      "content": "今天我来到了科罗拉多州",
      "music": 0.0
    },
    {
      "from": 1.4,
      "to": 3.34,
      "sid": 2,
      "location": 2,
      "content": "和堪萨斯州交界的荒野上",
      "music": 0.0
    },
    {
      "from": 3.34,
      "to": 6.27,
      "sid": 3,
      "location": 2,
      "content": "这个蓝牌子上面写着欢迎再来到堪萨斯",
      "music": 0.0
    },
    {
      "from": 6.27,
      "to": 9.29,
      "sid": 4,
      "location": 2,
      "content": "然后前面就是欢迎来到科罗拉多州的牌子",
      "music": 0.0
    },
    {
      "from": 9.29,
      "to": 12.25,
      "sid": 5,
      "location": 2,
      "content": "人们提到科罗拉多都会想到它壮美的山峰",
      "music": 0.0
    },
    {
      "from": 12.25,
      "to": 14.25,
      "sid": 6,
      "location": 2,
      "content": "但是这个州的东部地区都是这样",
      "music": 0.0
    },
    {
      "from": 14.25,
      "to": 15.64,
      "sid": 7,
      "location": 2,
      "content": "人烟稀少的荒野",
      "music": 0.0
    },
    {
      "from": 15.64,
      "to": 18.61,
      "sid": 8,
      "location": 2,
      "content": "这条主要的公路都很少有来往的车辆",
      "music": 0.0
    },
    {
      "from": 18.61,
      "to": 21.85,
      "sid": 9,
      "location": 2,
      "content": "而这边半干旱的气候也不太利于植物的生长",
      "music": 0.0
    },
    {
      "from": 21.85,
      "to": 23.19,
      "sid": 10,
      "location": 2,
      "content": "如果是在我们中国",
      "music": 0.0
    },
    {
      "from": 23.19,
      "to": 25.85,
      "sid": 11,
      "location": 2,
      "content": "这里铁定是古代的苦寒流放之地",
      "music": 0.0
    },
    {
      "from": 25.85,
      "to": 27.89,
      "sid": 12,
      "location": 2,
      "content": "而在80多年前的二战期间",
      "music": 0.0
    },
    {
      "from": 27.89,
      "to": 28.93,
      "sid": 13,
      "location": 2,
      "content": "大约有1万名",
      "music": 0.0
    },
    {
      "from": 28.93,
      "to": 31.15,
      "sid": 14,
      "location": 2,
      "content": "原先住在太平洋沿岸的日裔美国人",
      "music": 0.0
    },
    {
      "from": 31.15,
      "to": 32.65,
      "sid": 15,
      "location": 2,
      "content": "由于被怀疑是间谍",
      "music": 0.0
    },
    {
      "from": 32.65,
      "to": 33.61,
      "sid": 16,
      "location": 2,
      "content": "都被流放到了",
      "music": 0.0
    },
    {
      "from": 33.61,
      "to": 35.95,
      "sid": 17,
      "location": 2,
      "content": "离州界线只有15分钟车程的小镇",
      "music": 0.0
    },
    {
      "from": 35.95,
      "to": 37.589,
      "sid": 18,
      "location": 2,
      "content": "格拉纳达路上",
      "music": 0.0
    },
    {
      "from": 37.589,
      "to": 39.869,
      "sid": 19,
      "location": 2,
      "content": "可以看到这片区域主要的经济模式",
      "music": 0.0
    },
    {
      "from": 39.869,
      "to": 40.909,
      "sid": 20,
      "location": 2,
      "content": "有的人养牛",
      "music": 0.0
    },
    {
      "from": 40.909,
      "to": 43.379,
      "sid": 21,
      "location": 2,
      "content": "也有人通过抽地下水灌溉种地",
      "music": 0.0
    },
    {
      "from": 43.379,
      "to": 45.539,
      "sid": 22,
      "location": 2,
      "content": "还有人就利用这边大片的空间",
      "music": 0.0
    },
    {
      "from": 45.539,
      "to": 47.119,
      "sid": 23,
      "location": 2,
      "content": "随便堆一堆各种东西",
      "music": 0.0
    },
    {
      "from": 47.119,
      "to": 49.659,
      "sid": 24,
      "location": 2,
      "content": "现在我进到了只有445个人的小镇",
      "music": 0.0
    },
    {
      "from": 49.659,
      "to": 50.73,
      "sid": 25,
      "location": 2,
      "content": "格拉纳达里",
      "music": 0.0
    },
    {
      "from": 50.73,
      "to": 52.17,
      "sid": 26,
      "location": 2,
      "content": "这种百人的农业小镇",
      "music": 0.0
    },
    {
      "from": 52.17,
      "to": 54.09,
      "sid": 27,
      "location": 2,
      "content": "一般来说都有一个标志性建筑",
      "music": 0.0
    },
    {
      "from": 54.09,
      "to": 56.37,
      "sid": 28,
      "location": 2,
      "content": "也就是镇上面最高的谷仓塔",
      "music": 0.0
    },
    {
      "from": 56.37,
      "to": 59.99,
      "sid": 29,
      "location": 2,
      "content": "一般来说它们都是在货运铁路线边方便运输",
      "music": 0.0
    },
    {
      "from": 59.99,
      "to": 62.39,
      "sid": 30,
      "location": 2,
      "content": "目前格拉拉达的人口是24%",
      "music": 0.0
    },
    {
      "from": 62.39,
      "to": 63.75,
      "sid": 31,
      "location": 2,
      "content": "白人73%",
      "music": 0.0
    },
    {
      "from": 63.75,
      "to": 66.37,
      "sid": 32,
      "location": 2,
      "content": "拉美人还有3%是混合种族",
      "music": 0.0
    },
    {
      "from": 66.37,
      "to": 69.49,
      "sid": 33,
      "location": 2,
      "content": "现在这个小镇里面一个亚洲人和黑人都没有",
      "music": 0.0
    },
    {
      "from": 69.49,
      "to": 70.69,
      "sid": 34,
      "location": 2,
      "content": "因此小镇主路上",
      "music": 0.0
    },
    {
      "from": 70.69,
      "to": 72.57,
      "sid": 35,
      "location": 2,
      "content": "这个博物馆上面印着的亚洲面孔",
      "music": 0.0
    },
    {
      "from": 72.57,
      "to": 74.03,
      "sid": 36,
      "location": 2,
      "content": "就显得格外的突兀",
      "music": 0.0
    },
    {
      "from": 74.03,
      "to": 76.31,
      "sid": 37,
      "location": 2,
      "content": "这个人其实是当年被派到欧洲去",
      "music": 0.0
    },
    {
      "from": 76.31,
      "to": 79.16,
      "sid": 38,
      "location": 2,
      "content": "和意大利人作战的日本籍美国大兵",
      "music": 0.0
    },
    {
      "from": 79.16,
      "to": 81.16,
      "sid": 39,
      "location": 2,
      "content": "而旁边的另外一扇窗上面印着",
      "music": 0.0
    },
    {
      "from": 81.16,
      "to": 83.04,
      "sid": 40,
      "location": 2,
      "content": "就是当年1万多日裔美国人",
      "music": 0.0
    },
    {
      "from": 83.04,
      "to": 86.59,
      "sid": 41,
      "location": 2,
      "content": "在格拉纳达小镇外的荒野里被囚禁的集中营",
      "music": 0.0
    },
    {
      "from": 86.59,
      "to": 89.73,
      "sid": 42,
      "location": 2,
      "content": "这个博物馆是本地人自己搞的非政府组织",
      "music": 0.0
    },
    {
      "from": 89.73,
      "to": 92.53,
      "sid": 43,
      "location": 2,
      "content": "毕竟这也算是当地很重要的一段历史",
      "music": 0.0
    },
    {
      "from": 92.53,
      "to": 94.37,
      "sid": 44,
      "location": 2,
      "content": "不过这边实在是太偏了",
      "music": 0.0
    },
    {
      "from": 94.37,
      "to": 96.14,
      "sid": 45,
      "location": 2,
      "content": "来参观的人其实很少",
      "music": 0.0
    },
    {
      "from": 96.14,
      "to": 98.74,
      "sid": 46,
      "location": 2,
      "content": "再加上本地一共也就只有几百个居民",
      "music": 0.0
    },
    {
      "from": 98.74,
      "to": 101.36,
      "sid": 47,
      "location": 2,
      "content": "因此他们这两天似乎没有开门的样子",
      "music": 0.0
    },
    {
      "from": 101.36,
      "to": 104.14,
      "sid": 48,
      "location": 2,
      "content": "不过看网上的照片里面其实面积也不大",
      "music": 0.0
    },
    {
      "from": 104.14,
      "to": 106.7,
      "sid": 49,
      "location": 2,
      "content": "不过好在除了本地人自发稿的组织",
      "music": 0.0
    },
    {
      "from": 106.7,
      "to": 108.78,
      "sid": 50,
      "location": 2,
      "content": "这边还有美国国家公园管理局",
      "music": 0.0
    },
    {
      "from": 108.78,
      "to": 110.67,
      "sid": 51,
      "location": 2,
      "content": "管辖下的国家历史遗址",
      "music": 0.0
    },
    {
      "from": 110.67,
      "to": 112.87,
      "sid": 52,
      "location": 2,
      "content": "其实我有一种上当受骗的感觉",
      "music": 0.0
    },
    {
      "from": 112.87,
      "to": 115.35,
      "sid": 53,
      "location": 2,
      "content": "这个遗址的核心就是这个小广场了",
      "music": 0.0
    },
    {
      "from": 115.35,
      "to": 117.11,
      "sid": 54,
      "location": 2,
      "content": "几个牌子静静地立在这里",
      "music": 0.0
    },
    {
      "from": 117.11,
      "to": 118.52,
      "sid": 55,
      "location": 2,
      "content": "叙述着当年的历史",
      "music": 0.0
    },
    {
      "from": 118.52,
      "to": 120.42,
      "sid": 56,
      "location": 2,
      "content": "这便是当年集中营的原址",
      "music": 0.0
    },
    {
      "from": 120.42,
      "to": 121.74,
      "sid": 57,
      "location": 2,
      "content": "二战结束了之后",
      "music": 0.0
    },
    {
      "from": 121.74,
      "to": 123.6,
      "sid": 58,
      "location": 2,
      "content": "这些日裔美国人就离开了这里",
      "music": 0.0
    },
    {
      "from": 123.6,
      "to": 126.23,
      "sid": 59,
      "location": 2,
      "content": "这些原先的房子也都被拆掉了",
      "music": 0.0
    },
    {
      "from": 126.43,
      "to": 127.91,
      "sid": 60,
      "location": 2,
      "content": "要不是这边有一个石头",
      "music": 0.0
    },
    {
      "from": 127.91,
      "to": 129.83,
      "sid": 61,
      "location": 2,
      "content": "显示里是美国国家历史遗址",
      "music": 0.0
    },
    {
      "from": 129.83,
      "to": 132.31,
      "sid": 62,
      "location": 2,
      "content": "我还以为自己来错了地方",
      "music": 0.0
    },
    {
      "from": 137.22,
      "to": 139.14,
      "sid": 63,
      "location": 2,
      "content": "这边的管理也是非常的随意",
      "music": 0.0
    },
    {
      "from": 139.14,
      "to": 140.08,
      "sid": 64,
      "location": 2,
      "content": "无人值守",
      "music": 0.0
    },
    {
      "from": 140.08,
      "to": 142.14,
      "sid": 65,
      "location": 2,
      "content": "有一个牌子提醒你这边不能打猎",
      "music": 0.0
    },
    {
      "from": 142.14,
      "to": 143.579,
      "sid": 66,
      "location": 2,
      "content": "或者说乱倒垃圾",
      "music": 0.0
    },
    {
      "from": 143.579,
      "to": 144.219,
      "sid": 67,
      "location": 2,
      "content": "这个牌子",
      "music": 0.0
    },
    {
      "from": 144.219,
      "to": 147.1,
      "sid": 68,
      "location": 2,
      "content": "也就是说公园的开放时间是日出到日落",
      "music": 0.0
    },
    {
      "from": 147.1,
      "to": 148.3,
      "sid": 69,
      "location": 2,
      "content": "你们想参观的话",
      "music": 0.0
    },
    {
      "from": 148.3,
      "to": 149.34,
      "sid": 70,
      "location": 2,
      "content": "自己看着办吧",
      "music": 0.0
    },
    {
      "from": 149.34,
      "to": 151.06,
      "sid": 71,
      "location": 2,
      "content": "在核心的小广场之外",
      "music": 0.0
    },
    {
      "from": 151.06,
      "to": 153.83,
      "sid": 72,
      "location": 2,
      "content": "这个公园里面还保留着当年营地的结构",
      "music": 0.0
    },
    {
      "from": 153.83,
      "to": 156.81,
      "sid": 73,
      "location": 2,
      "content": "我就是沿着他们原先中间的路随便开一开",
      "music": 0.0
    },
    {
      "from": 156.81,
      "to": 158.27,
      "sid": 74,
      "location": 2,
      "content": "虽然说这个国家遗址",
      "music": 0.0
    },
    {
      "from": 158.27,
      "to": 160.48,
      "sid": 75,
      "location": 2,
      "content": "是一个无人值守的荒野公园",
      "music": 0.0
    },
    {
      "from": 160.48,
      "to": 161.94,
      "sid": 76,
      "location": 2,
      "content": "按照法律上的定义",
      "music": 0.0
    },
    {
      "from": 161.94,
      "to": 164.72,
      "sid": 77,
      "location": 2,
      "content": "这边跟很多美国的知名景点是平级的",
      "music": 0.0
    },
    {
      "from": 164.72,
      "to": 166.14,
      "sid": 78,
      "location": 2,
      "content": "比如说华盛顿特区",
      "music": 0.0
    },
    {
      "from": 166.14,
      "to": 168.0,
      "sid": 79,
      "location": 2,
      "content": "林肯被刺杀的福特剧院",
      "music": 0.0
    },
    {
      "from": 168.0,
      "to": 171.0,
      "sid": 80,
      "location": 2,
      "content": "和连接白宫和国会大厦的宾夕法尼亚大道",
      "music": 0.0
    },
    {
      "from": 171.0,
      "to": 173.9,
      "sid": 81,
      "location": 2,
      "content": "如今这个遗址隔壁就是小镇的垃圾填埋场",
      "music": 0.0
    },
    {
      "from": 173.9,
      "to": 176.4,
      "sid": 82,
      "location": 2,
      "content": "我倒是感觉在这个填埋场门口的停牌",
      "music": 0.0
    },
    {
      "from": 176.4,
      "to": 178.04,
      "sid": 83,
      "location": 2,
      "content": "和格拉拉达小镇主路上",
      "music": 0.0
    },
    {
      "from": 178.04,
      "to": 180.5,
      "sid": 84,
      "location": 2,
      "content": "废弃建筑里面找到了不少战争的痕迹",
      "music": 0.0
    },
    {
      "from": 180.5,
      "to": 181.4,
      "sid": 85,
      "location": 2,
      "content": "众所周知",
      "music": 0.0
    },
    {
      "from": 181.4,
      "to": 182.84,
      "sid": 86,
      "location": 2,
      "content": "美国当年向日本宣战",
      "music": 0.0
    },
    {
      "from": 182.84,
      "to": 184.42,
      "sid": 87,
      "location": 2,
      "content": "就是因为珍珠港事件",
      "music": 0.0
    },
    {
      "from": 184.42,
      "to": 187.74,
      "sid": 88,
      "location": 2,
      "content": "当年美国太平洋舰队有八艘战列舰受到了重创",
      "music": 0.0
    },
    {
      "from": 187.74,
      "to": 189.03,
      "sid": 89,
      "location": 2,
      "content": "或者直接报废",
      "music": 0.0
    },
    {
      "from": 189.03,
      "to": 191.07,
      "sid": 90,
      "location": 2,
      "content": "唯一一艘逃过一劫的战列舰",
      "music": 0.0
    },
    {
      "from": 191.07,
      "to": 193.91,
      "sid": 91,
      "location": 2,
      "content": "就是以格纳纳达所在的科罗拉多州命名的",
      "music": 0.0
    },
    {
      "from": 193.91,
      "to": 195.399,
      "sid": 92,
      "location": 2,
      "content": "科罗拉多号战列舰",
      "music": 0.0
    },
    {
      "from": 195.399,
      "to": 197.399,
      "sid": 93,
      "location": 2,
      "content": "当时他正好在西雅图附近的",
      "music": 0.0
    },
    {
      "from": 197.399,
      "to": 199.359,
      "sid": 94,
      "location": 2,
      "content": "普吉特造船厂里面进行改造",
      "music": 0.0
    },
    {
      "from": 199.359,
      "to": 200.839,
      "sid": 95,
      "location": 2,
      "content": "并不停在珍珠港内",
      "music": 0.0
    },
    {
      "from": 200.839,
      "to": 202.95,
      "sid": 96,
      "location": 2,
      "content": "在加装了更多的防空炮之后",
      "music": 0.0
    },
    {
      "from": 202.95,
      "to": 206.09,
      "sid": 97,
      "location": 2,
      "content": "科罗拉多号先是在旧金山的金门大桥附近巡逻",
      "music": 0.0
    },
    {
      "from": 206.09,
      "to": 209.01,
      "sid": 98,
      "location": 2,
      "content": "以防止美国本土直接遭到空中打击",
      "music": 0.0
    },
    {
      "from": 209.01,
      "to": 210.43,
      "sid": 99,
      "location": 2,
      "content": "随后的1942年",
      "music": 0.0
    },
    {
      "from": 210.43,
      "to": 212.79,
      "sid": 100,
      "location": 2,
      "content": "科罗拉多号返回太平洋前线作战",
      "music": 0.0
    },
    {
      "from": 212.79,
      "to": 214.45,
      "sid": 101,
      "location": 2,
      "content": "在战后的1947年",
      "music": 0.0
    },
    {
      "from": 214.45,
      "to": 215.77,
      "sid": 102,
      "location": 2,
      "content": "美国海军就退役了",
      "music": 0.0
    },
    {
      "from": 215.77,
      "to": 216.73,
      "sid": 103,
      "location": 2,
      "content": "科罗拉多号",
      "music": 0.0
    },
    {
      "from": 216.73,
      "to": 217.77,
      "sid": 104,
      "location": 2,
      "content": "在1959年",
      "music": 0.0
    },
    {
      "from": 217.77,
      "to": 219.61,
