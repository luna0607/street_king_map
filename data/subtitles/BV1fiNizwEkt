  "version": "v1.7.0.4",
  "body": [
    {
      "from": 0.0,
      "to": 0.92,
      "sid": 1,
      "location": 2,
      "content": "The tone has shifted to the United States.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 0.92,
      "to": 2.64,
      "sid": 2,
      "location": 2,
      "content": "The city with the highest percentage of Mexican Americans.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 2.64,
      "to": 5.24,
      "sid": 3,
      "location": 2,
      "content": "A city of 250,000 residents, 95% of whom are Latino.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 5.24,
      "to": 6.52,
      "sid": 4,
      "location": 2,
      "content": "The small Texas town of Laredo.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 6.52,
      "to": 8.16,
      "sid": 5,
      "location": 2,
      "content": "Across the river lies Mexico.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 11.55,
      "to": 13.35,
      "sid": 6,
      "location": 2,
      "content": "I previously visited an African American gang neighborhood in the U.S.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 13.35,
      "to": 15.11,
      "sid": 7,
      "location": 2,
      "content": "Compared to the crime syndicates in Mexico,",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 15.11,
      "to": 16.58,
      "sid": 8,
      "location": 2,
      "content": "it's just petty stuff.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 16.58,
      "to": 18.32,
      "sid": 9,
      "location": 2,
      "content": "Mexican gangs are known for their brutal methods.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 18.32,
      "to": 21.1,
      "sid": 10,
      "location": 2,
      "content": "The armed forces of 20 are so powerful that they can directly challenge the authorities.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 21.1,
      "to": 23.0,
      "sid": 11,
      "location": 2,
      "content": "They resemble a warlord group controlling a region.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 23.0,
      "to": 25.14,
      "sid": 12,
      "location": 2,
      "content": "This border town, now a major smuggling hub,",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 25.14,
      "to": 27.64,
      "sid": 13,
      "location": 2,
      "content": "is still fully controlled by the Northeast Group in Mexico.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 27.64,
      "to": 28.24,
      "sid": 14,
      "location": 2,
      "content": "In February this year,",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 28.24,
      "to": 30.52,
      "sid": 15,
      "location": 2,
      "content": "Mexican police attempted to apprehend the number two leader of this gang,",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 30.52,
      "to": 32.16,
      "sid": 16,
      "location": 2,
      "content": "which directly sparked citywide street battles.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 32.16,
      "to": 32.96,
      "sid": 17,
      "location": 2,
      "content": "Flights at the airport were suspended,",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 32.96,
      "to": 33.64,
      "sid": 18,
      "location": 2,
      "content": "with all flights grounded.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 33.64,
      "to": 35.36,
      "sid": 19,
      "location": 2,
      "content": "The local U.S. consulates and embassies are closed",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 35.36,
      "to": 36.68,
      "sid": 20,
      "location": 2,
      "content": "And by mid-2025,",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 36.68,
      "to": 37.8,
      "sid": 21,
      "location": 2,
      "content": "one of the few shared opinions in the U.S.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 37.8,
      "to": 40.0,
      "sid": 22,
      "location": 2,
      "content": "is to advise citizens against traveling to Nuevo Laredo,",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 40.0,
      "to": 42.16,
      "sid": 23,
      "location": 2,
      "content": "and its home state of Tamaulipas.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 42.16,
      "to": 44.28,
      "sid": 24,
      "location": 2,
      "content": "I'm now preparing to depart from the U.S. side of the border,",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 44.28,
      "to": 45.56,
      "sid": 25,
      "location": 2,
      "content": "from a street known for cross-border trade,",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 45.56,
      "to": 46.28,
      "sid": 26,
      "location": 2,
      "content": "heading to the other side of the river,",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 46.28,
      "to": 49.3,
      "sid": 27,
      "location": 2,
      "content": "to the town of Nuevo Laredo, controlled by Mexican criminal groups.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 49.3,
      "to": 52.629,
      "sid": 28,
      "location": 2,
      "content": "The first step is to teach you how to legally cross from the U.S. to Mexico.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 52.629,
      "to": 54.109,
      "sid": 29,
      "location": 2,
      "content": "Of course, you can choose to drive.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 54.109,
      "to": 56.349,
      "sid": 30,
      "location": 2,
      "content": "But in Laredo, most people, like me, use the pedestrian bridge.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 56.349,
      "to": 57.289,
      "sid": 31,
      "location": 2,
      "content": "Walk across to Mexico, exchange your dollars after passing through that toll gate.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 57.289,
      "to": 60.12,
      "sid": 32,
      "location": 2,
      "content": "That's when you're close to the U.S. and have entered the international bridge area.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 60.12,
      "to": 62.78,
      "sid": 33,
      "location": 2,
      "content": "If you want to go back, you'll need to queue up at the other end of the bridge to clear customs.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 62.78,
      "to": 66.08,
      "sid": 34,
      "location": 2,
      "content": "Right in the middle of this bridge is the boundary marker between the U.S. and Mexico.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 66.08,
      "to": 69.45,
      "sid": 35,
      "location": 2,
      "content": "Since the border between Texas and Mexico is natural,",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 69.45,
      "to": 72.05,
      "sid": 36,
      "location": 2,
      "content": "The border between Texas and Mexico is natural.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 72.05,
      "to": 72.77,
      "sid": 37,
      "location": 2,
      "content": "The Rio Grande",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 72.77,
      "to": 74.35,
      "sid": 38,
      "location": 2,
      "content": "There's no border wall here",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 74.35,
      "to": 77.33,
      "sid": 39,
      "location": 2,
      "content": "An outlet mall has even opened on the U.S. side of the border",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 77.33,
      "to": 79.95,
      "sid": 40,
      "location": 2,
      "content": "The border jurisdiction around the small town of Laredo is like this",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 79.95,
      "to": 82.11,
      "sid": 41,
      "location": 2,
      "content": "This is another cross-border railway bridge over the river",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 82.11,
      "to": 84.86,
      "sid": 42,
      "location": 2,
      "content": "If it weren't for a few vehicles from the U.S. Border Patrol parked by the shore",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 84.86,
      "to": 87.18,
      "sid": 43,
      "location": 2,
      "content": "The Rio Grande, which serves as the U.S.-Mexico border, looks like an ordinary river",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 87.18,
      "to": 88.42,
      "sid": 44,
      "location": 2,
      "content": "There's not much difference",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 88.42,
      "to": 90.58,
      "sid": 45,
      "location": 2,
      "content": "In the wider border area outside Laredo",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 90.58,
      "to": 91.98,
      "sid": 46,
      "location": 2,
      "content": "It's a small grove like this.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 91.98,
      "to": 94.83,
      "sid": 47,
      "location": 2,
      "content": "You can swim from the U.S. to Mexico down this slope.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 94.83,
      "to": 95.99,
      "sid": 48,
      "location": 2,
      "content": "Back on the border bridge.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 95.99,
      "to": 98.01,
      "sid": 49,
      "location": 2,
      "content": "Now I've entered Mexican territory.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 98.01,
      "to": 99.89,
      "sid": 50,
      "location": 2,
      "content": "The building up ahead is the Mexican customs office.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 99.89,
      "to": 102.64,
      "sid": 51,
      "location": 2,
      "content": "Pedestrians aren't checked at all when entering Mexico from the U.S.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 102.64,
      "to": 103.44,
      "sid": 52,
      "location": 2,
      "content": "No exaggeration,",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 103.44,
      "to": 105.26,
      "sid": 53,
      "location": 2,
      "content": "it's even easier to enter than going into a supermarket.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 105.26,
      "to": 106.92,
      "sid": 54,
      "location": 2,
      "content": "Even if I begged the Mexican border control.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 106.92,
      "to": 109.16,
      "sid": 55,
      "location": 2,
      "content": "Stamp my passport as a souvenir of doing business",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 109.16,
      "to": 110.34,
      "sid": 56,
      "location": 2,
      "content": "None of them would do it",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 110.34,
      "to": 113.24,
      "sid": 57,
      "location": 2,
      "content": "The small plaza at the customs should be the safest place in Nuevo Laredo",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 113.24,
      "to": 115.78,
      "sid": 58,
      "location": 2,
      "content": "This small area is mostly dental clinics serving American tourists",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 115.78,
      "to": 116.7,
      "sid": 59,
      "location": 2,
      "content": "pharmacies and such",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 116.7,
      "to": 118.12,
      "sid": 60,
      "location": 2,
      "content": "After all, healthcare in the U.S. is too expensive",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 118.12,
      "to": 119.94,
      "sid": 61,
      "location": 2,
      "content": "Guo Jing’s shopping trip offers great value for money",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 119.94,
      "to": 122.98,
      "sid": 62,
      "location": 2,
      "content": "Most towns along the U.S.-Mexico border have a safe tourist area",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 122.98,
      "to": 125.76,
      "sid": 63,
      "location": 2,
      "content": "The size of these areas depends on the population of the American city across the border",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 125.76,
      "to": 127.94,
      "sid": 64,
      "location": 2,
      "content": "Laredo, across from Nuevo Laredo, has a population of 250,000.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 127.94,
      "to": 129.26,
      "sid": 65,
      "location": 2,
      "content": "And the surrounding areas are mostly uninhabited.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 129.26,
      "to": 131.339,
      "sid": 66,
      "location": 2,
      "content": "The desert area has been set up as a tourist zone for American visitors.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 131.339,
      "to": 132.499,
      "sid": 67,
      "location": 2,
      "content": "There’s just this small square.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 132.499,
      "to": 133.579,
      "sid": 68,
      "location": 2,
      "content": "Apart from this small area,",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 133.579,
      "to": 134.879,
      "sid": 69,
      "location": 2,
      "content": "the rest is the local residents' living quarters.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 134.879,
      "to": 136.839,
      "sid": 70,
      "location": 2,
      "content": "Most of the street vendors don’t speak much English.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 136.839,
      "to": 138.88,
      "sid": 71,
      "location": 2,
      "content": "Fortunately, my broken Spanish is just about usable.",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 138.88,
      "to": 139.96,
      "sid": 72,
      "location": 2,
      "content": "This little Mexican snake",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 139.96,
      "to": 141.32,
      "sid": 73,
      "location": 2,
      "content": "Although the cityscape is a bit aged",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 141.32,
      "to": 142.04,
      "sid": 74,
      "location": 2,
      "content": "in terms of data",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 142.04,
      "to": 144.64,
      "sid": 75,
      "location": 2,
      "content": "the average annual salary in Nuevo Laredo is $16,000",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 144.64,
      "to": 145.72,
      "sid": 76,
      "location": 2,
      "content": "which is also 110,000 RMB",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 145.72,
      "to": 148.3,
      "sid": 77,
      "location": 2,
      "content": "of course, I can't vouch for the extent of data inflation in Mexico",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 148.3,
      "to": 151.04,
      "sid": 78,
      "location": 2,
      "content": "while the annual income across the river in Laredo is $40,000",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 151.04,
      "to": 153.56,
      "sid": 79,
      "location": 2,
      "content": "many locals from Nuevo Laredo work in the United States",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 153.56,
      "to": 154.44,
      "sid": 80,
      "location": 2,
      "content": "earning dollars during the day",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 154.44,
      "to": 155.68,
      "sid": 81,
      "location": 2,
      "content": "and spending them in Mexico after work",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 155.68,
      "to": 156.84,
      "sid": 82,
      "location": 2,
      "content": "I saved a lot of money",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 156.84,
      "to": 158.28,
      "sid": 83,
      "location": 2,
      "content": "When it comes to saving money, you can't beat Zhuanzhuan",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 158.28,
      "to": 160.22,
      "sid": 84,
      "location": 2,
      "content": "This is the perfect time to buy a phone from them",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 160.22,
      "to": 162.62,
      "sid": 85,
      "location": 2,
      "content": "This 95% new iPhone 14 Pro costs only 3000",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 162.62,
      "to": 163.48,
      "sid": 86,
      "location": 2,
      "content": "728 yuan",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 163.48,
      "to": 164.72,
      "sid": 87,
      "location": 2,
      "content": "That's just 40% of the price of a new one",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 164.72,
      "to": 165.76,
      "sid": 88,
      "location": 2,
      "content": "The value for money is outstanding",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
    },
    {
      "from": 165.76,
      "to": 167.16,
      "sid": 89,
      "location": 2,
      "content": "And Zhuanzhuan offers more than just phones",
      "music": 0.0,
      "version": "qwen72_v0.0.4"
